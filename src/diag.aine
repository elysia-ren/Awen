// awen-proto/src/diag.aine —— 诊断(核心规范 §6.10 的引导性提示在此定义)

enum Severity {
    SevError
    SevWarning
}

struct Diagnostic {
    severity: Severity
    message: String
    hint: Option<String>
    line: i32
}

fn diag_error(message: String, line: i32) -> Diagnostic {
    return Diagnostic { severity: SevError, message: message, hint: None, line: line }
}

fn diag_warning(message: String, line: i32) -> Diagnostic {
    return Diagnostic { severity: SevWarning, message: message, hint: None, line: line }
}

fn diag_hint(d: Diagnostic, hint: String) -> Diagnostic {
    return Diagnostic { severity: d.severity, message: d.message, hint: Some(hint), line: d.line }
}

fn count_errors(diags: Vec<Diagnostic>) -> i32 {
    var n = 0
    for d in diags {
        if d.severity == SevError { n += 1 }
    }
    return n
}



// ── 共享类型(避免跨模块类型解析问题)────────────────────────

struct Theme {
    name: String
    rules: Vec<StyleRule>
}

struct StyleRule {
    role: String
    level: i32
    prop: String
    value: String
}

struct RenderItem {
    node_id: i32
    kind: String
    text: String
    font_size: String
    font_name: String
    color: String
    indent: String
    line_spacing: String
    weight: String
}
