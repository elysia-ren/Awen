// JSON 字符串转义(响应行构造用)
fn json_escape_str(s: String) -> String {
    var out = "\""
    var i: i32 = 0
    while i < s.len() {
        let c = s[i]
        if c == "\"" {
            out = out + "\\\""
        } else if c == "\\" {
            out = out + "\\\\"
        } else if c == "\n" {
            out = out + "\\n"
        } else if c == "\r" {
            out = out + "\\r"
        } else if c == "\t" {
            out = out + "\\t"
        } else {
            out = out + c
        }
        i += 1
    }
    return out + "\""
}

// ── 常驻 Core 模式(daemon):stdin 每行一个请求 JSON,stdout 每行一个响应 ──
// 消灭每次解析的进程启动成本;进程由壳层拉起并看护,崩溃自动重启。
// 请求:{"id":N,"op":"parse|pack|unpack",...};响应:{"id":N,"ok":true,"result":"..."}
fn daemon_loop() {
    // 增量排版状态(daemon 常驻,跨请求保留):上一轮 fast 流 + cfg 五参数 + 宽表快照
    var g_prev_flow: Vec<PageFlowResult> = []
    var g_prev_cfgn: Vec<f64> = []
    var g_prev_wfs = ""
    while true {
        let line = read_line()
        if line == "" { break }
        let m = json_decode(line)
        let id = match m.get("id") { Some(x) { x } None { 0 } }
        let op = match m.get("op") { Some(x) { x } None { "" } }
        var result = ""
        if op == "parse" {
            let src = match m.get("src") { Some(x) { x } None { "" } }
            var json = ""
            if src == "" {
                json = "{\"blocks\":[],\"diags\":[],\"outline\":[],\"pages\":0,\"recs\":[]}"
            } else {
                let o2 = lex(src)
                let pr = parse(o2)
                let st = build_document(pr, src)
                json = blocks_to_json(st, src)
                // A′ 引擎全权排版:cfg 在场时同一次解析顺带权威分页(零额外往返)
                let cfgv = m.get("cfg")
                match cfgv {
                    Some(c) {
                        let pw = (match c.get("pw") { Some(x) { x } None { 210 } }) + 0.0
                        let ph = (match c.get("ph") { Some(x) { x } None { 297 } }) + 0.0
                        let mg = (match c.get("mg") { Some(x) { x } None { 20 } }) + 0.0
                        let fp = (match c.get("fp") { Some(x) { x } None { 11 } }) + 0.0
                        let ls = (match c.get("ls") { Some(x) { x } None { 1.65 } }) + 0.0
                        var wf_s = ""
                        var wf_e = ""
                        var wf_ws: Vec<f64> = []
                        let wobj = c.get("widths")
                        match wobj {
                            Some(wv) {
                                wf_s = match wv.get("s") { Some(x) { x } None { "" } }
                                wf_e = match wv.get("e") { Some(x) { x } None { "" } }
                                let warr = match wv.get("w") { Some(x) { x } None { [] } }
                                var wi = 0
                                while wi < warr.len() {
                                    wf_ws = wf_ws.push((warr.get(wi)) + 0.0)
                                    wi += 1
                                }
                            }
                            None { }
                        }
                        let ctx = page_flow_ctx_cfg_w(pw, ph, mg, fp, ls, wf_s, wf_e, wf_ws)
                        let flow = page_flow_with(st, ctx)
                        let lay = layout_recs_json(st, src, flow)
                        // 拼接:剥掉 blocks_to_json 收尾 '}',接上 pages/recs
                        json = json[0..(json.len() - 1)] + "," + lay[1..lay.len()]
                        // 留存本轮流供增量排版复用
                        g_prev_cfgn = [pw, ph, mg, fp, ls]
                        g_prev_wfs = wf_s
                        if g_prev_flow.len() == 0 {
                            g_prev_flow = g_prev_flow.push(flow)
                        } else {
                            g_prev_flow[0] = flow
                        }
                    }
                    None { }
                }
            }
            result = json
        } else if op == "relayout" {
            // 增量排版:全量重解析后,排版复用上一轮未变前缀(签名比较),
            // 只重排首变之后的尾段——返回与 op=parse 同构的 pages/recs
            let src = match m.get("src") { Some(x) { x } None { "" } }
            let cfgv = match m.get("cfg") { Some(x) { x } None { 0 } }
            if src == "" {
                result = "{\"pages\":0,\"recs\":[]}"
            } else {
                let o2 = lex(src)
                let pr = parse(o2)
                let st = build_document(pr, src)
                let pw = (match cfgv.get("pw") { Some(x) { x } None { 210 } }) + 0.0
                let ph = (match cfgv.get("ph") { Some(x) { x } None { 297 } }) + 0.0
                let mg = (match cfgv.get("mg") { Some(x) { x } None { 20 } }) + 0.0
                let fp = (match cfgv.get("fp") { Some(x) { x } None { 11 } }) + 0.0
                let ls = (match cfgv.get("ls") { Some(x) { x } None { 1.65 } }) + 0.0
                var wf_s = ""
                var wf_e = ""
                var wf_ws: Vec<f64> = []
                let wobj = cfgv.get("widths")
                match wobj {
                    Some(wv) {
                        wf_s = match wv.get("s") { Some(x) { x } None { "" } }
                        wf_e = match wv.get("e") { Some(x) { x } None { "" } }
                        let warr = match wv.get("w") { Some(x) { x } None { [] } }
                        var wi = 0
                        while wi < warr.len() {
                            wf_ws = wf_ws.push((warr.get(wi)) + 0.0)
                            wi += 1
                        }
                    }
                    None { }
                }
                let ctx = page_flow_ctx_cfg_w(pw, ph, mg, fp, ls, wf_s, wf_e, wf_ws)
                // cfg 五参数+宽表与上一轮一致才走增量;否则全量
                var same_cfg = g_prev_cfgn.len() == 5 && wf_s == g_prev_wfs
                if same_cfg {
                    same_cfg = pw == g_prev_cfgn.get(0) && ph == g_prev_cfgn.get(1) && mg == g_prev_cfgn.get(2) && fp == g_prev_cfgn.get(3) && ls == g_prev_cfgn.get(4)
                }
                var flow = page_flow_with(st, ctx)
                if same_cfg && g_prev_flow.len() > 0 {
                    flow = page_flow_incremental_fast(st, g_prev_flow[0], ctx)
                }
                g_prev_cfgn = [pw, ph, mg, fp, ls]
                g_prev_wfs = wf_s
                if g_prev_flow.len() == 0 {
                    g_prev_flow = g_prev_flow.push(flow)
                } else {
                    g_prev_flow[0] = flow
                }
                result = layout_recs_json(st, src, flow)
            }
        } else if op == "parse_blocks" {
            // 块级增量解析:只解析前端送来的脏段,每段独立走完整权威管线。
            // 段内无空行 → 段⇄节点 1:1,独立解析与全文解析结果一致;
            // 每段响应 {"bid","res":{blocks,diags,outline}},res 复用 blocks_to_json。
            let arr = match m.get("blocks") { Some(x) { x } None { [] } }
            var out = "{\"nodes\":["
            var fi = true
            var i: i32 = 0
            while i < arr.len() {
                let item = arr.get(i)
                let bid = match item.get("bid") { Some(x) { x } None { "" } }
                let text = match item.get("text") { Some(x) { x } None { "" } }
                var res = ""
                if text == "" {
                    res = "{\"blocks\":[],\"diags\":[],\"outline\":[]}"
                } else {
                    res = segment_blocks_json(text)
                }
                if !fi { out = out + "," }
                fi = false
                out = out + "{\"bid\":" + json_escape_str(bid) + ",\"res\":" + res + "}"
                i += 1
            }
            result = out + "]}"
        } else if op == "pack" {
            let src = match m.get("src") { Some(x) { x } None { "" } }
            let target = match m.get("target") { Some(x) { x } None { "" } }
            let doc_id = match m.get("doc_id") { Some(x) { x } None { "" } }
            let mdir = match m.get("media_dir") { Some(x) { x } None { "" } }
            result = pack_awen(src, target, doc_id, mdir)
        } else if op == "unpack" {
            let path = match m.get("path") { Some(x) { x } None { "" } }
            let mdir = match m.get("media_dir") { Some(x) { x } None { "" } }
            let sout = match m.get("source_out") { Some(x) { x } None { "" } }
            result = unpack_awen(path, mdir, sout)
        }
        print("{\"id\":" + f"{id}" + ",\"ok\":true,\"result\":" + json_escape_str(result) + "}")
    }
}

fn main() {
    // daemon 常驻模式:aine.exe run src/tauri_cli.aine daemon
    if cli_args.len() > 0 {
        let mode = cli_args.get(0)
        if mode == "daemon" {
            daemon_loop()
            return
        }
    }
    // 容器模式(参数经全局 args 传入,见 aine run [args]):
    //   pack   <src_file> <target_awen> <doc_id> <media_base>  抽 data URI 资源化并打容器,
    //                                              资源化源码回写 build/cli_container_src.awen
    //   unpack <awen_file> <media_dir> <source_out> 解包:资源落盘,源码写 source_out
    // 无参数时走默认解析管线(源码在 build/cli_in.awen)
    if cli_args.len() > 0 {
        let mode = cli_args.get(0)
        if mode == "pack" {
            var src = read_file(cli_args.get(1))
            if src.contains("[read_file error") { src = "" }
            let packed = pack_awen(src, cli_args.get(2), cli_args.get(3), cli_args.get(4))
            write_file("build/cli_container_src.awen", packed)
            write_file("build/cli_out.json", "{\"ok\":true}")
            return
        }
        if mode == "unpack" {
            let st = unpack_awen(cli_args.get(1), cli_args.get(2), cli_args.get(3))
            write_file("build/cli_out.json", st)
            return
        }
    }
    var src = read_file("build/cli_in.awen")
    if src.contains("[read_file error") { src = "" }
    var json = ""
    if src == "" {
        json = "{\"blocks\":[],\"diags\":[],\"outline\":[]}"
    } else {
        let out = lex(src)
        let pr = parse(out)
        let state = build_document(pr, src)
        json = blocks_to_json(state, src)
    }
    write_file("build/cli_out.json", json)
}
