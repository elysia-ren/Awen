@global var g_blocks_json: String = ""
@global var g_lay_json: String = ""

// 逗号分隔 double 串 → Vec<f64>(空串 → 空表)
fn split_f64_csv(s: String) -> Vec<f64> {
    var out: Vec<f64> = []
    if s.len() == 0 { return out }
    let parts = s.split(",")
    var i = 0
    while i < parts.len() {
        // 先落 let 再 push(直接 push 函数返回值会在 C 侧对右值取址)
        let d: f64 = parts.get(i).to_f64()
        out = out.push(d)
        i += 1
    }
    return out
}

// 完整权威管线:parse + build + flow + recs,返回与 daemon op=parse 同构 JSON
fn awen_run(src: String, pw: f64, ph: f64, mg: f64, fp: f64, ls: f64, wf_s: String, wf_e: String, wf_w_flat: String) -> String {
    let wf_w = split_f64_csv(wf_w_flat)
    let out = lex(src)
    let pr = parse(out)
    let st = build_document(pr, src)
    let ctx = page_flow_ctx_cfg_w(pw, ph, mg, fp, ls, wf_s, wf_e, wf_w)
    let flow = page_flow_with(st, ctx)
    let blocks = blocks_to_json(st, src)
    let lay = layout_recs_json(st, src, flow)
    // 去掉 blocks 收尾 '}' 与 lay 开头 '{',C 桥用 ',' 拼成单对象
    g_blocks_json = blocks[0 .. blocks.len() - 1]
    g_lay_json = lay[1 .. lay.len()]
    return "ok"
}

fn main() {
    let src = read_file("build/bench_src.awen")
    if src.contains("[read_file error") {
        print("no src")
        return
    }
    let r = awen_run(src, 210.0, 297.0, 20.0, 11.0, 1.65, "", "", "")
    print(f"len={r.len()}")
}
