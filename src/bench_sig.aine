fn main() {
    let src = read_file("build/bench_src.awen")
    if src.contains("[read_file error") {
        print("no src")
        return
    }
    let t0 = now_ms()
    let full = lex(src)
    let t1 = now_ms()
    let pr = parse(full)
    let st = build_document(pr, src)
    let t2 = now_ms()
    // 编辑:中部改一行
    let lines = src.split("\n")
    var edited: Vec<String> = []
    var i: i32 = 0
    while i < lines.len() {
        if i == 613 {
            edited = edited.push(lines.get(i) + "【改】")
        } else {
            edited = edited.push(lines.get(i))
        }
        i += 1
    }
    var esrc = ""
    i = 0
    while i < edited.len() {
        if i > 0 { esrc = esrc + "\n" }
        esrc = esrc + edited.get(i)
        i += 1
    }
    let t3 = now_ms()
    let inc = incremental_lex(full, src, esrc)
    let t4 = now_ms()
    let st2 = build_document(parse(inc.out), esrc)
    let t5 = now_ms()
    // 签名重建(增量 fast 排版的固定开销)
    var sigs: Vec<String> = []
    var k = 0
    while k < st2.nodes.len() {
        sigs = sigs.push(page_node_sig(st2.nodes.get(k)))
        k += 1
    }
    let t6 = now_ms()
    print(f"full_lex={t1 - t0}ms full_parse_build={t2 - t1}ms")
    print(f"incr_lex={t4 - t3}ms fallback={inc.fallback} reused={inc.reused_blocks} relexed={inc.relexed_lines}")
    print(f"incr_parse_build={t5 - t4}ms")
    print(f"sig_rebuild_all={t6 - t5}ms nodes={st2.nodes.len()}")
}
