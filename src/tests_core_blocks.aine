// 测试模块:tests_core_blocks(权威块级 JSON;行区间约定对齐 preview/engine.js)

@test
fn core_blocks_basic_structure() -> Result<i32, String> {
    let src = "# 标题一\n\n第一段 **粗体**。\n\n- 项一\n- 项二\n\n尾段。\n"
    let state = build_document(parse(lex(src)), src)
    let json = blocks_to_json(state, src)
    assert(json.contains("\"blocks\":["), "应有 blocks")
    assert(json.contains("\"kind\":\"heading\""), "应有 heading")
    assert(json.contains("\"kind\":\"para\""), "应有 para")
    // 列表组展开为逐项 ul
    assert(json.contains("\"kind\":\"ul\""), "应有 ul")
    assert(json.contains("\"text\":\"- 项一\""), "ul 记录保留原文含前缀")
    assert(json.contains("\"diags\":"), "应有 diags")
    assert(json.contains("\"outline\":"), "应有 outline")
    Ok(0)
}

@test
fn core_blocks_span_convention() -> Result<i32, String> {
    // 引擎约定:srcStart 0 基;srcEnd 半开 [start,end)
    let src = "# 标题\n\n段一\n\n段二\n"
    let state = build_document(parse(lex(src)), src)
    let json = blocks_to_json(state, src)
    // 标题在行 0,srcEnd=1
    assert(json.contains("\"srcStart\":0,\"srcEnd\":1"), "标题区间应为 [0,1)")
    // 段一在行 2,空行在区间外
    assert(json.contains("\"srcStart\":2,\"srcEnd\":3"), "段一区间应为 [2,3)")
    // 段二在行 4
    assert(json.contains("\"srcStart\":4,\"srcEnd\":5"), "段二区间应为 [4,5)")
    Ok(0)
}

@test
fn core_blocks_list_item_spans() -> Result<i32, String> {
    let src = "# T\n\n- 甲\n- 乙\n"
    let state = build_document(parse(lex(src)), src)
    let json = blocks_to_json(state, src)
    assert(json.contains("\"kind\":\"ul\",\"level\":0,\"srcStart\":2,\"srcEnd\":3"), "项一区间 [2,3)")
    assert(json.contains("\"kind\":\"ul\",\"level\":0,\"srcStart\":3,\"srcEnd\":4"), "项二区间 [3,4)")
    Ok(0)
}

@test
fn core_blocks_table_span_includes_delims() -> Result<i32, String> {
    let src = "@[table t]\n| a | b |\n| --- | --- |\n| 1 | 2 |\n@[/table]\n"
    let state = build_document(parse(lex(src)), src)
    let json = blocks_to_json(state, src)
    assert(json.contains("\"kind\":\"table\""), "应有 table 记录")
    // 区间含 @[table] 与 @[/table] 定界行:[0,5)
    assert(json.contains("\"srcStart\":0,\"srcEnd\":5"), "表格区间应含定界行 [0,5)")
    assert(json.contains("@[/table]"), "text 应含收尾定界行")
    Ok(0)
}

@test
fn core_blocks_raw_code_and_math() -> Result<i32, String> {
    let src = "@[c py]\nprint(1)\n@[/c]\n\n@[m]\nE=mc^2\n@[/m]\n"
    let state = build_document(parse(lex(src)), src)
    let json = blocks_to_json(state, src)
    assert(json.contains("\"kind\":\"code\""), "应有 code 记录")
    assert(json.contains("\"lang\":\"py\""), "code 应带 lang")
    assert(json.contains("\"kind\":\"math\""), "无 lang 且 @[m] 开头应为 math")
    Ok(0)
}

@test
fn core_blocks_diags_line_one_based() -> Result<i32, String> {
    // 未闭合表格 → 错误诊断,行号为 1 基
    let src = "@[table t]\n| a |\n"
    let state = build_document(parse(lex(src)), src)
    let json = blocks_to_json(state, src)
    assert(json.contains("\"sev\":\"err\""), "未闭合表格应为 err")
    Ok(0)
}

@test
fn core_blocks_outline_marked_text() -> Result<i32, String> {
    let src = "# 章 **粗**\n\n正文。\n"
    let state = build_document(parse(lex(src)), src)
    let json = blocks_to_json(state, src)
    assert(json.contains("\"text\":\"章 **粗**\""), "大纲文本应保留标记")
    Ok(0)
}

@test
fn core_blocks_nested_list_levels() -> Result<i32, String> {
    // 嵌套列表:两空格一级
    let src = "- 一级\n  - 二级\n    - 三级\n- 同级\n"
    let st = build_document(parse(lex(src)), src)
    let json = blocks_to_json(st, src)
    assert(json.contains("\"kind\":\"ul\",\"level\":0,\"srcStart\":0,\"srcEnd\":1"), "一级 level 0")
    assert(json.contains("\"kind\":\"ul\",\"level\":1,\"srcStart\":1,\"srcEnd\":2"), "二级 level 1")
    assert(json.contains("\"kind\":\"ul\",\"level\":2,\"srcStart\":2,\"srcEnd\":3"), "三级 level 2")
    assert(json.contains("\"kind\":\"ul\",\"level\":0,\"srcStart\":3,\"srcEnd\":4"), "同级回到 level 0")
    Ok(0)
}

@test
fn core_blocks_single_line_comment_no_swallow() -> Result<i32, String> {
    // 回归:单行式 @[comment 内容](本行已闭)不得向后扫 @[/comment]——
    // 曾把区间撑到后续多行注释的闭合行,吞掉中间块并使后续节点 span 错位
    let src = "@[comment 提示一。]\n\n@[image \"a.png\" width 50%]\n\n@[comment]\n块级注释\n@[/comment]\n\n> 引用测试\n\n@[table tt]\n| a |\n| --- |\n| 1 |\n@[/table]\n"
    let state = build_document(parse(lex(src)), src)
    let json = blocks_to_json(state, src)
    assert(json.contains("\"kind\":\"obj\""), "image 应为 obj")
    assert(json.contains("\"kind\":\"quote\""), "引用不得被吞")
    assert(json.contains("\"kind\":\"table\""), "表格不得被吞")
    assert(json.contains("\"srcStart\":8"), "引用行区间应正确")
    Ok(0)
}

@test
fn core_blocks_multiline_comment_kind() -> Result<i32, String> {
    // 裸开 @[comment] 的 RawBlk 应输出 comment 而非 code
    let src = "@[comment]\n块级注释内容\n@[/comment]\n"
    let state = build_document(parse(lex(src)), src)
    let json = blocks_to_json(state, src)
    assert(json.contains("\"kind\":\"comment\""), "多行注释应为 comment")
    Ok(0)
}

@test
fn container_pack_roundtrip() -> Result<i32, String> {
    let syntax = "# 标题\n\n正文段落,含图。\n\n@[image \"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7\"]\n"
    let packed = pack_awen(syntax, "build/_ctest.awen", "awen-test-1", "build")
    assert(!packed.contains("data:image"), "data URI 应被替换")
    assert(packed.contains("media/img-"), "应含 media 引用")
    let st = unpack_awen("build/_ctest.awen", "build", "build/_ctest_src.awen")
    assert(st.contains("\"ok\":true"), st)
    let back = read_file("build/_ctest_src.awen")
    assert(back == packed, "往返源码应一致")
    let img = read_bytes("build/img-ef1955ae757c8b96.gif")
    assert(img.len() == 42, "GIF 字节数应为 42")
    Ok(0)
}

@test
fn sha256_known_vectors() -> Result<i32, String> {
    // FIPS 180-4 已知向量(前 64 位)
    assert(sha256_64hex(to_bytes("abc")) == "ba7816bf8f01cfea", "SHA-256 abc 向量不符")
    assert(sha256_64hex(to_bytes("")) == "e3b0c44298fc1c14", "SHA-256 空串向量不符")
    var many: Vec<i32> = []
    var i: i32 = 0
    while i < 55 {
        many = many.push(97)
        i += 1
    }
    // 55 字节:填充恰好跨块,验证多块压缩
    assert(sha256_64hex(many) == "9f4390f8d30c2dd9", "SHA-256 55 字节向量不符")
    Ok(0)
}

// ── 块级增量解析(segment_blocks_json)────────────────────────
// 关键不变量:段(无空行连续行)独立解析的块记录与全文解析对应记录
// 完全一致(kind/level/text/lang);srcStart/srcEnd 除外(行基不同)。

// 取 blocks JSON 的块签名(kind|level|text|lang 序列),供对拍
fn seg_recs_sig(json: String) -> String {
    let v = json_decode(json)
    let arr = match v.get("blocks") { Some(x) { x } None { [] } }
    var out = ""
    var i: i32 = 0
    while i < arr.len() {
        let b = arr.get(i)
        let kind = match b.get("kind") { Some(x) { x } None { "" } }
        let level = match b.get("level") { Some(x) { x } None { 0 } }
        let text = match b.get("text") { Some(x) { x } None { "" } }
        let lang = match b.get("lang") { Some(x) { x } None { "" } }
        out = out + kind + "|" + f"{level}" + "|" + text + "|" + lang + "\n"
        i += 1
    }
    return out
}

// 全文解析后按段切分(以空行分段),返回各段签名拼接
fn full_doc_segs_sig(src: String) -> String {
    let state = build_document(parse(lex(src)), src)
    let json = blocks_to_json(state, src)
    return seg_recs_sig(json)
}

@test
fn segment_parse_empty() -> Result<i32, String> {
    assert(segment_blocks_json("") == "{\"blocks\":[],\"diags\":[],\"outline\":[]}",
        "空段应返回空 blocks")
    Ok(0)
}

@test
fn segment_parse_para_matches_full() -> Result<i32, String> {
    let seg = "这是第二段,含 **加粗** 与 `code` 片段。"
    let seg_sig = seg_recs_sig(segment_blocks_json(seg))
    let full_sig = full_doc_segs_sig("# 大标题\n\n第一段占位。\n\n" + seg + "\n\n第三段占位。\n")
    // 全文 3 段 + 标题:签名应含段签名(段内 rec 与独立解析逐字节一致)
    assert(full_sig.contains(seg_sig), "段落段独立解析应与全文解析一致:" + seg_sig)
    Ok(0)
}

@test
fn segment_parse_heading_matches_full() -> Result<i32, String> {
    let seg_sig = seg_recs_sig(segment_blocks_json("## 二级标题甲"))
    assert(seg_sig.contains("heading|2|## 二级标题甲|"), seg_sig)
    let full_sig = full_doc_segs_sig("# 一级\n\n" + "## 二级标题甲" + "\n\n正文。\n")
    assert(full_sig.contains(seg_sig), "标题段独立解析应与全文解析一致")
    Ok(0)
}

@test
fn segment_parse_list_matches_full() -> Result<i32, String> {
    let seg = "- 甲\n- 乙\n- 丙"
    let seg_sig = seg_recs_sig(segment_blocks_json(seg))
    assert(seg_sig.contains("ul|0|- 甲|"), seg_sig)
    let full_sig = full_doc_segs_sig("引子。\n\n" + seg + "\n\n结尾。\n")
    assert(full_sig.contains(seg_sig), "列表段独立解析应与全文解析一致")
    Ok(0)
}

@test
fn segment_parse_quote_table_code() -> Result<i32, String> {
    let q = seg_recs_sig(segment_blocks_json("> 引用一行"))
    assert(q.contains("quote|0|> 引用一行|"), q)
    let t = "@[table t]\n| a | b |\n| --- | --- |\n| 1 | 2 |\n@[/table]"
    let ts = seg_recs_sig(segment_blocks_json(t))
    assert(ts.contains("\"kind\":\"table\"") || ts.contains("table|0|" + t + "|"), ts)
    let c = seg_recs_sig(segment_blocks_json("@[c]\n代码行一\n代码行二\n@[/c]"))
    assert(c.contains("code|0|"), c)
    Ok(0)
}

@test
fn segment_parse_para_merge_in_segment() -> Result<i32, String> {
    // §14:段内连续物理行合并为一个 Para(与全文行为一致)
    let seg_sig = seg_recs_sig(segment_blocks_json("行甲延续\n行乙延续"))
    let full_sig = full_doc_segs_sig("其他。\n\n行甲延续\n行乙延续\n\n尾段。\n")
    assert(full_sig.contains(seg_sig), "段内多行合并应与全文一致:" + seg_sig)
    assert(seg_sig.contains("para|0|行甲延续\n行乙延续|"), seg_sig)
    Ok(0)
}

@test
fn layout_recs_aligns_with_blocks() -> Result<i32, String> {
    // A′:recs 与 blocks_to_json 记录同序同展开;注释/docset 沿用邻页
    let src = "# 标题\n\n正文甲。\n\n- 甲\n- 乙\n\n@[comment 提示]\n\n@[page A4]\n\n正文乙。\n"
    let state = build_document(parse(lex(src)), src)
    let flow = page_flow_with(state, page_flow_ctx())
    let json = layout_recs_json(state, src, flow)
    let blocks = blocks_to_json(state, src)
    // 解析两侧 JSON 对比数量
    let jv = json_decode(json)
    let bv = json_decode(blocks)
    let recs = match jv.get("recs") { Some(x) { x } None { [] } }
    let blocks_arr = match bv.get("blocks") { Some(x) { x } None { [] } }
    assert(recs.len() == blocks_arr.len(), f"recs {recs.len()} 应等于 blocks {blocks_arr.len()}")
    assert(flow.pages >= 1, "至少一页")
    // 全部页号在 [0, pages) 内
    var i: i32 = 0
    while i < recs.len() {
        let pg = recs.get(i)
        assert(pg >= 0 && pg < flow.pages, f"recs[{i}]={pg} 越界")
        i += 1
    }
    Ok(0)
}

@test
fn layout_ctx_cfg_formula() -> Result<i32, String> {
    // A4/20mm/12pt/2.0:line_h=12*0.352778*2.0;max_em=(210-40)/(12*0.352778)
    let ctx = page_flow_ctx_cfg(210.0, 297.0, 20.0, 12.0, 2.0)
    let expect_lh = 12.0 * 0.352778 * 2.0
    let expect_em = (210.0 - 40.0) / (12.0 * 0.352778)
    assert(ctx.line_h > expect_lh - 0.0001 && ctx.line_h < expect_lh + 0.0001, "line_h 公式不符")
    assert(ctx.max_em > expect_em - 0.01 && ctx.max_em < expect_em + 0.01, "max_em 公式不符")
    assert(ctx.content_h > 248.4 && ctx.content_h < 248.6, "content_h 公式不符(应预留一行)")
    Ok(0)
}

@test
fn layout_cfg_narrow_page_more_pages() -> Result<i32, String> {
    // 同一文档,窄页(max_em 小)分页数不得少于宽页
    var src = "首段。\n\n"
    var i: i32 = 0
    while i < 60 {
        src = src + "这是第" + f"{i}" + "句内容,持续填充以形成多页文档。\n\n"
        i += 1
    }
    let state = build_document(parse(lex(src)), src)
    let wide = page_flow_with(state, page_flow_ctx_cfg(210.0, 297.0, 20.0, 11.0, 1.65))
    let narrow = page_flow_with(state, page_flow_ctx_cfg(105.0, 297.0, 20.0, 11.0, 1.65))
    assert(narrow.pages > wide.pages, f"窄页 {narrow.pages} 应多于宽页 {wide.pages}")
    Ok(0)
}

@test
fn container_hash_verify() -> Result<i32, String> {
    // 正常解包:新容器(16 hex SHA-256 截断哈希)应校验通过
    let st = unpack_awen("build/_ctest.awen", "build", "build/_hv_src.awen")
    assert(st.contains("\"ok\":true"), "正常容器应解包成功:"+st)
    assert(st.contains("\"verified\":1"), "应校验 1 块:"+st)
    // 篡改块区一个字节 → 解包必须拒绝
    var v = read_bytes("build/_ctest.awen")
    let sig = to_bytes("GIF89a")
    var pos = -1
    var i: i32 = 0
    while i + 6 <= v.len() {
        if bytes_eq(v[i..(i + 6)], sig) { pos = i }
        i += 1
    }
    assert(pos >= 0, "应能定位 GIF 块")
    v[(pos + 10)] = (v[(pos + 10)] + 1) % 256
    write_bytes("build/_hv_tampered.awen", v)
    let st2 = unpack_awen("build/_hv_tampered.awen", "build", "build/_hv2_src.awen")
    assert(st2.contains("\"ok\":false"), "损坏容器必须被拒绝:"+st2)
    assert(st2.contains("hash mismatch"), "应报哈希不符:"+st2)
    Ok(0)
}
