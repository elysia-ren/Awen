// generate_preview.aine —— E1 演示入口
// 读取源码 → 管线 → JSON → 注入模板 → 生成自包含编辑器 HTML
// 运行: aine run src/generate_preview.aine
// 输出: preview/preview.html

module diag;
module registry;
module fullwidth;
module escape;
module explicit;
module lightweight;
module lexer;
module parser;
module document;
module mapping;
module refs;
module theme;
module render;
module incremental;
module pipeline;
module cjk;
module layout;
module layout_width;
module page_flow;
module json_export;
module validate;
module toc;
module diff;
module inspect;
module export_html;
module heading_tree;
module numbering;
module container;
module fmt;
module export_md;
module seed;
module incremental_update;

fn main() {
    // 1) 读取源码
    var src = read_file("corpus/all_syntax.awen")
    if src.contains("[read_file error") {
        print("corpus 不存在,使用内置示例")
        src = "# Awen 文档\n\n这是第一段。\n\n## 二级标题\n\n这是第二段。\n\n### 三级标题\n\n尾段。\n"
    }

    // 2) 读取模板
    let template = read_file("preview/template.html")
    if template.contains("[read_file error") {
        print("错误:找不到 preview/template.html")
        return
    }

    // 3) 管线 → JSON
    let json = src_to_json(src)

    // 4) 注入 JSON 到模板
    let placeholder = "/*__JSON__*/{}"
    var output = template
    if output.contains(placeholder) {
        output = output.replace(placeholder, json)
    } else if output.contains("/*__JSON__*/") {
        output = output.replace("/*__JSON__*/", json)
    } else {
        output = output.replace("</head>", "<script>const DATA = " + json + ";</script>\n</head>")
    }

    // 5) 写出
    write_file("preview/preview.html", output)
    print("已生成 preview/preview.html — 用浏览器打开即可预览")
}
