// page_flow.aine —— 分页流(M5-a 全量;P1-2 增量排版)
// §42:失效传播 + 稳定点终止 —— 定位首个内容变化节点,从其在上一轮的
// 页/纵向光标恢复重排;每排完一个节点,若该节点的恢复状态(节点 ID + 页 +
// 纵向偏移 + 内容签名)与上一轮完全一致,其后内容必然不变 → 复制旧结果终止。
// 注释(§11.3)与块级注释不进版面;图占位 40mm,页尾放不下整块推页。
// ⚠ Aine 限制:结构体字段不可赋值 → 光标用标量 (page, y) 贯穿传递。

struct PlacedLine {
    node_id: i32
    page: i32
    y_mm: f64
    text: String
}

struct NodeBox {
    node_id: i32
    start_page: i32
    end_page: i32
    lines: i32
}

struct PageFlowResult {
    pages: i32
    placed: Vec<PlacedLine>
    boxes: Vec<NodeBox>
    // 每个节点的内容签名(文档序,含注释;§42 稳定点判定与首变定位)
    sigs: Vec<String>
    // 增量统计(全量排版两值均为 0)
    reused_lines: i32
    recomputed_lines: i32
    // 末尾光标(增量追加场景恢复用)
    end_page: i32
    end_y: f64
}

// 排版上下文(不可变部分)
struct FlowCtx {
    line_h: f64
    max_em: f64
    content_h: f64
    gap_lines: f64
    img_h: f64
    // 块间距(与前端块间 gap 一致,校准引擎容量与真实纸面)
    gap_mm: f64
    // 快速估行模式(>0 启用):整块测宽÷行宽估行数,不做逐词断行,
    // 跳过内容签名——daemon 交互路径专用(千块级文档秒级返回);
    // 精确排版(导出/增量收敛)仍走 0 的完整模式
    fast: i32
    // 字体度量宽表(区间首尾字符 + em 宽;空 = 均匀估宽模型)
    wf_start_s: String
    wf_end_s: String
    wf_ws: Vec<f64>
}

fn page_flow_ctx() -> FlowCtx {
    let pm = page_model_a4()
    let font = 11.0
    return FlowCtx {
        line_h: font * 1.65 * 0.352778,
        max_em: content_width(pm) / (font * 0.352778),
        content_h: content_height(pm),
        gap_lines: 1.0,
        img_h: 40.0,
        gap_mm: font * 0.55 * 0.352778,
        fast: 0,
        wf_start_s: "",
        wf_end_s: "",
        wf_ws: [],
    }
}

// 排版上下文(文档设置驱动,A' 引擎全权排版权威):
// page_w/page_h/margin 单位 mm,font_pt 单位 pt,line_sp 为 CSS 倍数行距。
// 数值经 +0.0 提升 f64(json_decode 的整数是 i32 标注,直接绑 f64 字段会炸)。
fn page_flow_ctx_cfg(page_w: f64, page_h: f64, margin: f64, font_pt: f64, line_sp: f64) -> FlowCtx {
    return page_flow_ctx_cfg_w(page_w, page_h, margin, font_pt, line_sp, "", "", [])
}

// 带字体度量宽表的构造(daemon 交互路径)
fn page_flow_ctx_cfg_w(page_w: f64, page_h: f64, margin: f64, font_pt: f64, line_sp: f64, wf_s: String, wf_e: String, wf_w: Vec<f64>) -> FlowCtx {
    let mm = font_pt * 0.352778
    // content_h 预留一行:估宽与真实字形有偏差,宁可提前分页
    // 也不让纸面物理溢出(溢出=用户看到的"页面越输越长")
    return FlowCtx {
        line_h: mm * line_sp,
        max_em: (page_w - margin * 2.0) / mm,
        content_h: page_h - margin * 2.0 - mm * line_sp,
        gap_lines: 1.0,
        img_h: 40.0,
        gap_mm: font_pt * 0.55 * 0.352778,
        fast: 1,
        wf_start_s: wf_s,
        wf_end_s: wf_e,
        wf_ws: wf_w,
    }
}

// 全量排版(显式上下文);page_flow(state) 保持默认 A4 旧签名不动
fn page_flow_with(state: DocState, ctx: FlowCtx) -> PageFlowResult {
    let para_sp = doc_para_spacing_mm(state)
    var page = 0
    var y = 0.0
    var placed: Vec<PlacedLine> = []
    var boxes: Vec<NodeBox> = []
    var sigs: Vec<String> = []

    for node in state.nodes {
        if ctx.fast == 0 {
            sigs = sigs.push(page_node_sig(node))
        }
        let r = page_flow_node(ctx, node, page, y, placed)
        placed = r.placed
        page = r.page
        y = r.y
        if r.lines >= 0 {
            boxes = boxes.push(NodeBox { node_id: node.id, start_page: r.box_start, end_page: r.box_end, lines: r.box_lines })
        }
        // 块间距:前端每块之间有 0.55*字号 的视觉间隙,引擎容量必须同计,
        // 否则引擎估的一页装不下真实纸面 → 纸面物理溢出(页面越输越长)
        if r.lines >= 0 {
            y = y + ctx.gap_mm
            if y + ctx.line_h > ctx.content_h {
                page = page + 1
                y = 0.0
            }
        }
        if node.kind == "para" && para_sp > 0.0 {
            y = y + para_sp
            if y + ctx.line_h > ctx.content_h {
                page = page + 1
                y = 0.0
            }
        }
    }

    return PageFlowResult {
        pages: page + 1,
        placed: placed,
        boxes: boxes,
        sigs: sigs,
        reused_lines: 0,
        recomputed_lines: 0,
        end_page: page,
        end_y: y,
    }
}

// 单节点排版结果:新光标(标量)+ 行数 + 行集 + 盒;lines = -1 表示无行无盒(注释)
struct FlowOneOut {
    page: i32
    y: f64
    lines: i32
    placed: Vec<PlacedLine>
    box_node: i32
    box_start: i32
    box_end: i32
    box_lines: i32
}

// ceil(w/unit):向上取整除(行数有限,整数累加避免浮点转整)
fn ceil_ratio(w: f64, unit: f64) -> i32 {
    if w <= 0.0 { return 1 }
    var n: i32 = 1
    var acc = unit
    while acc < w {
        acc = acc + unit
        n += 1
        if n > 200000 { break }
    }
    return n
}

fn page_flow_put(ctx: FlowCtx, page: i32, y: f64, node_id: i32, text: String, out: Vec<PlacedLine>) -> FlowOneOut {
    let o = out.push(PlacedLine { node_id: node_id, page: page, y_mm: y, text: text })
    var np = page
    var ny = y + ctx.line_h
    if ny + ctx.line_h > ctx.content_h {
        np = np + 1
        ny = 0.0
    }
    return FlowOneOut { page: np, y: ny, lines: 1, placed: o, box_node: 0, box_start: 0, box_end: 0, box_lines: 0 }
}

// 排一个节点。Comment/块级注释:lines = -1(无行无盒)
fn page_flow_node(ctx: FlowCtx, node: SemNode, page: i32, y: f64, out: Vec<PlacedLine>) -> FlowOneOut {
    let id = node.id
    let box_start = page

    if node.kind == "comment" {
        return FlowOneOut { page: page, y: y, lines: -1, placed: out, box_node: 0, box_start: 0, box_end: 0, box_lines: 0 }
    }
    if node.kind == "raw" && node.raw_cmd == Comment {
        return FlowOneOut { page: page, y: y, lines: -1, placed: out, box_node: 0, box_start: 0, box_end: 0, box_lines: 0 }
    }

    // 快速估行:整块文本测宽 ÷ 行宽 = 行数(±1 行误差,页分配足够),
    // 跳过逐词断行的解释器开销;文档级设置依旧不进版面
    if ctx.fast > 0 {
        if node.kind == "obj" && is_doc_level(node.obj_cu.cmd) {
            return FlowOneOut { page: page, y: y, lines: -1, placed: out, box_node: 0, box_start: 0, box_end: 0, box_lines: 0 }
        }
        var text = ""
        if node.kind == "heading" || node.kind == "para" {
            text = inline_marked_text(node.inline)
        } else if node.kind == "quote" {
            text = "> " + inline_marked_text(node.inline)
        } else if node.kind == "list" {
            for item in node.list_items {
                text = text + "- " + inline_marked_text(item) + " "
            }
        } else if node.kind == "raw" {
            for l in node.raw_lines {
                text = text + l + " "
            }
        } else if node.kind == "table" {
            for cell in node.tbl_header {
                text = text + inline_plain(cell) + " "
            }
            for row in node.tbl_rows {
                for cell in row {
                    text = text + inline_plain(cell) + " "
                }
            }
        } else if node.kind == "hr" {
            text = "――――――――――"
        } else if node.kind == "obj" {
            text = f"@[{node.obj_cu.name_raw}]"
        }
        // 估行补偿:贪心断行的行利用率 <100%(禁则/词边界推挤),
        // 乘 1.25 系数低估会重新引发"页面塞太满→纸面拉长"
        let total_w = layout_measure_w(text, ctx) * 1.15
        let lines_n = ceil_ratio(total_w, ctx.max_em)
        // 光标直接推进,不产逐行 PlacedLine(recs 只需页号,省 5 万次 Vec push)
        var p = page
        var yy = y
        var li = 0
        while li < lines_n {
            yy = yy + ctx.line_h
            if yy + ctx.line_h > ctx.content_h {
                p = p + 1
                yy = 0.0
            }
            li += 1
        }
        return FlowOneOut { page: p, y: yy, lines: lines_n, placed: out, box_node: id, box_start: box_start, box_end: p, box_lines: lines_n }
    }

    if node.kind == "heading" || node.kind == "para" || node.kind == "quote" {
        var text = inline_marked_text(node.inline)
        if node.kind == "quote" { text = "引用:" + text }
        var o = out
        var p = page
        var yy = y
        var n = 0
        for l in layout_line_break(text, ctx.max_em) {
            let r = page_flow_put(ctx, p, yy, id, l, o)
            o = r.placed
            p = r.page
            yy = r.y
            n = n + r.lines
        }
        if node.kind == "heading" && node.level <= 2 {
            yy = yy + ctx.gap_lines * ctx.line_h
            if yy + ctx.line_h > ctx.content_h {
                p = p + 1
                yy = 0.0
            }
        }
        return FlowOneOut { page: p, y: yy, lines: n, placed: o, box_node: id, box_start: box_start, box_end: p, box_lines: n }
    }
    if node.kind == "list" {
        var o = out
        var p = page
        var yy = y
        var n = 0
        var idx = 0
        for item in node.list_items {
            idx += 1
            var marker = "- "
            if node.list_ordered { marker = f"{idx}. " }
            let text = marker + inline_marked_text(item)
            for l in layout_line_break(text, ctx.max_em) {
                let r = page_flow_put(ctx, p, yy, id, l, o)
                o = r.placed
                p = r.page
                yy = r.y
                n = n + r.lines
            }
        }
        return FlowOneOut { page: p, y: yy, lines: n, placed: o, box_node: id, box_start: box_start, box_end: p, box_lines: n }
    }
    if node.kind == "hr" {
        let r = page_flow_put(ctx, page, y, id, "――――――――――", out)
        return FlowOneOut { page: r.page, y: r.y, lines: 1, placed: r.placed, box_node: id, box_start: box_start, box_end: r.page, box_lines: 1 }
    }
    if node.kind == "raw" {
        var o = out
        var p = page
        var yy = y
        var n = 0
        for l in node.raw_lines {
            let r = page_flow_put(ctx, p, yy, id, l, o)
            o = r.placed
            p = r.page
            yy = r.y
            n = n + r.lines
        }
        return FlowOneOut { page: p, y: yy, lines: n, placed: o, box_node: id, box_start: box_start, box_end: p, box_lines: n }
    }
    if node.kind == "table" {
        var o = out
        var p = page
        var yy = y
        var n = 0
        if node.tbl_header.len() > 0 {
            var row = "|"
            for cell in node.tbl_header {
                row = row + " " + inline_plain(cell) + " |"
            }
            let r = page_flow_put(ctx, p, yy, id, row, o)
            o = r.placed
            p = r.page
            yy = r.y
            n = n + r.lines
        }
        for r2 in node.tbl_rows {
            var row = "|"
            for cell in r2 {
                row = row + " " + inline_plain(cell) + " |"
            }
            let r = page_flow_put(ctx, p, yy, id, row, o)
            o = r.placed
            p = r.page
            yy = r.y
            n = n + r.lines
        }
        return FlowOneOut { page: p, y: yy, lines: n, placed: o, box_node: id, box_start: box_start, box_end: p, box_lines: n }
    }
    if node.kind == "obj" {
        // 文档级设置(page/margin/font/size/theme/numbering 等)不进版面
        if is_doc_level(node.obj_cu.cmd) {
            return FlowOneOut { page: page, y: y, lines: -1, placed: out, box_node: 0, box_start: 0, box_end: 0, box_lines: 0 }
        }
        if node.obj_cu.cmd == Image || node.obj_cu.cmd == Figure {
            var p = page
            var yy = y
            if yy + ctx.img_h > ctx.content_h {
                p = p + 1
                yy = ctx.img_h
            } else {
                yy = yy + ctx.img_h
            }
            return FlowOneOut { page: p, y: yy, lines: 1, placed: out, box_node: id, box_start: box_start, box_end: p, box_lines: 1 }
        }
        let r = page_flow_put(ctx, page, y, id, f"@[{node.obj_cu.name_raw}]", out)
        return FlowOneOut { page: r.page, y: r.y, lines: 1, placed: r.placed, box_node: id, box_start: box_start, box_end: r.page, box_lines: 1 }
    }
    // 兜底:未知类别按一行处理
    let r = page_flow_put(ctx, page, y, id, "…", out)
    return FlowOneOut { page: r.page, y: r.y, lines: 1, placed: r.placed, box_node: id, box_start: box_start, box_end: r.page, box_lines: 1 }
}

// 节点内容签名(§42 稳定点判定;覆盖一切影响版面的内容)
fn page_node_sig(n: SemNode) -> String {
    var s = n.kind + "/" + f"{n.level}"
    s = s + "|" + inline_plain(n.inline)
    if n.kind == "comment" { s = s + "|" + n.comment_text }
    if n.kind == "raw" {
        for l in n.raw_lines { s = s + "|" + l }
    }
    if n.kind == "list" {
        for it in n.list_items { s = s + "|" + inline_plain(it) }
    }
    if n.kind == "table" {
        for cell in n.tbl_header { s = s + "|" + inline_plain(cell) }
        for r in n.tbl_rows {
            for cell in r { s = s + "|" + inline_plain(cell) }
        }
    }
    if n.kind == "obj" { s = s + "|" + n.obj_cu.name_raw }
    return s
}

fn page_flow_count_lines(placed: Vec<PlacedLine>, page: i32) -> i32 {
    var n = 0
    for l in placed {
        if l.page == page { n = n + 1 }
    }
    return n
}

// F-4 段间距:从源码扫描 @[para-spacing X](em/mm/纯数值→em),返回 mm
// 多个设置行取最后一个;未找到返回 0
fn doc_para_spacing_mm(state: DocState) -> f64 {
    // F-4 段间距:扫源码取最后一个 @[para-spacing X](mm/em/纯数值→em)
    let lines = state.source.split("\n")
    var val = 0.0
    var i = 0
    while i < lines.len() {
        let t = lines[i]
        let tag = "@[para-spacing "
        if t.starts_with(tag) {
            let close = t.len() - 1
            var inner = t[tag.len() .. close]
            let tail2 = inner[inner.len() - 2 .. inner.len()]
            if tail2 == "mm" {
                val = inner[0 .. inner.len() - 2].to_f64()
            } else {
                val = inner.to_f64() * 11.0 * 0.352778
            }
        }
        i += 1
    }
    return val
}


// 全量排版(M5-a)
fn page_flow(state: DocState) -> PageFlowResult {
    let para_sp = doc_para_spacing_mm(state)
    let ctx = page_flow_ctx()
    var page = 0
    var y = 0.0
    var placed: Vec<PlacedLine> = []
    var boxes: Vec<NodeBox> = []
    var sigs: Vec<String> = []

    for node in state.nodes {
        sigs = sigs.push(page_node_sig(node))
        let r = page_flow_node(ctx, node, page, y, placed)
        placed = r.placed
        page = r.page
        y = r.y
        if r.lines >= 0 {
            boxes = boxes.push(NodeBox { node_id: node.id, start_page: r.box_start, end_page: r.box_end, lines: r.box_lines })
        }
        // F-4 段间距:段落之后追加额外间距(跨页则截断到下一页首)
        if node.kind == "para" && para_sp > 0.0 {
            y = y + para_sp
            if y + ctx.line_h > ctx.content_h {
                page = page + 1
                y = 0.0
            }
        }
    }

    return PageFlowResult {
        pages: page + 1,
        placed: placed,
        boxes: boxes,
        sigs: sigs,
        reused_lines: 0,
        recomputed_lines: 0,
        end_page: page,
        end_y: y,
    }
}

// ── 页码 resolver(§7.2 两级解析;§7.4 导出收敛 ≤4 次;P2-3)──────

struct AnchorEntry {
    label: String
    page: i32
}

// Label 锚点 → 页码(基于当前分页结果)
fn page_flow_anchor_pages(state: DocState, result: PageFlowResult) -> Vec<AnchorEntry> {
    var out: Vec<AnchorEntry> = []
    let ls = collect_labels(state)
    for e in ls {
        for b in result.boxes {
            if b.node_id == e.node_id {
                out = out.push(AnchorEntry { label: e.label, page: b.start_page })
            }
        }
    }
    return out
}

fn anchors_equal(a: Vec<AnchorEntry>, b: Vec<AnchorEntry>) -> bool {
    if a.len() != b.len() { return false }
    var i = 0
    while i < a.len() {
        if a[i].label != b[i].label || a[i].page != b[i].page { return false }
        i += 1
    }
    return true
}

struct PageFlowConv {
    result: PageFlowResult
    anchors: Vec<AnchorEntry>
    iters: i32
    converged: bool
}

// 导出/打印路径(§7.4):迭代排版至锚点页码稳定(上限 max_iters);
// 正常文档 1 次即收敛;超限视为异常循环依赖。实时路径(§7.3)允许 stale,
// 不走此函数。
fn page_flow_converged(state: DocState, max_iters: i32) -> PageFlowConv {
    var result = page_flow(state)
    var anchors = page_flow_anchor_pages(state, result)
    var iters = 0
    var converged = false
    var guard = 0
    while guard < max_iters {
        guard += 1
        iters += 1
        let r2 = page_flow(state)
        let a2 = page_flow_anchor_pages(state, r2)
        result = r2
        if anchors_equal(anchors, a2) {
            anchors = a2
            converged = true
            break
        }
        anchors = a2
    }
    return PageFlowConv { result: result, anchors: anchors, iters: iters, converged: converged }
}

// ── 增量排版(P1-2;§42:失效传播 + 稳定点终止)────────────────

// 上一轮某节点的首行下标(无行返回 -1)
fn prev_first_line(prev: PageFlowResult, node_id: i32) -> i32 {
    var i = 0
    while i < prev.placed.len() {
        if prev.placed[i].node_id == node_id { return i }
        i += 1
    }
    return -1
}

// 增量排版:与 page_flow(state) 结果严格一致,但复用上一轮未变前缀,
// 并以稳定点提前终止。统计字段报告复用/重排行数。
fn page_flow_incremental(state: DocState, prev: PageFlowResult) -> PageFlowResult {
    let ctx = page_flow_ctx()
    let nodes = state.nodes

    // 1) 首变定位:第一个签名不同的节点(追加场景 = 第一个超出上一轮的下标)
    var start_ix = nodes.len()
    var k = 0
    while k < nodes.len() {
        if k >= prev.sigs.len() {
            start_ix = k
            break
        }
        if page_node_sig(nodes[k]) != prev.sigs[k] {
            start_ix = k
            break
        }
        k += 1
    }
    // 无内容变化:结果与上一轮相同(构造新值;Aine 不支持字段赋值)
    if start_ix >= nodes.len() {
        return PageFlowResult {
            pages: prev.pages,
            placed: prev.placed,
            boxes: prev.boxes,
            sigs: prev.sigs,
            reused_lines: prev.placed.len(),
            recomputed_lines: 0,
            end_page: prev.end_page,
            end_y: prev.end_y,
        }
    }

    // 2) 恢复点:start_ix 节点(id = start_ix+1)在上一轮的首行
    let resume_id = start_ix + 1
    let li = prev_first_line(prev, resume_id)
    var placed: Vec<PlacedLine> = []
    var page = 0
    var y = 0.0
    var reused = 0
    if li >= 0 {
        var q = 0
        while q < li {
            placed = placed.push(prev.placed[q])
            q += 1
        }
        reused = li
        page = prev.placed[li].page
        y = prev.placed[li].y_mm
    } else {
        // 恢复节点无行(注释等)或为纯追加:从上一轮末尾光标恢复
        page = prev.end_page
        y = prev.end_y
    }

    // 3) 从恢复点重排;逐节点尝试稳定点(m > start_ix 才允许判定)
    var recomputed = 0
    var boxes: Vec<NodeBox> = []
    var stable_line = -1
    var m = start_ix
    while m < nodes.len() {
        if m > start_ix {
            let pi = prev_first_line(prev, m + 1)
            if pi >= 0 && page_node_sig(nodes[m]) == prev.sigs[m] {
                if prev.placed[pi].page == page && prev.placed[pi].y_mm == y {
                    stable_line = pi
                    break
                }
            }
        }
        let r = page_flow_node(ctx, nodes[m], page, y, placed)
        placed = r.placed
        page = r.page
        y = r.y
        if r.lines >= 0 {
            recomputed = recomputed + r.lines
            boxes = boxes.push(NodeBox { node_id: nodes[m].id, start_page: r.box_start, end_page: r.box_end, lines: r.box_lines })
        }
        m = m + 1
    }

    // 4) 稳定点后:复制上一轮剩余行与盒(签名相同 + 光标相同 → 必然一致)
    if stable_line >= 0 {
        var q = stable_line
        while q < prev.placed.len() {
            placed = placed.push(prev.placed[q])
            q += 1
        }
        page = prev.end_page
        y = prev.end_y
        var b = 0
        while b < prev.boxes.len() {
            if prev.boxes[b].node_id > m {
                boxes = boxes.push(prev.boxes[b])
            }
            b += 1
        }
    }

    return PageFlowResult {
        pages: page + 1,
        placed: placed,
        boxes: boxes,
        sigs: prev.sigs,
        reused_lines: placed.len() - recomputed,
        recomputed_lines: recomputed,
        end_page: page,
        end_y: y,
    }
}

// ── 快速增量排版(A′ daemon 路径)────────────────────────────
// 与 fast 全量同口径(估行),复用上一轮前缀盒与首变节点起始页;
// 尾段用 fast 节点排版重推。不产 PlacedLine(recs 只需页号)。
// prev 须为同一文档上一轮的 fast 结果;cfg 变化由调用方判重。
fn page_flow_incremental_fast(state: DocState, prev: PageFlowResult, ctx: FlowCtx) -> PageFlowResult {
    let nodes = state.nodes
    // 全量签名(供本轮首变定位与下一轮复用)
    var sigs: Vec<String> = []
    var k = 0
    while k < nodes.len() {
        sigs = sigs.push(page_node_sig(nodes[k]))
        k += 1
    }
    // 首变定位:第一个签名不同的节点
    var start_ix = nodes.len()
    var changed = false
    k = 0
    while k < nodes.len() {
        if k >= prev.sigs.len() {
            start_ix = k
            changed = true
            break
        }
        if sigs[k] != prev.sigs[k] {
            start_ix = k
            changed = true
            break
        }
        k += 1
    }
    if !changed {
        return PageFlowResult {
            pages: prev.pages,
            placed: prev.placed,
            boxes: prev.boxes,
            sigs: sigs,
            reused_lines: prev.placed.len(),
            recomputed_lines: 0,
            end_page: prev.end_page,
            end_y: prev.end_y,
        }
    }
    // 恢复点:首变节点在上一轮的起始页,页首 y=0
    var page = prev.end_page
    var y = prev.end_y
    var bi = 0
    while bi < prev.boxes.len() {
        if prev.boxes[bi].node_id == start_ix + 1 {
            page = prev.boxes[bi].start_page
            y = 0.0
        }
        bi += 1
    }
    // 首变之前的盒原样保留
    var boxes: Vec<NodeBox> = []
    var b2 = 0
    while b2 < prev.boxes.len() {
        if prev.boxes[b2].node_id < start_ix + 1 {
            boxes = boxes.push(prev.boxes[b2])
        }
        b2 += 1
    }
    // 尾段 fast 重排(含 F-4 段间距,与 page_flow_with 同口径)
    let para_sp = doc_para_spacing_mm(state)
    var m = start_ix
    while m < nodes.len() {
        let r = page_flow_node(ctx, nodes[m], page, y, [])
        page = r.page
        y = r.y
        if r.lines >= 0 {
            boxes = boxes.push(NodeBox { node_id: nodes[m].id, start_page: r.box_start, end_page: r.box_end, lines: r.box_lines })
            y = y + ctx.gap_mm
            if y + ctx.line_h > ctx.content_h {
                page = page + 1
                y = 0.0
            }
        }
        if nodes[m].kind == "para" && para_sp > 0.0 {
            y = y + para_sp
            if y + ctx.line_h > ctx.content_h {
                page = page + 1
                y = 0.0
            }
        }
        m += 1
    }
    return PageFlowResult {
        pages: page + 1,
        placed: [],
        boxes: boxes,
        sigs: sigs,
        reused_lines: 0,
        recomputed_lines: 0,
        end_page: page,
        end_y: y,
    }
}
