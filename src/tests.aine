}

// ── 更多 theme + render + 编辑综合测试 ──────────────────────

@test
fn theme_edit_preserves_heading_size() -> Result<i32, String> {
    // 编辑 heading 后 theme 的 size 规则仍应正确应用
    let src = "# 标题 A\n# 标题 B\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_new("size_test")
    t = theme_add_rule(t, "heading", 1, "size", "24pt")
    // 编辑前:两个 H1 都应为 24pt
    let items1 = render_document(state, t)
    var count_24_before = 0
    for item in items1 {
        if item.font_size == "24pt" { count_24_before += 1 }
    }
    assert(count_24_before == 2, f"编辑前应有 2 个 24pt,得到 {count_24_before}")
    // 编辑第一个 heading
    let r = edit_heading_text(state, 1, "修改后的 A", src)
    let out2 = lex(r.new_source)
    let pr2 = parse(out2)
    let state2 = build_document(pr2, r.new_source)
    let items2 = render_document(state2, t)
    var count_24_after = 0
    for item in items2 {
        if item.font_size == "24pt" { count_24_after += 1 }
    }
    assert(count_24_after == 2, f"编辑后仍应有 2 个 24pt,得到 {count_24_after}")
    return Ok(0)
}

@test
fn theme_body_size_with_document_font() -> Result<i32, String> {
    // 文档级 @[size] 和 @[font] 独立设置
    let src = "@[size 14pt]\n@[font \"Serif\"]\n正文\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_from_document(state)
    let size = resolve_style(t, "body", 0, "size", None)
    let font = resolve_style(t, "body", 0, "font", None)
    assert(size == "14pt", f"size 应为 14pt,得到 {size}")
    assert(font == "Serif", f"font 应为 Serif,得到 {font}")
    return Ok(0)
}

@test
fn render_list_ordered_and_unordered_separate() -> Result<i32, String> {
    // 有序和无序列表应产生不同的渲染
    let src = "- 无序项\n\n1. 有序项\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var found_unordered = false
    var found_ordered = false
    for node in state.nodes {
        if node.kind == "list" {
            if node.list_ordered { found_ordered = true }
            else { found_unordered = true }
        }
    }
    assert(found_unordered && found_ordered, f"应有无序和有序两种列表")
    return Ok(0)
}

// ── 更多 CJK + 转义 + 管线深度测试 ──────────────────────────

@test
fn cjk_punct_comprehensive() {
    // 行首禁则:所有 CJK 闭合标点
    let line_start_forbidden = ["。", "，", "、", "；", "？", "！", "」", "』", "）", "】"]
    for c in line_start_forbidden {
        assert(cjk_is_line_start_forbidden(c), f"[{c}] 应为行首禁则")
    }
    // 行尾禁则:CJK 开启标点
    let line_end_forbidden = ["「", "『", "（", "【"]
    for c in line_end_forbidden {
        assert(cjk_is_line_end_forbidden(c), f"[{c}] 应为行尾禁则")
    }
    // 非标点字符
    assert(!cjk_is_line_start_forbidden("中"), "中 非禁则")
    assert(!cjk_is_line_start_forbidden("a"), "a 非禁则")
}

@test
fn escape_all_6_prefixes() -> Result<i32, String> {
    // 测试所有轻量标记转义
    assert(escape_scan("@**", 0) != None, "@** 转义")
    assert(escape_scan("@~~", 0) != None, "@~~ 转义")
    assert(escape_scan("@#", 0) != None, "@# 转义")
    assert(escape_scan("@_", 0) != None, "@_ 转义")
    assert(escape_scan("@-", 0) != None, "@- 转义")
    assert(escape_scan("@>", 0) != None, "@> 转义")
    assert(escape_scan("@`", 0) != None, "@` 转义")
    // 验证转义产物正确
    let r1 = escape_scan("@#", 0)
    match r1 {
        Some(h) { assert(h.text == "#", f"@# 应转义为 #") }
        None { assert(false, "@# 应转义") }
    }
    return Ok(0)
}

@test
fn pipeline_incremental_no_drift_after_edit() -> Result<i32, String> {
    // 多轮 pipeline_edit_heading 后语义不漂移
    let src = "# 标题\n正文\n## 子标题\n子内容\n"
    let p1 = pipeline_full(src)
    let p2 = pipeline_edit_heading(p1, 1, "修改后的标题")
    let p3 = pipeline_full(p2.source)

    // 标题数应一致
    let h1 = doc_count_kind(p1.state, "heading")
    let h3 = doc_count_kind(p3.state, "heading")
    assert(h1 == h3, f"标题数应一致: {h1} vs {h3}")

    // 渲染项数应一致
    assert(p1.render_items.len() == p3.render_items.len(), f"渲染项数应一致")
    return Ok(0)
}

@test
fn container_roundtrip_preserves_raw_content() -> Result<i32, String> {
    let src = "@[c rust]\nfn main() {\n    print(\"hello\");\n}\n@[/c]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    // Raw 内容应保留
    for node in state.nodes {
        if node.kind == "raw" {
            assert(node.raw_lines.len() == 3, f"应有 3 行代码,得到 {node.raw_lines.len()}")
            match node.raw_lang {
                Some(lang) { assert(lang == "rust", f"语言应为 rust") }
                None { assert(false, "应保留语言标注") }
            }
            return Ok(0)
        }
    }
    return Err("找不到 Raw 块")
}

