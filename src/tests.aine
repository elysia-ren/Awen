@test
fn heading_all_6_levels_classify() -> Result<i32, String> {
    // 6 级标题全部正确分类
    assert(classify("# H1") == LcHeading(1), "H1")
    assert(classify("## H2") == LcHeading(2), "H2")
    assert(classify("### H3") == LcHeading(3), "H3")
    assert(classify("#### H4") == LcHeading(4), "H4")
    assert(classify("##### H5") == LcHeading(5), "H5")
    assert(classify("###### H6") == LcHeading(6), "H6")
    // 7 个 # 不是标题
    assert(classify("####### H7") == LcText, "7 个 # 是文本")
    // 无空格不是标题
    assert(classify("#H1") == LcText, "#H1 是文本")
    return Ok(0)
}

@test
fn inline_bold_italic_crossing_fallback() -> Result<i32, String> {
