@test
fn registry_all_doc_level_commands() -> Result<i32, String> {
    // §11.1:8 个文档级命令全部可查找
    var cmds: Vec<ExplicitCommand> = []
    for name in ["page", "margin", "font", "size", "line-spacing", "first-line", "theme", "numbering"] {
        match lookup(name) {
            Some(c) { cmds = cmds.push(c) }
            None { return Err(f"文档级命令 {name} 未注册") }
        }
    }
    assert(cmds.len() == 8, f"应有 8 个文档级命令")
    return Ok(0)
}

