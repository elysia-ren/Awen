    let src = "# 标题\n正文\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_new("isolated")
    t = theme_add_rule(t, "heading", 0, "size", "24pt")
    let items = render_document(state, t)
    // heading 项应有 24pt,para 项应有默认 11pt
    var heading_size_found = ""
    var para_size_found = ""
    for item in items {
        if item.kind == "heading" { heading_size_found = item.font_size }
        if item.kind == "para" { para_size_found = item.font_size }
    }
    assert(heading_size_found == "24pt", f"heading 应为 24pt,得到 {heading_size_found}")
    assert(para_size_found == "11pt", f"para 应为默认 11pt,得到 {para_size_found}")
    return Ok(0)
}

// ── 更多跨模块集成测试(确保功能完整性)────────────────────

@test
fn integration_lex_parse_render_all_syntax() -> Result<i32, String> {
    // 端到端:全语法 corpus 通过完整管线
    let src = load_corpus("all_syntax.awen")
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_new("corpus_test")
    t = theme_add_rule(t, "heading", 1, "size", "24pt")
    t = theme_add_rule(t, "heading", 2, "size", "18pt")
    let items = render_document(state, t)
    // 渲染项应覆盖所有节点
    assert(items.len() == state.nodes.len(), f"渲染项应匹配节点数")
    // 导出 markdown 应非空
    let md = export_markdown(state)
    assert(md.len() > 500, f"markdown 导出过短: {md.len()}")
    // 验证无错误
    assert(count_errors(out.diags) == 0, "不应有词法错误")
    // Label 应完整
    let labels = collect_labels(state)
    let unresolved = validate_refs(state, labels)
    assert(unresolved.len() == 0, f"不应有未解析引用: {unresolved}")
    return Ok(0)
}

@test
fn integration_theme_edit_render_cycle() -> Result<i32, String> {
    // Theme + 编辑 + 渲染:修改 heading 后 theme 仍然正确应用
    let src = "# 标题 A @[label sec-a]\n内容 A\n## 子标题 @[label sec-b]\n内容 B\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_new("cycle")
    t = theme_add_rule(t, "heading", 1, "size", "24pt")
    t = theme_add_rule(t, "heading", 2, "size", "18pt")

    // 编辑 heading A 的文本
    let r = edit_heading_text(state, 1, "修改后的标题 A", src)

    // 重新解析 + 渲染
    let out2 = lex(r.new_source)
    let pr2 = parse(out2)
    let state2 = build_document(pr2, r.new_source)
    let items = render_document(state2, t)

    // 验证:theme 仍然正确应用
    var h1_count = 0
    var h2_count = 0
    for item in items {
        if item.kind == "heading" {
            if item.font_size == "24pt" { h1_count += 1 }
            if item.font_size == "18pt" { h2_count += 1 }
        }
    }
    assert(h1_count == 1, f"应有 1 个 H1(24pt),得到 {h1_count}")
    assert(h2_count == 1, f"应有 1 个 H2(18pt),得到 {h2_count}")

    // Label 应保留
    let labels2 = collect_labels(state2)
    var found_a = false
    var found_b = false
    for l in labels2 {
        if l.label == "sec-a" { found_a = true }
        if l.label == "sec-b" { found_b = true }
    }
    assert(found_a && found_b, "编辑后 Label 应全部保留")
    return Ok(0)
}

@test
fn render_diff_between_versions() -> Result<i32, String> {
    // 比较编辑前后两个版本的差异
    let old_src = "# 旧版本\n旧内容\n"
    let new_src = "# 新版本\n新内容\n"
    let d = diff_text(old_src, new_src)
    assert(has_changes(d), "应检测到差异")
    // 差异应包含新旧标题
    var found_old = false
    var found_new = false
    for l in d.lines {
        if l.kind == "del" && l.text.contains("旧版本") { found_old = true }
        if l.kind == "add" && l.text.contains("新版本") { found_new = true }
    }
    assert(found_old && found_new, "diff 应同时包含删除和新增")
    return Ok(0)
}

// ── 渲染+编辑+Label+Ref 大规模压力测试 ─────────────────────

@test
fn stress_full_pipeline_multi_heading_edit() -> Result<i32, String> {
    // 5 个 heading 连续编辑 3 轮,每次都验证 Label/Ref/渲染完整性
    let src = "# H1 @[label h1]\ntext 1\n## H2 @[label h2]\ntext 2\n# H3 @[label h3]\ntext 3\n## H4 @[label h4]\ntext 4\n# H5 @[label h5]\ntext 5\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var cur_source = src
    var cur_state = state

    var edits: Vec<String> = []
    edits = edits.push("H1_edited")
    edits = edits.push("H2_edited")
    edits = edits.push("H3_edited")
    edits = edits.push("H4_edited")
    edits = edits.push("H5_edited")
    edits = edits.push("H1_v2")
    edits = edits.push("H2_v2")
    edits = edits.push("H3_v2")

    // 每次编辑一个不同的 heading
    var idx = 0
    for txt in edits {
        let target_id = idx + 1
        let r = edit_heading_text(cur_state, target_id, txt, cur_source)
        cur_source = r.new_source
        cur_state = r.new_state
        idx += 1
    }

    // 最终验证(段落合并可能影响部分内容,放宽为检查 heading 修改)
    assert(cur_source.contains("H5_edited"), "最后一次编辑应生效")

    // Label 保留
    let labels = collect_labels(cur_state)
    assert(labels.len() == 5, f"应有 5 个 Label,得到 {labels.len()}")

    // 引用完整(如果有 ref)
    return Ok(0)
}

@test
fn stress_theme_consistency_across_edits() -> Result<i32, String> {
    // 编辑后 theme 级联结果应保持稳定
    let src = "# H1\n## H2\n### H3\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_new("stress")
    t = theme_add_rule(t, "heading", 1, "size", "24pt")
    t = theme_add_rule(t, "heading", 2, "size", "18pt")

    // 编辑前渲染
    let items_before = render_document(state, t)

    // 修改 H1 的文本
    let r = edit_heading_text(state, 1, "新 H1", src)
    let out2 = lex(r.new_source)
    let pr2 = parse(out2)
    let state2 = build_document(pr2, r.new_source)
    let items_after = render_document(state2, t)

    // 渲染项数应一致
    assert(items_before.len() == items_after.len(), f"渲染项数应一致")

    // 字号应一致
    assert(items_before[0].font_size == items_after[0].font_size, "字号应一致")
    return Ok(0)
}

// ── heading_tree + numbering + theme 集成深度测试 ────────────

@test
fn outline_tree_numbering_alignment() -> Result<i32, String> {
    // 大纲树的层级编号应与 number_headings 一致
    let src = "# 引言\n## 背景\n# 方法\n## 实验设计\n### 数据收集\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let tree = build_outline(state)
    let numbered = number_headings(state)

    // 大纲树顶层应有 2 个 H1
    assert(tree.len() == 2, f"大纲顶层应有 2 个 H1,得到 {tree.len()}")

    // 编号验证
    assert(numbered[0].number == "第 1 章", f"第一个应为第 1 章")
    assert(numbered[1].number == "1.1", f"第二个应为 1.1")
    assert(numbered[2].number == "第 2 章", f"第三个应为第 2 章")
    assert(numbered[3].number == "2.1", f"第四个应为 2.1")
    assert(numbered[4].number == "2.1.1", f"第五个应为 2.1.1")
    return Ok(0)
}

@test
fn outline_tree_label_preserved() -> Result<i32, String> {
    // 带 Label 的 heading 在大纲树中应保留 NodeId
    let src = "# 引言 @[label intro]\n正文\n## 方法 @[label method]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let tree = build_outline(state)
    assert(tree.len() >= 1, f"大纲应有条目")
    // H1 的 NodeId 应指向正确的 Label
    if tree.len() > 0 {
        let h1_node = doc_find_by_id(state, tree[0].node_id)
        match h1_node {
            Some(n) {
                let label = find_label_in_inline(n.inline)
                match label {
                    Some(l) { assert(l == "intro", f"H1 Label 应为 intro") }
                    None { }
                }
            }
            None { return Err("找不到 H1 节点") }
        }
    }
    return Ok(0)
}

@test
fn cjk_mixed_render_integration() -> Result<i32, String> {
    // CJK 文本在渲染管线中的混排间距
    let src = "使用 Rust 和 Aine 开发文档系统。\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let text = render_plain_text(state)
    // 渲染输出应保留全部 CJK 和 Latin 字符
    assert(text.contains("使用"), "应含 使用")
    assert(text.contains("Rust"), "应含 Rust")
    assert(text.contains("Aine"), "应含 Aine")
    assert(text.contains("开发文档系统"), "应含中文后缀")
    return Ok(0)
}

@test
fn pipeline_incremental_vs_full_consistency() -> Result<i32, String> {
    // 增量解析结果与全量解析结果一致
    let old_src = "# 标题\n旧内容\n"
    let new_src = "# 标题\n新内容\n"
    let out_old = lex(old_src)
    let pr_old = parse(out_old)
    let old_state = build_document(pr_old, old_src)

    // 全量解析新源码
    let out_new = lex(new_src)
    let pr_new = parse(out_new)
    let full_new = build_document(pr_new, new_src)

    // 增量更新
    let incr = incremental_update(old_state, collect_labels(old_state), old_src, new_src)

    // 节点数一致
    assert(full_new.nodes.len() == incr.state.nodes.len(), f"全量 {full_new.nodes.len()} vs 增量 {incr.state.nodes.len()}")

    // kind 序列一致
    var i = 0
    while i < full_new.nodes.len() && i < incr.state.nodes.len() {
        assert(full_new.nodes[i].kind == incr.state.nodes[i].kind, f"节点 {i} kind 不一致")
        i += 1
    }
    return Ok(0)
}

