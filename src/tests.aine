            assert(h.cu.attrs.len() == 1, f"应有 1 个属性")
            assert(h.cu.attrs[0].key == "depth", "属性 key 应为 depth")
            assert(arg_plain(h.cu.attrs[0].val) == "3", "属性 value 应为 3")
        }
        Err(e) { assert(false, f"应解析成功: {e.msg}") }
    }
    return Ok(0)
}

