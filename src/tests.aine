    let r = lw_scan_inline("**a _b** c_", 0, [])
    // 交叉时应产生诊断
    assert(r.diags.len() > 0, f"交叉应产生诊断,得到 {r.diags.len()}")
    // 纯文本应保持原样
    let plain = inline_plain(r.inline)
    assert(plain == "**a _b** c_", f"字面回退应保持原文: [{plain}]")
    return Ok(0)
}

