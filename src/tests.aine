@test
fn incr_label_across_edit_types() -> Result<i32, String> {
    // 多种编辑类型后 Label 均保留(§2.5)
    let src = "# A @[label sec-a]\n## B @[label sec-b]\n正文 @[ref sec-a]。\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let labels1 = collect_labels(state)
    assert(labels1.len() == 2, f"初始应有 2 个 Label,得到 {labels1.len()}")

    // 编辑 heading A 的文本(保留 label)
    let r = edit_heading_text(state, 1, "修改后的 A", src)
    let out2 = lex(r.new_source)
    let pr2 = parse(out2)
    let state2 = build_document(pr2, r.new_source)
    let labels2 = collect_labels(state2)

    // sec-b 的 Label 应不受影响
    var found_b = false
    for l in labels2 {
        if l.label == "sec-b" { found_b = true }
    }
    assert(found_b, f"sec-b Label 应保留")
    return Ok(0)
}

@test
fn incr_add_paragraph_preserves_headings() -> Result<i32, String> {
    // 添加新段落后,已有 heading 编号不变
    let src = "# 章 A\n## 节 A1\n# 章 B\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let numbered_before = number_headings(state)

    // 在末尾添加段落
    let new_src = src + "\n新增段落。\n"
    let out2 = lex(new_src)
    let pr2 = parse(out2)
    let state2 = build_document(pr2, new_src)
    let numbered_after = number_headings(state2)

    // 原有 heading 编号不变
    var i = 0
    while i < numbered_before.len() && i < numbered_after.len() {
        assert(numbered_before[i].number == numbered_after[i].number, f"编号 {i} 不一致")
        i += 1
    }
    return Ok(0)
}

