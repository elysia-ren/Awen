    return Ok(0)
}

// ── 全量 corpus pipeline 验证 ────────────────────────────────

@test
fn pipeline_full_corpus() -> Result<i32, String> {
    let src = load_corpus("all_syntax.awen")
    let p = pipeline_full(src)
    // 0 词法错误
    assert(count_errors(p.diags) == 0, "corpus 不应有词法错误")
    // 渲染项应覆盖大量节点
    assert(p.render_items.len() >= 20, f"渲染项不足: {p.render_items.len()}")
    // Label 应有多个
    assert(p.labels.len() >= 3, f"Label 不足: {p.labels.len()}")
    // 引用完整
    assert(p.unresolved_refs.len() == 0, f"有未解析引用: {p.unresolved_refs}")
    // 主题应有文档级设置
    assert(p.theme.rules.len() > 0, "Theme 应有规则")
    return Ok(0)
}

@test
fn pipeline_check_edge_cases() -> Result<i32, String> {
    let src = load_corpus("edge_cases.awen")
    let cr = pipeline_check(src)
    // edge_cases 包含预期错误:全角空格 + 未加引号多词值 = 2 个错误
    assert(cr.lex_errors == 2, f"edge_cases 应有 2 个词法错误,得到 {cr.lex_errors}")
    // 应有行首禁则/未闭合等警告
    assert(cr.lex_warnings > 0, f"应有未闭合标记等警告")
    return Ok(0)
}

@test
fn pipeline_incremental_edit_preserves_labels() -> Result<i32, String> {
    // 编辑 → Label 保留 → 再编辑 → Label 仍保留
    let src = "# A @[label sec-a]\ntext\n# B @[label sec-b]\ntext\n"
    let p1 = pipeline_full(src)
    assert(p1.labels.len() == 2, f"初始应有 2 个 Label,得到 {p1.labels.len()}")

    // 编辑第一个 heading
    let p2 = pipeline_edit_heading(p1, 1, "A modified")
    assert(p2.labels.len() == 2, f"编辑后 Label 应保留,得到 {p2.labels.len()}")

    // 编辑第二个 heading
    let p3 = pipeline_edit_heading(p2, 3, "B modified")
    assert(p3.labels.len() == 2, f"二次编辑后 Label 应保留,得到 {p3.labels.len()}")

    // 引用应完整
    assert(p3.unresolved_refs.len() == 0, "引用应完整")
    return Ok(0)
}

