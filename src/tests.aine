@test
fn pipeline_incremental_chain_consistency() -> Result<i32, String> {
    // 3 轮 pipeline_edit_heading 后,所有 heading 的文本应正确
    let src = "# First\n内容\n# Second\n内容\n# Third\n内容\n"
    let p1 = pipeline_full(src)
    let p2 = pipeline_edit_heading(p1, 1, "First Modified")
    let p3 = pipeline_edit_heading(p2, 3, "Second Modified")
    let p4 = pipeline_edit_heading(p3, 5, "Third Modified")

    // 验证最终状态
    assert(p4.source.contains("First Modified"), "First 应已修改")
    assert(p4.source.contains("Second Modified"), "Second 应已修改")
    assert(p4.source.contains("Third Modified"), "Third 应已修改")
    assert(p4.source.contains("内容"), "内容应保留")

    // Label 应保留(§2.5)
    assert(p4.unresolved_refs.len() == 0, "引用应完整")
    return Ok(0)
}

@test
fn render_theme_heading_body_separate() -> Result<i32, String> {
