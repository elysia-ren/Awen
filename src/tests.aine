// ── 编号 + 大纲树集成(§7.6 + heading_tree)────────────────

@test
fn numbering_with_outline_tree() -> Result<i32, String> {
    // 大纲树 + 编号系统协同:heading 层级 → 编号 → TOC
    let src = "# 引言\n## 背景\n## 方法\n# 实验\n## 结果\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let tree = build_outline(state)
    let numbered = number_headings(state)

    // 大纲树结构:2 个 H1,每个有子节点
    assert(tree.len() == 2, f"大纲应有 2 个顶层,得到 {tree.len()}")
    assert(tree[0].children.len() == 2, f"第一个应有 2 个子节")
    assert(tree[1].children.len() == 1, f"第二个应有 1 个子节")

    // 编号应正确
    assert(numbered[0].number == "第 1 章", f"第一个应为第 1 章")
    assert(numbered[1].number == "1.1", f"第二个应为 1.1")
    if numbered[2].number.len() == 0 { return Err(f"编号不应为空: {numbered[2].number}") }
    assert(numbered[3].number == "第 2 章", f"第四个应为第 2 章")
    assert(numbered[4].number == "2.1", f"第五个应为 2.1")

    // TOC 应与编号一致
    let entries = generate_toc(state, 0)
    assert(entries.len() == 5, f"TOC 应有 5 条,得到 {entries.len()}")
    assert(entries[0].number == "1", "TOC 编号应匹配")
    assert(entries[1].number == "1.1", "TOC 子编号应匹配")
    return Ok(0)
}

@test
fn render_heading_with_number() -> Result<i32, String> {
    // 渲染 heading 时应显示编号(如果 theme 配置了 numbering)
    let src = "# 引言\n## 背景\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let numbered = number_headings(state)
    // number_headings 返回编号列表
    assert(numbered[0].number == "第 1 章", "H1 编号")
    assert(numbered[1].number == "1.1", "H2 编号")
    return Ok(0)
}

@test
fn pipeline_check_clean_document() -> Result<i32, String> {
    let src = "# 标题 @[label test]\n正文内容。\n"
    let cr = pipeline_check(src)
    assert(cr.ok, f"干净文档应通过 check")
    assert(cr.lex_errors == 0, "无词法错误")
    return Ok(0)
}

@test
fn pipeline_check_detects_errors() -> Result<i32, String> {
    let src = "@[字体　微软雅黑]\n"
    let cr = pipeline_check(src)
    assert(!cr.ok, "U+3000 错误应被检测")
