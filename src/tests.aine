    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let html = export_html(state)
    assert(html.contains("<ul>") || html.contains("ul"), "无序列表应有 ul 标签")
    assert(html.contains("苹果") && html.contains("香蕉"), "列表内容应保留")
    return Ok(0)
}

