@test
fn render_theme_document_font_size_heading_independence() -> Result<i32, String> {
    // 文档级 font/size 应独立于 heading size 规则
    let src = "@[size 14pt]\n@[font \"Serif\"]\n正文\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_from_document(state)
    let body_size = resolve_style(t, "body", 0, "size", None)
    let body_font = resolve_style(t, "body", 0, "font", None)
    assert(body_size == "14pt", f"文档级 size 应为 14pt,得到 {body_size}")
    assert(body_font == "Serif", f"文档级 font 应为 Serif,得到 {body_font}")
    return Ok(0)
}

