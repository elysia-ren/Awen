    let out2 = lex(r.new_source)
    let pr2 = parse(out2)
    let state2 = build_document(pr2, r.new_source)
    let labels2 = collect_labels(state2)

    // H1 和 H3 的 Label 应保留
    var found_h1 = false
    var found_h3 = false
    for l in labels2 {
        if l.label == "h1" { found_h1 = true }
        if l.label == "h3" { found_h3 = true }
    }
    assert(found_h1 && found_h3, f"未编辑的 heading Label 应保留")
    return Ok(0)
}

