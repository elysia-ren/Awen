@test
fn render_theme_all_props_heading() -> Result<i32, String> {
    // heading 节点的多个属性级联
    var t = theme_new("heading_test")
    t = theme_add_rule(t, "heading", 0, "size", "20pt")
    t = theme_add_rule(t, "heading", 0, "font", "Serif")
    t = theme_add_rule(t, "heading", 0, "color", "#333")
    t = theme_add_rule(t, "heading", 0, "weight", "bold")
    // 各属性独立解析
    assert(resolve_style(t, "heading", 1, "size", None) == "20pt", "heading size")
    assert(resolve_style(t, "heading", 1, "font", None) == "Serif", "heading font")
    assert(resolve_style(t, "heading", 1, "color", None) == "#333", "heading color")
    assert(resolve_style(t, "heading", 1, "weight", None) == "bold", "heading weight")
    // body 属性不受影响
    assert(resolve_style(t, "body", 0, "size", None) == "11pt", "body size 独立")
    return Ok(0)
}

@test
fn cjk_ideograph_and_latin_classification() {
    // CJK 字符分类
    assert(cjk_is_ideograph_char("中"), "中 是 CJK")
    assert(cjk_is_ideograph_char("文"), "文 是 CJK")
    // Latin 字符分类
    assert(cjk_is_latin_char("a"), "a 是 Latin")
    assert(cjk_is_latin_char("Z"), "Z 是 Latin")
    assert(cjk_is_latin_char("5"), "5 是 Latin")
    // 非 Latin 非 CJK
    assert(!cjk_is_latin_char("中"), "中 非 Latin")
    assert(!cjk_is_latin_char("。"), "。 非 Latin")
}

// ── 更多显式命令解析深度测试 ────────────────────────────────

@test
fn explicit_comment_multiline_content() -> Result<i32, String> {
    // 块级注释:多行内容应逐字保留
    let src = "@[comment]\n第一行注释\n第二行 包含特殊字符 !@#$\n@[/comment]\n"
    let out = lex(src)
    var found_content = false
    for b in out.blocks {
        match b.block {
            RawLine(content) {
                if content.contains("特殊字符") { found_content = true }
            }
            _ { }
        }
    }
    assert(found_content, "多行注释内容应保留")
    return Ok(0)
}

@test
fn explicit_footnote_inline_in_paragraph() -> Result<i32, String> {
    // 行内脚注在段落中
    let src = "正文内容。@[footnote 这是脚注。]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    // 脚注应在段落行内节点中
    var found_footnote = false
    for node in state.nodes {
        if node.kind == "para" {
            for item in node.inline {
                match item {
                    Command(u) { if u.cmd == Footnote { found_footnote = true } }
                    _ { }
                }
            }
        }
    }
    assert(found_footnote, "应找到行内脚注")
    return Ok(0)
}

@test
fn explicit_toc_depth_attr() -> Result<i32, String> {
    let hp = parse_header("@[toc depth: 3]", 0)
    match hp {
