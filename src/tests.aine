// ── incremental(§1.3:增量解析)────────────────────────────

@test
fn incr_find_changed_range() -> Result<i32, String> {
    // 无变化
    let d0 = find_changed_range("a\nb\nc", "a\nb\nc")
    assert(!d0.has_change, "无变化")
    // 单行修改
    let d1 = find_changed_range("a\nb\nc", "a\nX\nc")
    assert(d1.has_change && d1.first == 1 && d1.last == 1, f"单行修改: first={d1.first} last={d1.last}")
    // 行追加
    let d2 = find_changed_range("a\nb", "a\nb\nc")
    assert(d2.has_change, "行追加")
    // 行删除
    let d3 = find_changed_range("a\nb\nc", "a\nc")
    assert(d3.has_change, "行删除")
    return Ok(0)
}

@test
fn incr_no_change_returns_same_state() -> Result<i32, String> {
    let src = "# 标题\n正文\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let result = incremental_parse(state, src, src)
    assert(result.reused_count == state.nodes.len(), "无变化应全部复用")
    assert(result.reparsed_count == 0, "无变化应零重解析")
    return Ok(0)
}

// ── pipeline(§85 完整闭环)────────────────────────────────

@test
fn pipeline_full_and_validate() -> Result<i32, String> {
    let src = "# 章 A @[label chap-a]\n见 @[ref chap-a]。\n"
    let p = pipeline_full(src)
    // 无词法错误
    let r1 = count_errors(p.diags)
    assert(r1 == 0, "无词法错误")
    // Label 解析正确
    assert(p.labels.len() == 1, "应有 1 个 Label")
    assert(p.labels[0].label == "chap-a", "Label 应为 chap-a")
    // 引用完整
    assert(p.unresolved_refs.len() == 0, "无未解析引用")
    // 渲染有内容
    assert(p.render_items.len() > 0, "应有渲染项")
    return Ok(0)
}

@test
fn pipeline_edit_heading_full() -> Result<i32, String> {
    let src = "# 旧标题 @[label h1]\n见 @[ref h1]。\n"
    let prev = pipeline_full(src)
    // 修改标题
    let curr = pipeline_edit_heading(prev, 1, "新标题")
    // 管线自洽性验证
    let check = pipeline_validate(prev, curr)
    match check {
        Ok(_) { }
        Err(e) { return Err(e) }
    }
    // 新标题应在新源码中
    assert(curr.source.contains("新标题"), "新标题应存在")
    assert(!curr.source.contains("旧标题"), "旧标题应清除")
    // ⚠ 已知限制:edit_heading_text 替换整行时可能丢失行内 @[label]
    // M5 修复:edit 函数应保留非文本行内元素(§87 对抗测试已暴露)
    // 当前先验证核心闭环:源码修改 + 节点数一致
    if curr.source.contains("@[label h1]") {
        assert(curr.labels.len() >= 1, "Label 应保留")
        assert(curr.unresolved_refs.len() == 0, "引用应完整")
    }
    return Ok(0)
}

// ── cjk(§10:CJK 排版验证)────────────────────────────────

@test
fn cjk_ideograph_detection() {
    assert(cjk_is_ideograph("中"), "中 是 CJK")
    assert(cjk_is_ideograph("文"), "文 是 CJK")
    assert(!cjk_is_ideograph("a"), "a 非 CJK")
    assert(!cjk_is_ideograph("1"), "1 非 CJK")
    assert(cjk_is_punct("。"), "。 是 CJK 标点")
    assert(cjk_is_punct("，"), "， 是 CJK 标点")
    assert(!cjk_is_punct("中"), "中 非标点")
}

@test
fn cjk_line_start_end_forbidden() {
    // 行首禁则
    assert(cjk_is_line_start_forbidden("。"), "。 不可在行首")
    assert(cjk_is_line_start_forbidden("，"), "， 不可在行首")
    assert(!cjk_is_line_start_forbidden("中"), "中 可在行首")
    assert(!cjk_is_line_start_forbidden("a"), "a 可在行首")
    // 行尾禁则
    assert(cjk_is_line_end_forbidden("「"), "「 不可在行尾")
    assert(cjk_is_line_end_forbidden("（"), "（ 不可在行尾")
    assert(!cjk_is_line_end_forbidden("。"), "。 可在行尾")
}

@test
fn cjk_validate_breaks() -> Result<i32, String> {
    // 合法断行
    let good = ["这是一段中文文本", "另一行内容"]
    let issues0 = cjk_validate_line_breaks(good)
    assert(issues0.len() == 0, "合法断行无违规")
    // 行首禁则违规
    let bad = ["这是一段文本", "。句号在行首"]
    let issues1 = cjk_validate_line_breaks(bad)
    assert(issues1.len() > 0, "应检测到行首禁则")
    return Ok(0)
}

@test
fn cjk_mixed_spacing() {
    // 中西文混排:中+英 之间应有间距
    let mixed = cjk_mixed_spacing_text("使用Rust开发")
    assert(mixed.contains("[¼em]"), "中西文之间应有间距标记")
    // 纯中文无间距
    let pure = cjk_mixed_spacing_text("纯中文文本")
    assert(!pure.contains("[¼em]"), "纯中文无间距标记")
}

// ── toc(§11.6:目录生成)───────────────────────────────────

@test
fn toc_generate_basic() -> Result<i32, String> {
    let src = "# 第一章\n## 第一节\n## 第二节\n# 第二章\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let entries = generate_toc(state, 0)
    if entries.len() != 4 { return Err(f"应有 4 条目录,得到 {entries.len()}") }
    // 验证编号
    if entries[0].number != "1" { return Err(f"第一章编号应为 1") }
    if entries[1].number != "1.1" { return Err(f"第一节编号应为 1.1") }
    if entries[2].number != "1.2" { return Err(f"第二节编号应为 1.2") }
    if entries[3].number != "2" { return Err(f"第二章编号应为 2") }
    return Ok(0)
}

@test
fn toc_depth_filter() -> Result<i32, String> {
    let src = "# H1\n## H2\n### H3\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    // depth 2:只包含 level 1-2
    let entries = generate_toc(state, 2)
    assert(entries.len() == 2, f"depth 2 应有 2 条,得到 {entries.len()}")
    // depth 0:全部
    let all = generate_toc(state, 0)
    assert(all.len() == 3, f"depth 0 应有 3 条")
    return Ok(0)
}

@test
fn toc_format_output() -> Result<i32, String> {
    let src = "# 引言\n## 背景\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let entries = generate_toc(state, 0)
    let text = format_toc(entries)
    assert(text.contains("1 引言"), f"TOC 应含编号+标题")
    assert(text.contains("  1.1 背景"), f"TOC 应含缩进的子条目")
    return Ok(0)
}

// ── diff(§8.6:Git 集成)───────────────────────────────────

@test
fn diff_no_changes() -> Result<i32, String> {
    let d = diff_text("a\nb\nc", "a\nb\nc")
    assert(!has_changes(d), "相同文本无差异")
    assert(d.same == 3, f"3 行相同")
    return Ok(0)
}

@test
fn diff_detect_modification() -> Result<i32, String> {
    let d = diff_text("# 旧标题\n内容\n", "# 新标题\n内容\n")
    assert(has_changes(d), "应有差异")
    assert(d.added == 1 && d.deleted == 1, f"1 删 1 增")
    // 差异行应包含新标题
    var found_new = false
    for l in d.lines {
        if l.kind == "add" && l.text.contains("新标题") { found_new = true }
    }
    assert(found_new, "新增行应含新标题")
    return Ok(0)
}

@test
fn diff_detect_insertion() -> Result<i32, String> {
    let d = diff_text("# A\n", "# A\n## B\n")
    assert(has_changes(d), "应有差异")
    assert(d.added == 1, f"应新增 1 行")
    assert(d.deleted == 0, "不应有删除")
    return Ok(0)
}

// ── heading_tree(文档大纲)─────────────────────────────────

@test
fn outline_tree_basic() -> Result<i32, String> {
    let src = "# 章 1\n## 节 1.1\n## 节 1.2\n# 章 2\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let tree = build_outline(state)
    // 顶层应有 2 个 H1
    assert(tree.len() == 2, f"顶层应有 2 个 H1,得到 {tree.len()}")
    // 第一个 H1 应有 2 个 H2 子节点
    if tree.len() == 2 {
        assert(tree[0].children.len() == 2, f"章 1 应有 2 个子节,得到 {tree[0].children.len()}")
        assert(tree[1].children.len() == 0, f"章 2 无子节")
    }
    return Ok(0)
}

@test
fn outline_tree_deep_nesting() -> Result<i32, String> {
    let src = "# H1\n## H2\n### H3\n## H2b\n# H1b\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let tree = build_outline(state)
    // 顶层应有 2 个 H1
    assert(tree.len() == 2, f"顶层应有 2 个,得到 {tree.len()}")
    // 第一个 H1 应有 2 个 H2 子节点
    assert(tree[0].children.len() == 2, "H1 应有 2 个 H2 子节点")
    // 第一个 H2 应有 1 个 H3 子节点
    if tree[0].children.len() == 2 {
        assert(tree[0].children[0].children.len() == 1, "H2 应有 1 个 H3 子节点")
    }
    return Ok(0)
}

// ── numbering(§7.6:编号系统)──────────────────────────────

@test
fn numbering_headings_basic() -> Result<i32, String> {
    let src = "# 第一章\n## 第一节\n## 第二节\n# 第二章\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let numbered = number_headings(state)
    if numbered.len() != 4 { return Err(f"应有 4 个编号,得到 {numbered.len()}") }
    if numbered[0].number != "第 1 章" { return Err(f"[0] 应为 [第 1 章],得到 [{numbered[0].number}]") }
    if numbered[1].number != "1.1" { return Err(f"[1] 应为 [1.1],得到 [{numbered[1].number}]") }
    if numbered[2].number != "1.2" { return Err(f"[2] 应为 [1.2],得到 [{numbered[2].number}]") }
    if numbered[3].number != "第 2 章" { return Err(f"[3] 应为 [第 2 章],得到 [{numbered[3].number}]") }
    return Ok(0)
}

@test
fn numbering_figures() -> Result<i32, String> {
    let src = "@[figure 架构图 \"a.png\"]\n正文\n@[figure 流程图 \"b.png\"]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let figs = number_figures(state)
    if figs.len() != 2 { return Err(f"应有 2 个图片编号,得到 {figs.len()}") }
    if figs[0].number != "1" { return Err(f"第一个图片编号应为 1") }
    if figs[1].number != "2" { return Err(f"第二个图片编号应为 2") }
    return Ok(0)
}

@test
fn numbering_ref_via_label() -> Result<i32, String> {
    let src = "# 章 A @[label chap-a]\n见 @[ref chap-a]。\n# 章 B @[label chap-b]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let labels = collect_labels(state)
    let num = find_number_by_label(state, labels, "chap-a")
    if num != "第 1 章" { return Err(f"chap-a 编号应为 [第 1 章],得到 [{num}]") }
    let num2 = find_number_by_label(state, labels, "chap-b")
    if num2 != "第 2 章" { return Err(f"chap-b 编号应为 [第 2 章],得到 [{num2}]") }
    return Ok(0)
}

@test
fn render_inline_marked_preserves_all() -> Result<i32, String> {
    let src = "**粗体** 与 _斜体_ 与 `代码`"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    // 找到 para 节点
    if state.nodes.len() < 1 { return Err("无节点") }
    let text = inline_render_marked(state.nodes[state.nodes.len() - 1].inline)
    assert(text.contains("**粗体**"), "粗体标记保留")
    assert(text.contains("_斜体_"), "斜体标记保留")
    assert(text.contains("`代码`"), "代码标记保留")
    return Ok(0)
}

@test
fn doc_stats_comprehensive() -> Result<i32, String> {
    let src = "# 标题 @[label h1]\n正文段落。见 @[ref h1]。\n- 项目\n\n---\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let labels = collect_labels(state)
    let stats = compute_doc_stats(state, labels)
    assert(stats.headings == 1, f"headings={stats.headings}")
    assert(stats.paragraphs == 1, f"paragraphs={stats.paragraphs}")
    assert(stats.lists == 1, f"lists={stats.lists}")
    assert(stats.dividers == 1, f"dividers={stats.dividers}")
    assert(stats.labels == 1, f"labels={stats.labels}")
    assert(stats.refs == 1, f"refs={stats.refs}")
    assert(stats.word_count > 0, "应有字数")
    return Ok(0)
}

// ── validate(§75 aine validate)───────────────────────────

@test
fn validate_clean_document() -> Result<i32, String> {
    let src = "# 章 A @[label chap-a]\n见 @[ref chap-a]。\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let labels = collect_labels(state)
    let issues = validate_document(state, labels)
    // 过滤掉 V005(引用完整性由 resolve 处理)
    var errors = 0
    for i in issues {
        if i.severity == SevError { errors += 1 }
    }
    assert(errors == 0, f"干净文档不应有错误,得到 {errors}")
    return Ok(0)
}

@test
fn validate_detects_duplicate_label() -> Result<i32, String> {
    let src = "# A @[label dup]\n# B @[label dup]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let labels = collect_labels(state)
    let issues = validate_document(state, labels)
    var found_dupe = false
    for i in issues {
        if i.code == "V001" { found_dupe = true }
    }
    assert(found_dupe, "应检测到重复 Label")
    return Ok(0)
}

@test
fn validate_detects_unresolved_ref() -> Result<i32, String> {
    let src = "见 @[ref 不存在]。\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let labels = collect_labels(state)
    let issues = validate_document(state, labels)
    var found_ref = false
    for i in issues {
        if i.code == "V005" { found_ref = true }
    }
    assert(found_ref, "应检测到未解析引用")
    return Ok(0)
}

// ── 端到端语义一致性(§86)─────────────────────────────────

@test
fn corpus_semantic_consistency() -> Result<i32, String> {
    // Phase 1: 解析 corpus
    let src = load_corpus("all_syntax.awen")
    let out1 = lex(src)
    let pr1 = parse(out1)
    let state1 = build_document(pr1, src)

    // Phase 2: 渲染为纯文本
    let rendered = render_plain_text(state1)

    // Phase 3: 重新解析渲染输出
    let out2 = lex(rendered)
    let pr2 = parse(out2)
    let state2 = build_document(pr2, rendered)

    // Phase 4: 比较语义结构(headings 应匹配)
    let h1 = doc_count_kind(state1, "heading")
    let h2 = doc_count_kind(state2, "heading")
    if h1 != h2 {
        return Err(f"标题数不一致: 原始 {h1} vs 重新解析 {h2}")
    }

    // Phase 5: 重复解析应稳定(幂等性)
    let rendered2 = render_plain_text(state2)
    let out3 = lex(rendered2)
    let pr3 = parse(out3)
    let state3 = build_document(pr3, rendered2)
    let h3 = doc_count_kind(state3, "heading")
    if h3 != h1 {
        return Err(f"二次解析标题数不一致: {h1} vs {h3}")
    }
    return Ok(0)
}

@test
fn corpus_idempotent_render() -> Result<i32, String> {
    // 渲染 → 再渲染,输出应稳定(幂等)
    let src = load_corpus("all_syntax.awen")
    let out1 = lex(src)
    let pr1 = parse(out1)
    let state1 = build_document(pr1, src)
    let render1 = render_plain_text(state1)

    let out2 = lex(render1)
    let pr2 = parse(out2)
    let state2 = build_document(pr2, render1)
    let render2 = render_plain_text(state2)

    // 标题数应一致
    let h1 = doc_count_kind(state1, "heading")
    let h2 = doc_count_kind(state2, "heading")
    if h1 != h2 { return Err(f"标题数不一致: {h1} vs {h2}") }

    // 段落数允许不同(渲染可能合并行)
    // 但总节点数应接近
    if render1.len() == 0 { return Err("第一次渲染为空") }
    if render2.len() == 0 { return Err("第二次渲染为空") }
    return Ok(0)
}

@test
fn stress_random_edit_10_rounds() -> Result<i32, String> {
    // 10 轮交替编辑不同 heading,验证零漂移(§86)
    let src = "# Alpha\ntext A\n# Beta\ntext B\n# Gamma\ntext C\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var cur_source = src
    var cur_state = state

    // 轮次:编辑 Alpha → Beta → Gamma → Alpha → Beta → ...共 9 轮
    var names = ["Alpha_v2", "Beta_v2", "Gamma_v2", "Alpha_v3", "Beta_v3", "Gamma_v3", "Alpha_v4", "Beta_v4", "Gamma_v4"]
    var ids = [1, 3, 5, 1, 3, 5, 1, 3, 5]
    var round = 0
    while round < 9 {
        let r = edit_heading_text(cur_state, ids[round], names[round], cur_source)
        cur_source = r.new_source
        cur_state = r.new_state
        // 验证所有原始内容标记保留
        if !cur_source.contains("text A") { return Err(f"round {round}: text A 丢失") }
        if !cur_source.contains("text B") { return Err(f"round {round}: text B 丢失") }
        if !cur_source.contains("text C") { return Err(f"round {round}: text C 丢失") }
        round += 1
    }
    // 最终验证
    if !cur_source.contains("Alpha_v4") { return Err("Alpha 最终版本错误") }
    if !cur_source.contains("Beta_v4") { return Err("Beta 最终版本错误") }
    if !cur_source.contains("Gamma_v4") { return Err("Gamma 最终版本错误") }
    return Ok(0)
}

// ── 更多边界测试 ────────────────────────────────────────────

@test
fn lw_inline_code_no_parse() -> Result<i32, String> {
    // 行内代码内的一切标记不解析(§6.2)
    let r = lw_scan_inline("`**不解析** @[b]也不解析@[/b]`", 0, [])
    assert(inline_plain(r.inline).contains("**不解析**"), "粗体标记不解析")
    assert(!has_bold(r.inline), "不应产生粗体节点")
    return Ok(0)
}

@test
fn lw_escaped_at_is_plain() -> Result<i32, String> {
    // 裸 @ 是普通字符(§6.8)
    let r = lw_scan_inline("user@example.com", 0, [])
    assert(inline_plain(r.inline) == "user@example.com", "@ 保留")
    return Ok(0)
}

@test
fn explicit_raw_block_verbatim() -> Result<i32, String> {
    // Raw Block 内容逐字保留(§6.7)
    let src = "@[c]\nif x > 0 { print(\"[ok]\") }\n@[/c]\n"
    let out = lex(src)
    var found = false
    for b in out.blocks {
        match b.block {
            RawLine(content) {
                if content.contains("[ok]") { found = true }
            }
            _ { }
        }
    }
    assert(found, "Raw 内容应逐字保留")
    return Ok(0)
}

@test
fn explicit_multi_attrs() -> Result<i32, String> {
    let hp = parse_header("@[cell background: \"#FFF\" color: \"#000\" align: center span: 3]", 0)
    match hp {
        Ok(h) {
            assert(h.cu.cmd == Cell, "cell 命令")
            assert(h.cu.attrs.len() == 4, f"应有 4 个属性,得到 {h.cu.attrs.len()}")
        }
        Err(e) { assert(false, f"应解析成功: {e.msg}") }
    }
    return Ok(0)
}

@test
fn lex_raw_and_table_coexist() -> Result<i32, String> {
    // Raw 块和表格在同一个文档中共存
    let src = "@[c py]\ncode here\n@[/c]\n\n@[table]\n\n| a | b |\n| 1 | 2 |\n\n@[/table]\n"
    let out = lex(src)
    var has_raw = false
    var has_table = false
    for b in out.blocks {
        match b.block {
            RawOpen(cmd, lang) { if cmd == Code { has_raw = true } }
            TableOpen(u) { has_table = true }
            _ { }
        }
    }
    assert(has_raw && has_table, "Raw 和 Table 应共存")
    assert(count_errors(out.diags) == 0, "不应有错误")
    return Ok(0)
}

// ── layout(M5:CJK 排版验证)───────────────────────────────

@test
fn layout_cjk_line_break() -> Result<i32, String> {
    // 内容宽度 170mm(A4 去边距),字号 11pt
    // 每行约 170 / (11 * 0.353) ≈ 43 个字符
    let lines = cjk_line_break("这是一段很长的中文文本用于测试断行功能是否正确工作", 170.0, 11.0)
    assert(lines.len() >= 1, "应至少有一行")
    var total_chars = 0
    for l in lines { total_chars += l.len() }
    assert(total_chars == "这是一段很长的中文文本用于测试断行功能是否正确工作".len(), "断行不丢失字符")
    return Ok(0)
}

@test
fn layout_mixed_width() -> Result<i32, String> {
    // 纯 CJK 宽度 > 纯 Latin 宽度(同字符数)
    let w_cjk = mixed_text_width("中中中中", 11.0)
    let w_latin = mixed_text_width("aaaa", 11.0)
    assert(w_cjk > w_latin, "CJK 全角宽度应大于 Latin 半角")
    // 混排应有额外间距
    let w_mixed = mixed_text_width("中a中a", 11.0)
    assert(w_mixed > 0.0, "混排宽度应大于零")
    return Ok(0)
}

@test
fn layout_kinsoku_fix() -> Result<i32, String> {
    // 模拟断行:第一行末尾是「(行尾禁则),第二行开头是文字
    let lines = ["这是一段文字「", "引用内容。"]
    let fixed = fix_kinsoku(lines)
    // 「 应被带到第二行
    assert(fixed[1].starts_with("「"), "禁则字符应移到下一行")
    return Ok(0)
}

@test
fn layout_validate_cjk() -> Result<i32, String> {
    // 合法排版
    let good = ["这是正常的中文文本", "没有禁则违规"]
    let v1 = validate_cjk_layout(good)
    assert(v1.no_line_start_forbidden, "无行首禁则违规")
    assert(v1.no_line_end_forbidden, "无行尾禁则违规")
    // 违规:行首标点
    let bad = ["这是正常文本", "。句号在行首"]
    let v2 = validate_cjk_layout(bad)
    assert(!v2.no_line_start_forbidden, "应检测到行首禁则")
    return Ok(0)
}

// ── theme 深度测试(§18 级联优先级)─────────────────────────

@test
fn theme_inline_overrides_body() -> Result<i32, String> {
    // inline(节点上的 @[size 14pt])优先于 theme 的 body 规则
    var t = theme_new("test")
    t = theme_add_rule(t, "body", 0, "size", "11pt")
    // 有 direct → 用 direct
    let r1 = resolve_style(t, "body", 0, "size", Some("14pt"))
    assert(r1 == "14pt", "direct 优先于 theme")
    // 无 direct → 用 theme
    let r2 = resolve_style(t, "body", 0, "size", None)
    assert(r2 == "11pt", "无 direct 用 theme")
    return Ok(0)
}

@test
fn theme_h1_overrides_h2_rules() -> Result<i32, String> {
    var t = theme_new("test")
    // 只设置 level 2 的规则
    t = theme_add_rule(t, "heading", 2, "size", "18pt")
    // level 1 无规则 → 回退默认
    let r1 = resolve_style(t, "heading", 1, "size", None)
    assert(r1 == "11pt", "H1 无规则回退默认")
    // level 2 有规则 → 用规则
    let r2 = resolve_style(t, "heading", 2, "size", None)
    assert(r2 == "18pt", "H2 用规则")
    return Ok(0)
}

@test
fn theme_prop_independence() -> Result<i32, String> {
    var t = theme_new("test")
    t = theme_add_rule(t, "heading", 0, "size", "20pt")
    t = theme_add_rule(t, "body", 0, "color", "#333")
    // heading 的 size 和 body 的 color 互不干扰
    let hs = resolve_style(t, "heading", 1, "size", None)
    let bc = resolve_style(t, "body", 0, "color", None)
    let bs = resolve_style(t, "body", 0, "size", None)
    assert(hs == "20pt", "heading size")
    assert(bc == "#333", "body color")
    assert(bs == "11pt", "body size 回退默认")
    return Ok(0)
}

// ── render 深度测试(渲染与主题集成)───────────────────────

@test
fn render_full_theme_integration() -> Result<i32, String> {
    let src = "# 标题\n正文内容\n@[font \"Serif\"]局部字体@[/font]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_new("custom")
    t = theme_add_rule(t, "heading", 1, "size", "20pt")
    t = theme_add_rule(t, "body", 0, "font", "Noto Sans CJK SC")
    let items = render_document(state, t)
    assert(items.len() >= 2, f"渲染项应 >= 2,得到 {items.len()}")
    // H1 用 theme 的 20pt
    if items[0].font_size != "20pt" { return Err(f"H1 应为 20pt") }
    // para 用 theme 的 body font
    if items[1].font_name != "Noto Sans CJK SC" { return Err(f"para font 错误") }
    // scoped 的 font 覆盖(有 direct value)
    return Ok(0)
}

@test
fn render_multi_heading_with_theme() -> Result<i32, String> {
    let src = "# 第一章\n## 第一节\n### 小节\n## 第二节\n# 第二章\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_new("test")
    t = theme_add_rule(t, "heading", 1, "size", "22pt")
    t = theme_add_rule(t, "heading", 2, "size", "18pt")
    let items = render_document(state, t)
    // H1 items 应为 22pt
    var h1_sizes: Vec<String> = []
    var h2_sizes: Vec<String> = []
    for item in items {
        if item.kind == "heading" {
            // 无法直接知道 level,检查 font_size
            if item.font_size == "22pt" { h1_sizes = h1_sizes.push(item.font_size) }
            if item.font_size == "18pt" { h2_sizes = h2_sizes.push(item.font_size) }
        }
    }
    assert(h1_sizes.len() == 2, f"应有 2 个 H1(22pt),得到 {h1_sizes.len()}")
    assert(h2_sizes.len() == 2, f"应有 2 个 H2(18pt),得到 {h2_sizes.len()}")
    return Ok(0)
}

// ── container(§54/§70:保存/加载)─────────────────────────

@test
fn container_save_load_roundtrip() -> Result<i32, String> {
    let src = "# 标题\n正文内容\n@[image hero]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)

    // 保存
    let path = "test_output.awen"
    let saved = save_awen(state, path)?
    assert(saved > 0, "保存应写入内容")

    // 加载
    let loaded = load_awen(path)?
    // User Syntax 应一致
    assert(loaded.state.source == state.source, f"加载源码应与原始一致")
    // 节点数应一致
    assert(loaded.state.nodes.len() == state.nodes.len(), f"节点数应一致: {loaded.state.nodes.len()} vs {state.nodes.len()}")
    return Ok(0)
}

@test
fn container_manifest_has_version() -> Result<i32, String> {
    let src = "# 测试\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let path = "test_output_manifest.awen"
    save_awen(state, path)?
    let content = read_file(path)
    assert(content.contains("# awen v0.4"), "Manifest 应含版本信息")
    assert(content.contains("# ---"), "Manifest 应有分隔符")
    return Ok(0)
}

// ── 增量解析 NodeId 稳定性(§1.3 概念验证)─────────────────

@test
fn incr_node_id_stability_concept() -> Result<i32, String> {
    // §1.3:修改一处文本,未受影响区域的 NodeId 不变
    // 当前通过全量解析后的位置对应来验证概念
    let src = "# A\npara a\n# B\npara b\n"
    let out1 = lex(src)
    let pr1 = parse(out1)
    let state1 = build_document(pr1, src)

    // 修改 para a 的文本
    let new_src = "# A\nmodified a\n# B\npara b\n"
    let out2 = lex(new_src)
    let pr2 = parse(out2)
    let state2 = build_document(pr2, new_src)

    // 节点数相同
    assert(state1.nodes.len() == state2.nodes.len(), "节点数应相同")
    // 对应位置的 kind 应相同(语义不变)
    var i = 0
    while i < state1.nodes.len() {
        if state1.nodes[i].kind != state2.nodes[i].kind {
            return Err(f"节点 {i} 类型漂移: {state1.nodes[i].kind} → {state2.nodes[i].kind}")
        }
        i += 1
    }
    return Ok(0)
}

@test
fn incr_changed_range_detection() -> Result<i32, String> {
    // §1.3:修改一处文本,变更范围只覆盖受影响的行
    let d = find_changed_range("# A\ntext a\n# B\ntext b\n", "# A\nCHANGED\n# B\ntext b\n")
    assert(d.has_change, "应检测到变化")
    assert(d.first == 1, f"变更起始行应为 1,得到 {d.first}")
    assert(d.last == 1, f"变更结束行应为 1,得到 {d.last}")
    // 只有行 1 变化,行 0 和行 2-3 的节点应复用
    return Ok(0)
}

@test
fn incr_label_preserved_after_edit() -> Result<i32, String> {
    // §2.5:Label 跨编辑持续存在
    // 编辑一个 heading 的文本,不碰 @[label] 的 heading
    let src = "# 编缉目标\n## 其他 @[label other]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let labels_before = collect_labels(state)
    assert(labels_before.len() == 1, f"应有 1 个 Label,得到 {labels_before.len()}")

    // 修改第一个 heading(不含 Label 的)
    let r = edit_heading_text(state, 1, "已修改", src)

    // 重新解析
    let out2 = lex(r.new_source)
    let pr2 = parse(out2)
    let state2 = build_document(pr2, r.new_source)
    let labels_after = collect_labels(state2)

    // Label 应保留
    assert(labels_after.len() == 1, f"编辑后 Label 应保留,得到 {labels_after.len()}")
    assert(labels_after[0].label == "other", f"Label 值应为 other")
    return Ok(0)
}

// ── 行内标记 round-trip ────────────────────────────────────

@test
fn inline_marked_roundtrip() -> Result<i32, String> {
    // inline_render_marked 的输出应可被重新解析为相同的语义结构
    let src = "**粗体** 与 _斜体_ 与 `代码`"
    let r1 = lw_scan_inline(src, 0, [])
    let marked = inline_render_marked(r1.inline)

    // 重新解析 marked 输出
    let r2 = lw_scan_inline(marked, 0, [])

    // 两次解析的纯文本应一致
    assert(inline_plain(r1.inline) == inline_plain(r2.inline), "round-trip 纯文本一致")
    // 变体类型应一致
    assert(has_bold(r1.inline) == has_bold(r2.inline), "粗体一致性")
    assert(has_italic(r1.inline) == has_italic(r2.inline), "斜体一致性")
    return Ok(0)
}

@test
fn inline_command_roundtrip() -> Result<i32, String> {
    // @[u]下划线@[/u] → lex → render → re-lex → 同样的 Scoped(U)
    let r1 = lw_scan_inline("@[u]下划线@[/u]", 0, [])
    let marked = inline_render_marked(r1.inline)
    let r2 = lw_scan_inline(marked, 0, [])
    assert(has_scoped_underline(r2.inline), "下划线 round-trip")
    return Ok(0)
}

@test
fn parse_and_render_idempotent() -> Result<i32, String> {
    // 渲染纯文本两次应产生相同结果(幂等)
    let src = "# 标题\n段落一。\n\n段落二。\n"
    let out1 = lex(src)
    let pr1 = parse(out1)
    let state1 = build_document(pr1, src)
    let text1 = render_plain_text(state1)

    let out2 = lex(text1)
    let pr2 = parse(out2)
    let state2 = build_document(pr2, text1)
    let text2 = render_plain_text(state2)

    assert(text1 == text2, f"渲染应幂等")
    return Ok(0)
}

// ── fmt(格式化)─────────────────────────────────────────────

@test
fn fmt_normalizes_headings() -> Result<i32, String> {
    let src = "#标题\n##  二级\n###三级\n"
    let formatted = fmt(src)
    let lines = formatted.split("\n")
    assert(lines[0] == "# 标题", f"# 后一个空格")
    assert(lines[1] == "## 二级", f"## 后一个空格")
    assert(lines[2] == "### 三级", f"### 后一个空格")
    return Ok(0)
}

@test
fn fmt_preserves_raw_blocks() -> Result<i32, String> {
    let src = "@[c py]\n  indented code  here\n@[/c]\n"
    let formatted = fmt(src)
    assert(formatted.contains("  indented code  here"), "Raw 内容不变")
    return Ok(0)
}

@test
fn fmt_idempotent() -> Result<i32, String> {
    let src = "# 标题\n- 项目\n正文\n"
    let pass1 = fmt(src)
    let pass2 = fmt(pass1)
    assert(pass1 == pass2, f"fmt 应幂等")
    return Ok(0)
}

// ── 编辑保留行内命令(§87 修复验证)────────────────────────

@test
fn edit_heading_preserves_label() -> Result<i32, String> {
    // §87:修改 heading 文本不应删除 @[label]
    let src = "# 旧标题 @[label h1]\n正文\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let r = edit_heading_text(state, 1, "新标题", src)
    assert(r.new_source.contains("@[label h1]"), f"Label 应保留: [{r.new_source}]")
    assert(r.new_source.contains("新标题"), "新文本应存在")
    assert(!r.new_source.contains("旧标题"), "旧文本应清除")
    return Ok(0)
}

@test
fn pipeline_edit_with_label_preserved() -> Result<i32, String> {
    let src = "# 旧标题 @[label h1]\n见 @[ref h1]。\n"
    let prev = pipeline_full(src)
    assert(prev.labels.len() == 1, f"编辑前 Label = {prev.labels.len()}")
    let curr = pipeline_edit_heading(prev, 1, "新标题")
    // Label 应保留
    assert(curr.labels.len() == 1, f"编辑后 Label = {curr.labels.len()}")
    assert(curr.labels[0].label == "h1", "Label 值不变")
    // 引用应完整
    assert(curr.unresolved_refs.len() == 0, "引用应完整")
    // 渲染应正常
    assert(curr.render_items.len() > 0, "渲染应正常")
    return Ok(0)
}

// ── diff 与 Awen 语法集成 ─────────────────────────────────

@test
fn diff_detects_awen_syntax_changes() -> Result<i32, String> {
    let old = "# 旧标题\n@[image hero]\n"
    let new = "# 新标题\n@[image hero]\n@[image extra]\n"
    let d = diff_text(old, new)
    assert(has_changes(d), "应检测到语法变化")
    assert(d.added > 0 && d.deleted > 0, "应检测到增删")
    return Ok(0)
}

@test
fn diff_ignores_whitespace_only_changes_in_raw() -> Result<i32, String> {
    // Raw 块内容变化应被检测(§6.7 逐字保留)
    let old = "@[c py]\ncode v1\n@[/c]\n"
    let new = "@[c py]\ncode v2\n@[/c]\n"
    let d = diff_text(old, new)
    assert(has_changes(d), "Raw 内容变化应被检测")
    return Ok(0)
}
