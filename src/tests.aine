@test
fn nav_next_heading() -> Result<i32, String> {
    let src = "# 第一章\n内容\n# 第二章\n内容\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let next = doc_next_heading(state, 1)
    match next {
        Some(n) {
            assert(n.id != 1, "下一个 heading 不应是自身")
            let title = inline_plain(n.inline)
            assert(title.contains("第二章"), f"下一个 heading 应为第二章,得到 [{title}]")
        }
        None { return Err("找不到下一个 heading") }
    }
    return Ok(0)
}

