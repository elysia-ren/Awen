@test
fn render_raw_lang_preserved() -> Result<i32, String> {
    let src = "@[c python]\nprint(1)\n@[/c]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    for node in state.nodes {
        if node.kind == "raw" {
            match node.raw_lang {
                Some(lang) { assert(lang == "python", f"语言应为 python,得到 {lang}") }
                None { assert(false, "语言应保留") }
