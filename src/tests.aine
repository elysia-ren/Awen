@test
fn label_ref_resolution_after_multiple_edits() -> Result<i32, String> {
    // 多次编辑后 ref 解析仍应正确
    let src = "# 引言 @[label intro]\n内容\n见 @[ref intro]。\n## 方法 @[label method]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let labels1 = collect_labels(state)
    assert(labels1.len() == 2, f"初始 Label 应为 2")

    // 修改引言 heading
    let r = edit_heading_text(state, 1, "修改后的引言", src)
    let out2 = lex(r.new_source)
    let pr2 = parse(out2)
    let state2 = build_document(pr2, r.new_source)
    let labels2 = collect_labels(state2)

    // method 的 Label 应不受影响
    var found_method = false
    for l in labels2 {
        if l.label == "method" { found_method = true }
    }
    assert(found_method, "method Label 应保留")

    // ref intro 应仍可解析(如果 intro label 因编辑丢失,应有诊断)
    let res = resolve_ref(state2, labels2, "method")
    assert(res.found, "method ref 应可解析")
    return Ok(0)
}

