@test
fn integration_theme_render_multiple_levels() -> Result<i32, String> {
    // 多级 heading 的 theme 级联渲染
    let src = "# H1\n## H2\n### H3\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_new("multi_level")
    t = theme_add_rule(t, "heading", 1, "size", "24pt")
    t = theme_add_rule(t, "heading", 2, "size", "20pt")
    t = theme_add_rule(t, "heading", 3, "size", "16pt")
    let items = render_document(state, t)
    // 三个 heading 各有不同的 font_size
    var h1_size = ""
    var h2_size = ""
    var h3_size = ""
    for item in items {
        if item.kind == "heading" {
            if item.text == "H1" { h1_size = item.font_size }
            if item.text == "H2" { h2_size = item.font_size }
            if item.text == "H3" { h3_size = item.font_size }
        }
    }
    assert(h1_size == "24pt", f"H1 = {h1_size}")
    assert(h2_size == "20pt", f"H2 = {h2_size}")
    assert(h3_size == "16pt", f"H3 = {h3_size}")
    return Ok(0)
}

@test
fn pipeline_check_and_validate_clean() -> Result<i32, String> {
