    let issues = cjk_validate_line_breaks(lines)
    assert(issues.len() == 0, f"正常文本不应有禁则违规: {issues}")
    return Ok(0)
}

@test
fn cjk_line_end_forbidden_punct() -> Result<i32, String> {
    let lines = ["这是一段文字「", "这是另一段。"]
    let issues = cjk_validate_line_breaks(lines)
    assert(issues.len() > 0, f"行尾「 应触发禁则")
    return Ok(0)
}

@test
fn pipeline_theme_and_render_after_incremental() -> Result<i32, String> {
    // 增量编辑后 theme 和渲染仍然正确
    let src = "# 标题\n这是正文内容。\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_new("incr_test")
    t = theme_add_rule(t, "heading", 1, "size", "24pt")
    t = theme_add_rule(t, "body", 0, "font", "Serif")

    // 编辑前渲染
    let items_before = render_document(state, t)

    // 编辑 heading
    let r = edit_heading_text(state, 1, "修改后的标题", src)
    let out2 = lex(r.new_source)
    let pr2 = parse(out2)
    let state2 = build_document(pr2, r.new_source)
    let items_after = render_document(state2, t)

    // 渲染项数一致
    assert(items_before.len() == items_after.len(), f"渲染项数应一致")
    // 修改后的标题应在渲染中
    var found = false
    for item in items_after {
        if item.text.contains("修改后的标题") { found = true }
    }
    assert(found, "修改后的标题应出现在渲染中")
    return Ok(0)
}

