fn expect(cond: bool, msg: String) -> Result<i32, String> {
    if cond { return Ok(0) }
    return Err(msg)
}

fn load_corpus(name: String) -> String {
    let src = read_file(f"corpus/{name}")
    if src.contains("[read_file error") {
        return f" corpus 加载失败: {src}"
    }
    return src
}

// ── 行内树遍历(避免高阶函数)────────────────────────────

fn has_bold(items: Vec<Inline>) -> bool {
    for it in items {
        match it {
            IBold(c) { return true }
            Italic(c) { if has_bold(c) { return true } }
            Strike(c) { if has_bold(c) { return true } }
            Scoped(cmd, c) { if has_bold(c) { return true } }
            _ { }
        }
    }
    return false
}

fn has_italic(items: Vec<Inline>) -> bool {
    for it in items {
        match it {
            Italic(c) { return true }
            IBold(c) { if has_italic(c) { return true } }
            Strike(c) { if has_italic(c) { return true } }
            Scoped(cmd, c) { if has_italic(c) { return true } }
            _ { }
        }
    }
    return false
}

fn has_scoped_bold(items: Vec<Inline>) -> bool {
    for it in items {
        match it {
            Scoped(cmd, c) { if cmd == Bold { return true } }
            IBold(c) { if has_scoped_bold(c) { return true } }
            Italic(c) { if has_scoped_bold(c) { return true } }
            Strike(c) { if has_scoped_bold(c) { return true } }
            _ { }
        }
    }
    return false
}

fn has_scoped_underline(items: Vec<Inline>) -> bool {
    for it in items {
        match it {
            Scoped(cmd, c) { if cmd == U { return true } }
            _ { }
        }
    }
    return false
}

fn has_raw_math(items: Vec<Inline>) -> bool {
    for it in items {
        match it {
            RawInline(cmd, lang, content) { if cmd == Math { return true } }
            _ { }
        }
    }
    return false
}

fn any_diag_msg_contains(diags: Vec<Diagnostic>, needle: String) -> bool {
    for d in diags {
        if d.message.contains(needle) { return true }
    }
    return false
}

fn any_diag_hint_contains(diags: Vec<Diagnostic>, needle: String) -> bool {
    for d in diags {
        match d.hint {
            Some(h) { if h.contains(needle) { return true } }
            None { }
        }
    }
    return false
}

// ── registry(§11)─────────────────────────────────────────

@test
fn registry_cn_aliases() -> Result<i32, String> {
    return expect(lookup("图片") == Some(Image) && lookup("字体") == Some(Font)
        && lookup("大小") == Some(Size) && lookup("标签") == Some(Label), "中文别名")
}

@test
fn registry_whitelist_is_closed() {
    assert(lookup("excel") == None, "未注册命令")
    assert(lookup("样式") == None, "未注册命令")
}

@test
fn registry_image_has_no_single_letter_short() {
    assert(lookup("i") == None, "§11.2:i 废止")
}

@test
fn registry_close_tag_aliases() {
    assert(close_matches(Code, "code") && close_matches(Code, "c"), "code 别名")
    assert(close_matches(Math, "m"), "math 别名")
    assert(!close_matches(Code, "m"), "交叉关闭")
}

@test
fn registry_doc_level_and_scoped_partition() {
    assert(is_doc_level(Font) && is_scoped(Font), "font 双形式")
    assert(is_doc_level(Page) && !is_scoped(Page), "page 仅文档级")
    assert(!is_doc_level(Image), "image 非文档级")
}

// ── escape(§6.8)──────────────────────────────────────────

@test
fn escape_all_forms() {
    assert(escape_scan("@**ab", 0) == Some(EscapeHit { consumed: 3, text: "**" }), "@**")
    assert(escape_scan("@1. 第一项", 0) == Some(EscapeHit { consumed: 3, text: "1." }), "@1.")
}

@test
fn escape_non_escapes() {
    assert(escape_scan("@e", 0) == None, "@e 非转义")
    assert(escape_scan("@12", 0) == None, "无点数字非转义")
}

// ── fullwidth(§6.9–6.10)─────────────────────────────────

@test
fn fullwidth_table() {
    assert(fw_normalize_in_command("“") == Some("\""), "全角引号")
    assert(fw_normalize_in_command("：") == Some(":"), "全角冒号")
    assert(fw_normalize_in_command("，") == None, "全角逗号非命令头")
    assert(fw_normalize_in_command("中") == None, "正文全角是内容")
}

// ── explicit(§6.1、§11)──────────────────────────────────

@test
fn explicit_quoted_string_and_attrs() -> Result<i32, String> {
    let src = "@[link \"OpenAI\" url: \"https://openai.com\"]"
    let hp = parse_header(src, 0)
    match hp {
        Ok(h) {
            let u = h.cu
            return expect(u.cmd == Link && u.args == [Str("OpenAI")], "link 解析")
        }
        Err(e) { return Err(e.msg) }
    }
}

@test
fn explicit_full_width_quotes() -> Result<i32, String> {
    let hp = parse_header("@[字体：“微软雅黑”]", 0)
    match hp {
        Ok(h) {
            return expect(h.cu.cmd == Font && h.cu.args == [Str("微软雅黑")], "全角引号归一化")
        }
        Err(e) { return Err(e.msg) }
    }
}

@test
fn explicit_ideographic_space_rejected() {
    let hp = parse_header("@[字体　微软雅黑]", 0)
    match hp {
        Err(e) { assert(e.msg.contains("全角空格"), "U+3000 诊断") }
        Ok(_) { assert(false, "U+3000 应拒绝") }
    }
}

@test
fn explicit_unquoted_multiword_exceeds_arity() {
    let hp = parse_header("@[font Noto Sans CJK SC]", 0)
    match hp {
        Err(e) { assert(e.msg.contains("位置参数过多"), "参数过多") }
        Ok(_) { assert(false, "多词值应拒绝") }
    }
}

@test
fn explicit_unknown_command_rejected() {
    let ok = match parse_header("@[excel x]", 0) {
        Ok(_) { true }
        Err(_) { false }
    }
    assert(!ok, "白名单外命令")
}

// ── lightweight(§6.3–6.5、§6.8、§6.11)──────────────────

@test
fn lw_block_triggers() {
    assert(classify("# 标题") == LcHeading(1), "H1")
    assert(classify("#tag") == LcText, "#tag 是字面")
    assert(classify("- 项目") == LcListItem(false), "无序")
    assert(classify("-5") == LcText, "-5 是字面")
    assert(classify("1. 项目") == LcListItem(true), "有序")
    assert(classify("1.这是") == LcText, "无空格非列表")
    assert(classify("> 引用") == LcQuote(1), "引用")
    assert(classify(">abc") == LcText, ">abc 是字面")
    assert(classify("---") == LcDivider, "分节线")
    assert(classify("---abc") == LcText, "---abc 是字面")
}

@test
fn lw_boundary_rules() -> Result<i32, String> {
    let a = lw_scan_inline("中文_斜体_中文", 0, [])
    assert(has_italic(a.inline), "CJK 紧邻斜体")
    let b = lw_scan_inline("foo_bar_baz", 0, [])
    assert(!has_italic(b.inline), "字母旁下划线不触发")
    let c = lw_scan_inline("2**3 不构成粗体", 0, [])
    assert(!has_bold(c.inline), "2**3 不触发粗体")
    let d = lw_scan_inline("an _em_ word", 0, [])
    assert(has_italic(d.inline), "英文边界")
    return Ok(0)
}

@test
fn lw_nesting_and_crossing() -> Result<i32, String> {
    let a = lw_scan_inline("**粗体中嵌 _斜体_**", 0, [])
    assert(has_bold(a.inline) && has_italic(a.inline), "合法嵌套")
    let b = lw_scan_inline("**a _b** c_", 0, [])
    assert(inline_plain(b.inline) == "**a _b** c_", "交叉按字面")
    assert(any_diag_msg_contains(b.diags, "交叉"), "交叉诊断")
    return Ok(0)
}

@test
fn lw_escapes_unconditional() -> Result<i32, String> {
    let a = lw_scan_inline("@**不是粗体**", 0, [])
    assert(inline_plain(a.inline) == "**不是粗体**", "@** 字面化")
    assert(!has_bold(a.inline), "无粗体节点")
    let b = lw_scan_inline("@#todo", 0, [])
    assert(inline_plain(b.inline) == "#todo", "@# 字面化")
    let c = lw_scan_inline("@@[image hero] 尾", 0, [])
    assert(inline_plain(c.inline) == "@[image hero] 尾", "@@[...] 字面化")
    return Ok(0)
}

@test
fn lw_explicit_scopes() -> Result<i32, String> {
    let a = lw_scan_inline("@[b]短@[/b]", 0, [])
    assert(has_scoped_bold(a.inline), "b 作用域")
    let b = lw_scan_inline("@[m]E=mc@[/m]", 0, [])
    assert(has_raw_math(b.inline), "行内数学")
    let c = lw_scan_inline("@[b]a _b_ c@[/b]", 0, [])
    assert(has_scoped_bold(c.inline) && has_italic(c.inline), "互嵌成树")
    let d = lw_scan_inline("@[u]下划线@[/u]", 0, [])
    assert(has_scoped_underline(d.inline), "@[u] 下划线")
    return Ok(0)
}

// ── corpus 集成(M2a 验收)───────────────────────────────

@test
fn corpus_lexes_without_errors() -> Result<i32, String> {
    let out = lex(load_corpus("all_syntax.awen"))
    let n = count_errors(out.diags)
    if n == 0 { return Ok(0) }
    return Err(f"corpus 有 {n} 个词法错误")
}

@test
fn corpus_block_structure() -> Result<i32, String> {
    let out = lex(load_corpus("all_syntax.awen"))
    var heading: Vec<i32> = [0, 0, 0, 0, 0, 0, 0]
    var divider = 0
    var raw_code = false
    var raw_math = false
    var raw_comment = false
    var table_open = 0
    var table_close = 0
    var rows = 0
    var delimiter_rows = 0
    var objects: Vec<ExplicitCommand> = []
    for b in out.blocks {
        match b.block {
            Heading(level, inline) {
                heading[level] = heading[level] + 1
                var acc = collect_inline(inline, objects)
                objects = acc
            }
            Divider { divider += 1 }
            Paragraph(inline) { objects = collect_inline(inline, objects) }
            BlkListItem(ordered, inline) { objects = collect_inline(inline, objects) }
            Quote(depth, inline) { objects = collect_inline(inline, objects) }
            RawOpen(cmd, lang) {
                if cmd == Code { raw_code = true }
                if cmd == Math { raw_math = true }
                if cmd == Comment { raw_comment = true }
            }
            TableOpen(u) { table_open += 1 }
            TableClose { table_close += 1 }
            TableRow(cells, delimiter) {
                rows += 1
                if delimiter { delimiter_rows += 1 }
                for cell in cells {
                    objects = collect_inline(cell, objects)
                }
            }
            BlkObject(u) {
                let cmd = match b.block {
                    BlkObject(uu) { uu.cmd }
                    _ { Code }
                }
                objects.push(cmd)
            }
            _ { }
        }
    }
    var lvl = 1
    while lvl <= 6 {
        if heading[lvl] < 1 { return Err(f"缺少 {lvl} 级标题") }
        lvl += 1
    }
    if divider < 1 { return Err("缺少分节线") }
    if !raw_code { return Err("缺少代码 Raw") }
    if !raw_math { return Err("缺少数学 Raw") }
    if !raw_comment { return Err("缺少注释 Raw") }
    if table_open != 2 { return Err(f"应有 2 个表格,得到 {table_open}") }
    if table_close != 2 { return Err("表格未闭合") }
    if rows < 9 { return Err(f"行数不足:{rows}") }
    if delimiter_rows < 2 { return Err("缺少分隔行") }
    return Ok(0)
}

fn collect_inline(items: Vec<Inline>, out: Vec<ExplicitCommand>) -> Vec<ExplicitCommand> {
    var acc = out
    for i in items {
        match i {
            Command(u) { acc.push(u.cmd) }
            IBold(c) { acc = collect_inline(c, acc) }
            Italic(c) { acc = collect_inline(c, acc) }
            Strike(c) { acc = collect_inline(c, acc) }
            Scoped(cmd, c) {
                acc.push(cmd)
                acc = collect_inline(c, acc)
            }
            RawInline(cmd, lang, content) { acc.push(cmd) }
            AwTxt(s) { }
            CodeSpan(s) { }
            _ { }
        }
    }
    return acc
}

@test
fn p08_escapes_render_literal() -> Result<i32, String> {
    let out = lex("@# 不是标题\n@**不是粗体**\n@@[image hero] 尾\n")
    var plains: Vec<String> = []
    for b in out.blocks {
        match b.block {
            Paragraph(inline) { plains.push(inline_plain(inline)) }
            _ { }
        }
    }
    var found_hash = false
    var found_bold = false
    var found_obj = false
    for p in plains {
        if p.starts_with("# 不是标题") { found_hash = true }
        if p.starts_with("**不是粗体**") { found_bold = true }
        if p.starts_with("@[image hero] 尾") { found_obj = true }
    }
    assert(found_hash && found_bold && found_obj, "转义字面化")
    return Ok(0)
}

@test
fn p11_fullwidth_equals_halfwidth() -> Result<i32, String> {
    let a = lex("@[font \"Noto Sans CJK SC\"]\n")
    let b = lex("@[font “Noto Sans CJK SC”]\n")
    let c = lex("@[字体 \"Noto Sans CJK SC\"]\n")
    for o in [a, b, c] {
        if count_errors(o.diags) != 0 { return Err("全角形式不应报错") }
    }
    // 提取各形式的 cmd 和 args
    var cmd_a = Code
    var args_a: Vec<Arg> = []
    match a.blocks[0].block {
        BlkObject(u) {
            cmd_a = u.cmd
            args_a = u.args
        }
        _ { return Err("a[0] 非对象") }
    }
    var cmd_b = Code
    var args_b: Vec<Arg> = []
    match b.blocks[0].block {
        BlkObject(u) {
            cmd_b = u.cmd
            args_b = u.args
        }
        _ { return Err("b[0] 非对象") }
    }
    var cmd_c = Code
    var args_c: Vec<Arg> = []
    match c.blocks[0].block {
        BlkObject(u) {
            cmd_c = u.cmd
            args_c = u.args
        }
        _ { return Err("c[0] 非对象") }
    }
    if cmd_a != Font { return Err("应为 Font") }
    if cmd_a != cmd_b || args_a != args_b {
        return Err("全角引号与半角引号等价")
    }
    if cmd_a != cmd_c || args_a != args_c {
        return Err("中文别名与英文别名等价")
    }
    return Ok(0)
}

@test
fn edge_cases_classify_and_diagnose() -> Result<i32, String> {
    let out = lex(load_corpus("edge_cases.awen"))
    var plains: Vec<String> = []
    var has_italic_node = false
    for b in out.blocks {
        match b.block {
            Paragraph(inline) {
                plains.push(inline_plain(inline))
                if has_italic(inline) { has_italic_node = true }
            }
            _ { }
        }
    }
    for s in ["#tag 不是标题", "-5 不是列表", ">abc 不是引用",
        "1.这是普通文字", "Version 1.2.3", "---abc 不是分节线",
        "A | B | C 不是表格", "user@example.com"] {
        var found = false
        for p in plains {
            if p.contains(s) { found = true }
        }
        if !found { return Err(f"应按字面段落处理: {s}") }
    }
    if !has_italic_node {
        return Err("中文紧邻的下划线应构成斜体")
    }
    if !any_diag_msg_contains(out.diags, "全角空格") {
        return Err("缺少 U+3000 诊断")
    }
    if !any_diag_hint_contains(out.diags, "双引号") {
        return Err("缺少双引号提示")
    }
    if count_errors(out.diags) != 2 {
        return Err(f"edge_cases 恰有 2 个预期错误,实际 {count_errors(out.diags)}")
    }
    return Ok(0)
}

// ── seed(§2.2/§3.3/§4)───────────────────────────────────

@test
fn seed_label_charset() -> Result<i32, String> {
    assert(label_parse("架构图") != None, "CJK 合法")
    assert(label_parse("fig-1") != None, "连字符")
    assert(label_parse("a b") == None, "空格非法")
    assert(label_parse("") == None, "空串非法")
    return Ok(0)
}

@test
fn seed_span_after_edit() -> Result<i32, String> {
    let s_opt = span_new(10, 20)
    let s = match s_opt {
        Some(x) { x }
        None { return Err("span_new 失败") }
    }
    let r = span_after_edit(s, 0, 5, 3)
    match r {
        Some(rs) {
            if rs.start != 8 || rs.end != 18 { return Err("平移错误") }
        }
        None { return Err("平移不应失效") }
    }
    match span_after_edit(s, 15, 18, 2) {
        Some(_) { return Err("相交应失效") }
        None { }
    }
    return Ok(0)
}

@test
fn seed_patch_and_undo() -> Result<i32, String> {
    let r1 = buffer_insert(buffer_new("你好,世界"), 3, "Awen")?
    if r1.buf.content != "你好,Awen世界" { return Err("插入错误") }
    let inv0 = patch_invert(r1.patch)
    let restored = buffer_apply(r1.buf, inv0)?
    if restored.content != "你好,世界" { return Err("逆补丁错误") }
    let bad = TextPatch { start: 0, old: "xyz", new: "q" }
    match buffer_apply(buffer_new("abc"), bad) {
        Err(e) { if e != "补丁不匹配" { return Err("错误消息") } }
        Ok(_) { return Err("错误补丁不应成功") }
    }
    // Undo 链(LIFO:先撤 DELETE 再撤 INSERT)
    let b0 = buffer_new("第一段 @[b]粗体@[/b]")
    let original = b0.content
    let s1 = buffer_insert(b0, 0, "前缀:")?
    let s2 = buffer_delete(s1.buf, 3, 6)?
    let inv2 = patch_invert(s2.patch)
    let r = buffer_apply(s2.buf, inv2)?
    let inv1 = patch_invert(s1.patch)
    let r2 = buffer_apply(r, inv1)?
    if r2.content != original { return Err("Undo 栈回放必须逐字节还原") }
    return Ok(0)
}

// ── parser(M2b)──────────────────────────────────────────

@test
fn parser_list_grouping() -> Result<i32, String> {
    let out = lex("- 项目一\n- 项目二\n1. 有序项\n")
    let pr = parse(out)
    let n_lists = count_nodes(pr.nodes, "list")
    if n_lists != 2 { return Err(f"应有 2 个列表组(无序+有序),得到 {n_lists}") }
    return Ok(0)
}

@test
fn parser_quote_and_divider() -> Result<i32, String> {
    let out = lex("> 引用\n\n---\n")
    let pr = parse(out)
    let n_q = count_nodes(pr.nodes, "quote")
    let n_hr = count_nodes(pr.nodes, "hr")
    if n_q < 1 { return Err("缺少引用块") }
    if n_hr < 1 { return Err("缺少分节线") }
    return Ok(0)
}

@test
fn parser_table_structure() -> Result<i32, String> {
    let out = lex("@[table]\n\n| A | B |\n| --- | --- |\n| 1 | 2 |\n\n@[/table]\n")
    let pr = parse(out)
    let n_t = count_nodes(pr.nodes, "table")
    if n_t != 1 { return Err(f"应有 1 个表格,得到 {n_t}") }
    return Ok(0)
}

@test
fn parser_raw_block() -> Result<i32, String> {
    let out = lex("@[c py]\nprint(1)\n@[/c]\n")
    let pr = parse(out)
    let n_r = count_nodes(pr.nodes, "raw")
    if n_r != 1 { return Err(f"应有 1 个 Raw 块,得到 {n_r}") }
    return Ok(0)
}

// ── document(M3:Document State)─────────────────────────

@test
fn doc_build_and_count() -> Result<i32, String> {
    let out = lex(load_corpus("all_syntax.awen"))
    let pr = parse(out)
    let state = build_document(pr, load_corpus("all_syntax.awen"))
    let total = doc_node_count(state)
    if total < 20 { return Err(f"节点数不足: {total}") }
    let n_headings = doc_count_kind(state, "heading")
    if n_headings < 5 { return Err(f"标题数不足: {n_headings}") }
    let n_ids = doc_next_id(state)
    if n_ids != total + 1 { return Err(f"NodeId 计数不一致: {n_ids} vs {total + 1}") }
    return Ok(0)
}

@test
fn doc_test_find_by_id() -> Result<i32, String> {
    let out = lex("# 标题一\n正文段落\n")
    let pr = parse(out)
    let state = build_document(pr, "# 标题一\n正文段落\n")
    // 第一个节点 id=1
    let first = doc_find_by_id(state, 1)
    match first {
        Some(node) {
            if node.kind != "heading" { return Err(f"第一个节点应为 heading,得到 {node.kind}") }
            if node.id != 1 { return Err(f"NodeId 应为 1,得到 {node.id}") }
        }
        None { return Err("找不到 NodeId=1") }
    }
    // 第二个节点 id=2
    let second = doc_find_by_id(state, 2)
    match second {
        Some(node) {
            if node.kind != "para" { return Err(f"第二个节点应为 para,得到 {node.kind}") }
        }
        None { return Err("找不到 NodeId=2") }
    }
    return Ok(0)
}

@test
fn doc_get_headings_for_toc() -> Result<i32, String> {
    let out = lex("# H1\n## H2\n### H3\n## H2b\n")
    let pr = parse(out)
    let state = build_document(pr, "")
    var count = 0
    var levels: Vec<i32> = []
    for node in state.nodes {
        if node.kind == "heading" {
            count += 1
            levels.push(node.level)
        }
    }
    if count != 4 { return Err(f"应有 4 个 heading,得到 {count}") }
    if levels[0] != 1 { return Err(f"第一个应为 level 1,得到 {levels[0]}") }
    if levels[1] != 2 { return Err(f"第二个应为 level 2,得到 {levels[1]}") }
    if levels[2] != 3 { return Err(f"第三个应为 level 3,得到 {levels[2]}") }
    return Ok(0)
}

@test
fn doc_unique_node_ids() -> Result<i32, String> {
    let out = lex(load_corpus("all_syntax.awen"))
    let pr = parse(out)
    let state = build_document(pr, load_corpus("all_syntax.awen"))
    // 验证所有 NodeId 唯一
    var i = 0
    while i < state.nodes.len() {
        var j = i + 1
        while j < state.nodes.len() {
            if state.nodes[i].id == state.nodes[j].id {
                return Err(f"NodeId 重复: {state.nodes[i].id}")
            }
            j += 1
        }
        i += 1
    }
    return Ok(0)
}

// ── mapping(M4:Source Mapping + 闭环)────────────────────

@test
fn mapping_compute_spans_heading() -> Result<i32, String> {
    let src = "# 标题一\n正文\n## 标题二\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let spans = compute_spans(state, src)
    if spans.len() < 3 { return Err(f"span 数不足: {spans.len()}") }
    if spans[0].start_line != 0 { return Err(f"heading 1 应在行 0,得到 {spans[0].start_line}") }
    return Ok(0)
}

@test
fn mapping_edit_heading_closed_loop() -> Result<i32, String> {
    let src = "# 旧标题\n正文内容\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let result = edit_heading_text(state, 1, "新标题", src)
    if !result.new_source.contains("新标题") {
        return Err("新源码应包含新标题")
    }
    if result.new_source.contains("旧标题") {
        return Err("新源码不应包含旧标题")
    }
    if !result.new_source.contains("正文内容") {
        return Err("正文应不受影响")
    }
    let new_plain = inline_plain(result.new_state.nodes[0].inline)
    if new_plain != "新标题" {
        return Err(f"重新解析后标题应为 [新标题],得到 [{new_plain}]")
    }
    if result.new_state.nodes.len() != state.nodes.len() {
        return Err(f"节点数应一致:{state.nodes.len()} → {result.new_state.nodes.len()}")
    }
    return Ok(0)
}

@test
fn mapping_edit_preserves_siblings() -> Result<i32, String> {
    let src = "# 标题A\n段落B\n# 标题C\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let result = edit_heading_text(state, 1, "标题X", src)
    if !result.new_source.contains("标题C") {
        return Err("兄弟节点应不受影响")
    }
    if !result.new_source.contains("段落B") {
        return Err("段落应不受影响")
    }
    if result.new_state.nodes.len() != 3 {
        return Err(f"应有 3 个节点,得到 {result.new_state.nodes.len()}")
    }
    return Ok(0)
}

@test
fn mapping_roundtrip_no_drift() -> Result<i32, String> {
    let src = "# 版本一\n内容\n"
    let out1 = lex(src)
    let pr1 = parse(out1)
    let state1 = build_document(pr1, src)
    let r1 = edit_heading_text(state1, 1, "版本二", src)
    let r2 = edit_heading_text(r1.new_state, 1, "版本三", r1.new_source)
    if !r2.new_source.contains("版本三") { return Err("第二轮编辑失败") }
    if r2.new_source.contains("版本一") { return Err("旧文本残留") }
    if r2.new_source.contains("版本二") { return Err("中间文本残留") }
    if !r2.new_source.contains("内容") { return Err("正文丢失") }
    if inline_plain(r2.new_state.nodes[0].inline) != "版本三" {
        return Err("第二轮解析后标题不一致")
    }
    return Ok(0)
}

// ── refs(§2:Label/Reference)─────────────────────────────

@test
fn refs_collect_labels_from_headings() -> Result<i32, String> {
    let src = "# 章 A @[label chap-a]\n## 章 B @[标签 chap-b]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let labels = collect_labels(state)
    if labels.len() != 2 { return Err(f"应有 2 个 Label,得到 {labels.len()}") }
    if labels[0].label != "chap-a" { return Err(f"label[0] 应为 chap-a") }
    if labels[1].label != "chap-b" { return Err(f"label[1] 应为 chap-b") }
    return Ok(0)
}

@test
fn refs_label_uniqueness() -> Result<i32, String> {
    let src = "# A @[label dup]\n# B @[label dup]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let labels = collect_labels(state)
    let dupes = check_label_uniqueness(labels)
    if dupes.len() != 1 { return Err(f"应有 1 个重复,得到 {dupes.len()}") }
    if dupes[0] != "dup" { return Err(f"重复 Label 应为 dup") }
    return Ok(0)
}

@test
fn refs_resolve_and_validate() -> Result<i32, String> {
    // 有 Label 的文档:ref 应解析成功
    let src = "# 章 A @[label chap-a]\n见 @[ref chap-a]。\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let labels = collect_labels(state)
    if labels.len() != 1 { return Err(f"应有 1 个 Label") }

    // Semantic Resolver
    let res = resolve_ref(state, labels, "chap-a")
    if !res.found { return Err("ref 应解析成功") }
    if res.semantic_number != "1" { return Err(f"章节编号应为 1,得到 {res.semantic_number}") }

    // 引用完整性:无未解析引用
    let unresolved = validate_refs(state, labels)
    if unresolved.len() != 0 { return Err(f"不应有未解析引用") }
    return Ok(0)
}

@test
fn refs_unresolved_ref_detected() -> Result<i32, String> {
    let src = "见 @[ref 不存在]。\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let labels = collect_labels(state)
    let unresolved = validate_refs(state, labels)
    if unresolved.len() != 1 { return Err(f"应有 1 个未解析引用") }
    if unresolved[0] != "不存在" { return Err(f"未解析引用应为 [不存在]") }
    return Ok(0)
}

// ── theme(§18:样式级联)───────────────────────────────────

@test
fn theme_cascade_direct_overrides_all() {
    var t = theme_new("test")
    t = theme_add_rule(t, "heading", 1, "size", "20pt")
    // direct 值优先于 theme
    let r1 = resolve_style(t, "heading", 1, "size", Some("18pt"))
    assert(r1 == "18pt", "direct 应优先")
    // 无 direct → 用 theme
    let r2 = resolve_style(t, "heading", 1, "size", None)
    assert(r2 == "20pt", "无 direct 应取 theme")
}

@test
fn theme_heading_size_scaling() {
    var t = theme_new("default")
    t = theme_add_rule(t, "heading", 1, "size", "22pt")
    t = theme_add_rule(t, "heading", 2, "size", "18pt")
    t = theme_add_rule(t, "heading", 3, "size", "16pt")
    assert(heading_size(t, 1) == "22pt", "H1 = 22pt")
    assert(heading_size(t, 2) == "18pt", "H2 = 18pt")
    assert(heading_size(t, 3) == "16pt", "H3 = 16pt")
    // level 4 无规则 → 回退到默认
    assert(heading_size(t, 4) == "11pt", "H4 回退默认")
}

@test
fn theme_from_document_settings() -> Result<i32, String> {
    let src = "@[font \"Noto Serif CJK SC\"]\n@[size 12pt]\n正文\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_from_document(state)
    let size = resolve_style(t, "body", 0, "size", None)
    let font = resolve_style(t, "body", 0, "font", None)
    assert(size == "12pt", "文档级 size 应为 12pt")
    assert(font == "Noto Serif CJK SC", "文档级 font 应正确")
    return Ok(0)
}

@test
fn theme_numbering_extraction() -> Result<i32, String> {
    let src = "@[numbering figure \"图 %figure\"]\n@[numbering heading level: 1 \"第 %chapter 章\"]\n正文\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let configs = numbering_from_document(state)
    assert(configs.len() == 2, "应有 2 个 Numbering 配置")
    if configs.len() == 2 {
        assert(configs[0].target == "figure", "第一个为 figure")
        assert(configs[1].target == "heading", "第二个为 heading")
        assert(configs[1].level == 1, "heading level 1")
    }
    return Ok(0)
}

// ── 对抗性测试(§87:多轮连续编辑零漂移)────────────────────

@test
fn stress_multi_round_edit_no_drift() -> Result<i32, String> {
    // §87:Syntax Edit → Display Edit → Syntax Edit → Display Edit × N
    let src = "# v0\n内容 A\n## 子标题\n内容 B\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)

    var cur_source = src
    var cur_state = state
    var round = 0
    var expected_texts: Vec<String> = []

    // 10 轮连续编辑,每轮修改第一个 heading 的文本
    var texts = ["v1", "v2", "v3", "v4", "v5", "v6", "v7", "v8", "v9", "v10"]
    for txt in texts {
        round += 1
        let result = edit_heading_text(cur_state, 1, txt, cur_source)
        cur_source = result.new_source
        cur_state = result.new_state

        // 验证:正文不受影响(§37 最小修改)
        if !cur_source.contains("内容 A") {
            return Err(f"round {round}: 内容 A 丢失")
        }
        if !cur_source.contains("内容 B") {
            return Err(f"round {round}: 内容 B 丢失")
        }
        if !cur_source.contains("子标题") {
            return Err(f"round {round}: 子标题丢失")
        }
        // 验证:旧文本已清除
        if round > 1 {
            let prev = texts[round - 2]
            if cur_source.contains(prev) {
                return Err(f"round {round}: 旧文本 [{prev}] 残留")
            }
        }
        expected_texts = expected_texts.push(txt)
    }

    // 最终验证:重新解析后,heading 文本正确且节点数不变
    let final_plain = inline_plain(cur_state.nodes[0].inline)
    if final_plain != "v10" {
        return Err(f"最终标题应为 v10,得到 [{final_plain}]")
    }
    if cur_state.nodes.len() != state.nodes.len() {
        return Err(f"节点数漂移:{state.nodes.len()} → {cur_state.nodes.len()}")
    }
    return Ok(0)
}

@test
fn stress_multi_heading_edit() -> Result<i32, String> {
    // 多个 heading 交替编辑,验证互不干扰(§37)
    let src = "# A\n内容\n# B\n内容\n# C\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)

    // 修改第一个 heading(id=1)
    let r = edit_heading_text(state, 1, "A_new", src)
    if !r.new_source.contains("A_new") { return Err("A 未修改") }
    if !r.new_source.contains("B") { return Err("B 被影响") }
    if !r.new_source.contains("C") { return Err("C 被影响") }
    // 验证语义树
    if r.new_state.nodes.len() != state.nodes.len() {
        return Err(f"节点数漂移: {state.nodes.len()} → {r.new_state.nodes.len()}")
    }
    return Ok(0)
}

@test
fn stress_insert_between_headings() -> Result<i32, String> {
    // 在两个 heading 之间插入新段落,验证相邻 heading 的 span 不破坏
    let src = "# H1\n# H2\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let r = edit_heading_text(state, 1, "H1_modified", src)
    if !r.new_source.contains("H2") { return Err("H2 丢失") }
    if !r.new_source.contains("H1_modified") { return Err("H1 未修改") }
    return Ok(0)
}

// ── render(渲染管线)───────────────────────────────────────

@test
fn render_heading_sizes_from_theme() -> Result<i32, String> {
    let src = "# H1\n## H2\n正文\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_new("test")
    t = theme_add_rule(t, "heading", 1, "size", "22pt")
    t = theme_add_rule(t, "heading", 2, "size", "18pt")
    let items = render_document(state, t)
    if items.len() != 3 { return Err(f"应有 3 个渲染项,得到 {items.len()}") }
    // H1 应为 22pt
    if items[0].font_size != "22pt" { return Err(f"H1 size 应为 22pt,得到 {items[0].font_size}") }
    if items[0].text != "H1" { return Err(f"H1 text 应为 H1,得到 {items[0].text}") }
    // H2 应为 18pt
    if items[1].font_size != "18pt" { return Err(f"H2 size 应为 18pt") }
    // 正文回退默认
    if items[2].font_size != "11pt" { return Err(f"body size 应为默认 11pt") }
    return Ok(0)
}

@test
fn render_plain_text_roundtrip() -> Result<i32, String> {
    let src = "# 标题\n正文段落。\n- 项目一\n- 项目二\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let text = render_plain_text(state)
    // 验证渲染输出包含所有内容
    if !text.contains("# 标题") { return Err("缺少标题") }
    if !text.contains("正文段落。") { return Err("缺少段落") }
    if !text.contains("项目一") { return Err("缺少列表项 1") }
    if !text.contains("项目二") { return Err("缺少列表项 2") }
    return Ok(0)
}

@test
fn render_comment_not_in_output() -> Result<i32, String> {
    // 注释(§11.3)不产生可渲染节点
    let src = "@[comment 这不应出现]\n正文\n"
    let out = lex(src)
    let pr = parse(out)
