fn inline_scope_nested_render() -> Result<i32, String> {
    // 嵌套 Scoped 渲染
    let r = lw_scan_inline("@[b]外层 @[u]内层@[/u] 尾@[/b]", 0, [])
    let marked = inline_render_marked(r.inline)
    assert(marked.contains("@[b]"), "外层标记")
