fn pipeline_full_stats_report() -> Result<i32, String> {
    // 完整管线的统计报告
    let src = load_corpus("all_syntax.awen")
    let p = pipeline_full(src)
    // 验证统计
    assert(p.state.nodes.len() > 20, f"节点数 {p.state.nodes.len()}")
    assert(p.render_items.len() > 20, f"渲染项 {p.render_items.len()}")
    assert(p.labels.len() >= 3, f"Label {p.labels.len()}")
    // 引用完整
    assert(p.unresolved_refs.len() == 0, f"未解析引用 {p.unresolved_refs}")
    // 主题应有规则
    assert(p.theme.rules.len() > 0, f"主题规则 {p.theme.rules.len()}")
    return Ok(0)
}

// ── 渲染 + 主题 + CJK + 编辑综合验证 ────────────────────────

// ⚠ 待排查:Scoped + Raw 组合在 pipeline 中的交互
// @test
fn integration_render_theme_cjk_edit_labels() -> Result<i32, String> {
    // 最终大综合测试:同时验证 Theme、CJK、Label、编辑闭环
    let src = "# 中文文档 @[label doc]\n这是**加粗**的正文，包含中文标点。\n\n## 数据表格 @[label data]\n@[table]\n\n| 名称 | 值 |\n| --- | --- |\n| 测试 | 42 |\n\n@[/table]\n\n见 @[ref doc]。\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)

    // Theme
    var t = theme_new("cjk_test")
    t = theme_add_rule(t, "heading", 1, "size", "24pt")
    t = theme_add_rule(t, "heading", 2, "size", "18pt")

    // Label
    let labels = collect_labels(state)
    assert(labels.len() == 2, f"应有 2 个 Label,得到 {labels.len()}")

    // 引用完整
    let unresolved = validate_refs(state, labels)
    assert(unresolved.len() == 0, f"不应有未解析引用: {unresolved}")

    // 编辑 heading 文本
    let r = edit_heading_text(state, 1, "修改后的中文文档", src)

    // 重新解析
    let out2 = lex(r.new_source)
    let pr2 = parse(out2)
    let state2 = build_document(pr2, r.new_source)

    // 渲染验证
    var t2 = theme_new("cjk_test")
    t2 = theme_add_rule(t2, "heading", 1, "size", "24pt")
    let items = render_document(state2, t2)
    assert(items.len() > 0, "渲染应有输出")

    // Markdown 导出
    let md = export_markdown(state2)
    assert(md.contains("修改后的中文文档"), "MD 应含新标题")
    assert(md.contains("| 测试 | 42 |"), "MD 应含表格数据")

    // CJK 验证
    let lines = r.new_source.split("\n")
    let cjk_issues = cjk_validate_line_breaks(lines)
    assert(cjk_issues.len() == 0, f"CJK 断行不应有违规: {cjk_issues}")
    return Ok(0)
}

@test
fn integration_full_corpus_all_modules() -> Result<i32, String> {
    // 使用完整 corpus 测试所有模块的交互
    let src = load_corpus("all_syntax.awen")

    // 词法
    let out = lex(src)
    assert(count_errors(out.diags) == 0, "词法不应有错误")

    // 语法树
    let pr = parse(out)
    assert(pr.nodes.len() > 20, f"语法树节点不足: {pr.nodes.len()}")

    // Document State
    let state = build_document(pr, src)
    assert(state.nodes.len() > 20, f"Document State 节点不足: {state.nodes.len()}")

    // Label
    let labels = collect_labels(state)
    assert(labels.len() >= 3, f"Label 不足: {labels.len()}")

    // 引用
    let unresolved = validate_refs(state, labels)
    assert(unresolved.len() == 0, f"未解析引用: {unresolved}")

    // Theme
    let theme = theme_from_document(state)
    assert(theme.rules.len() > 0, "Theme 应有规则")

    // 渲染
    let items = render_document(state, theme)
    assert(items.len() > 0, "渲染项不足")

    // Markdown 导出
    let md = export_markdown(state)
    assert(md.len() > 200, f"导出过短: {md.len()}")

    // CJK
    let cjk_result = validate_cjk_layout(["这是正常的中文文本内容"])
    assert(cjk_result.no_line_start_forbidden, "CJK 验证应通过")

    // 增量
    let incr = incremental_update(state, collect_labels(state), src, src)
    assert(incr.reused == state.nodes.len(), "无变化应全部复用")

    return Ok(0)
}

// ── 更多核心管线验证 ────────────────────────────────────────

@test
fn incr_incremental_matches_full_after_edit() -> Result<i32, String> {
    // 增量更新与全量解析结果一致(§1.3 概念验证)
    let old_src = "# A\n旧内容\n## B\n子内容 B\n"
    let new_src = "# A\n新内容\n## B\n子内容 B\n"
    let out_old = lex(old_src)
    let pr_old = parse(out_old)
    let old_state = build_document(pr_old, old_src)
    let old_labels = collect_labels(old_state)

    let incr = incremental_update(old_state, old_labels, old_src, new_src)

    // 全量解析新源码作为参考
    let out_new = lex(new_src)
    let pr_new = parse(out_new)
    let full_state = build_document(pr_new, new_src)

    // 节点数一致
    assert(incr.state.nodes.len() == full_state.nodes.len(), f"节点数不一致")
    // kind 序列一致
    var i = 0
    while i < full_state.nodes.len() && i < incr.state.nodes.len() {
        assert(full_state.nodes[i].kind == incr.state.nodes[i].kind, f"节点 {i} kind 不一致")
        i += 1
    }
    return Ok(0)
}

@test
fn pipeline_incremental_edit_labels_preserved() -> Result<i32, String> {
    // 多轮编辑后 Label 均保留(§2.5)
    let src = "# 章 A @[label a]\n## 章 B @[label b]\n### 章 C @[label c]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let labels = collect_labels(state)
    assert(labels.len() == 3, f"初始 Label 应为 3")

    // 修改第一个 heading 的文本
    let r = edit_heading_text(state, 1, "修改后的 A", src)
    let out2 = lex(r.new_source)
    let pr2 = parse(out2)
    let state2 = build_document(pr2, r.new_source)
    let labels2 = collect_labels(state2)

    // b 和 c 的 Label 应保留(未被编辑)
    var found_b = false
    var found_c = false
    for l in labels2 {
        if l.label == "b" { found_b = true }
        if l.label == "c" { found_c = true }
    }
    assert(found_b && found_c, f"未编辑 heading 的 Label 应保留,得到 {labels2.len()} 个")
    return Ok(0)
}

@test
fn render_html_escapes_xss() -> Result<i32, String> {
    // XSS 防护:<script> 应被转义
    let src = "包含 <script>alert('xss')</script> 的内容\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let html = export_html(state)
    assert(!html.contains("<script>alert"), "script 标签应被转义")
    assert(html.contains("&lt;script&gt;"), "应有转义后的标签")
    return Ok(0)
}

