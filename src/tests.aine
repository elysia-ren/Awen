@test
fn render_theme_heading_all_levels() -> Result<i32, String> {
    // 测试 6 个 heading 级别的 theme 级联
    var t = theme_new("full")
    t = theme_add_rule(t, "heading", 1, "size", "26pt")
    t = theme_add_rule(t, "heading", 2, "size", "22pt")
    t = theme_add_rule(t, "heading", 3, "size", "18pt")
    t = theme_add_rule(t, "heading", 4, "size", "16pt")
    t = theme_add_rule(t, "heading", 5, "size", "14pt")
    t = theme_add_rule(t, "heading", 6, "size", "12pt")
    // H1 → 26pt
    assert(heading_size(t, 1) == "26pt", "H1 = 26pt")
    assert(heading_size(t, 2) == "22pt", "H2 = 22pt")
    assert(heading_size(t, 3) == "18pt", "H3 = 18pt")
    assert(heading_size(t, 4) == "16pt", "H4 = 16pt")
    assert(heading_size(t, 5) == "14pt", "H5 = 14pt")
    assert(heading_size(t, 6) == "12pt", "H6 = 12pt")
    return Ok(0)
}

@test
fn render_theme_prop_isolation() -> Result<i32, String> {
    // 不同属性的规则不应互相干扰
    var t = theme_new("isolated")
    t = theme_add_rule(t, "heading", 0, "size", "20pt")
    t = theme_add_rule(t, "body", 0, "color", "#333")
    // heading 的 size 不影响 body 的 size
    assert(resolve_style(t, "body", 0, "size", None) == "11pt", "body size 不受 heading 规则影响")
    // body 的 color 不影响 heading 的 color
    assert(resolve_style(t, "heading", 1, "color", None) == "#000000", "heading color 回退默认")
    return Ok(0)
}

