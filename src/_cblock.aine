// _cblock.aine —— lex 块行号+变体签名对比探针
module diag;
module registry;
module fullwidth;
module escape;
module explicit;
module lightweight;
module lexer;

fn blk_sig(b: LexedBlock) -> String {
    var s = f"{b.line}|"
    match b.block {
        Blank { s = s + "B" }
        Heading(lv, _) { s = s + "H" + f"{lv}" }
        Paragraph(_) { s = s + "P" }
        BlkListItem(o, _) {
            if o { s = s + "OL" } else { s = s + "UL" }
        }
        Quote(d, _) { s = s + "Q" + f"{d}" }
        Divider { s = s + "HR" }
        BlkObject(u) { s = s + "OBJ:" + u.name_raw }
        RawOpen(c, lang) {
            s = s + "RO"
            if c == Code { s = s + ":c" }
            if lang != None { s = s + "!" }
        }
        RawLine(_) { s = s + "RL" }
        RawClose(c) {
            s = s + "RC"
            if c == Code { s = s + ":c" }
        }
        TableOpen(u) { s = s + "TO:" + u.name_raw }
        TableRow(_, delim) {
            s = s + "TR"
            if delim { s = s + "!" }
        }
        TableClose { s = s + "TC" }
    }
    return s
}

fn main() {
    let src = read_file("build/bench_src.awen")
    if src.contains("[read_file error") {
        print("no src")
        return
    }
    let out = lex(src)
    var i: i32 = 0
    while i < out.blocks.len() {
        print(blk_sig(out.blocks.get(i)))
        i += 1
    }
}
