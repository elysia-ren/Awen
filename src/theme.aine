// awen-proto/src/theme.aine —— 样式/主题级联(§18 用户反馈)
// Theme → Role Style → Direct Property 三层级联
// 用户说"所有一级标题改 20pt"→ 改 theme,不改节点



// ── 主题构建 ────────────────────────────────────────────────

fn theme_new(name: String) -> Theme {
    return Theme { name: name, rules: [] }
}

fn theme_add_rule(t: Theme, role: String, level: i32, prop: String, value: String) -> Theme {
    let rule = StyleRule { role: role, level: level, prop: prop, value: value }
    return Theme { name: t.name, rules: t.rules.push(rule) }
}

// ── 级联解析(§18:direct > role > theme)──────────────────

// 查询某个节点某个属性的最终值
// direct_value: 节点自身显式设置的值(Option<String>)
// 返回:级联后的最终值
fn resolve_style(theme: Theme, role: String, level: i32, prop: String, direct_value: Option<String>) -> String {
    // 1. direct 优先
    match direct_value {
        Some(v) { return v }
        None { }
    }
    // 2. role style(最高优先的匹配规则)
    var i = theme.rules.len() - 1
    while i >= 0 {
        let r = theme.rules[i]
        if r.role == role && r.prop == prop {
            if role == "heading" {
                if r.level == level || r.level == 0 {
                    return r.value
                }
            } else {
                return r.value
            }
        }
        i -= 1
    }
    // 3. theme 默认值
    return get_default_prop(prop)
}

// Awen 默认排版(总方案 §20)
fn get_default_prop(prop: String) -> String {
    if prop == "size" { return "11pt" }
    if prop == "font" { return "Noto Sans CJK SC" }
    if prop == "spacing" { return "1.65" }
    if prop == "indent" { return "2em" }
    if prop == "color" { return "#000000" }
    if prop == "weight" { return "normal" }
    return ""
}

// ── Heading 缩放(§20:标题逐级放大)────────────────────────

fn heading_size(theme: Theme, level: i32) -> String {
    return resolve_style(theme, "heading", level, "size", None)
}

// ── 文档级设置(§11.1)─────────────────────────────────────

// 从 Document State 的文档级设置(@[page/margin/font/size] 等)
// 构建基础 Theme
fn theme_from_document(state: DocState) -> Theme {
    var t = theme_new("document")
    for node in state.nodes {
        if node.kind == "obj" {
            let cu = node.obj_cu
            if cu.cmd == Font && cu.args.len() > 0 {
                t = theme_add_rule(t, "body", 0, "font", arg_plain(cu.args[0]))
            } else if cu.cmd == Size && cu.args.len() > 0 {
                t = theme_add_rule(t, "body", 0, "size", arg_plain(cu.args[0]))
            } else if cu.cmd == LineSpacing && cu.args.len() > 0 {
                t = theme_add_rule(t, "body", 0, "spacing", arg_plain(cu.args[0]))
            } else if cu.cmd == FirstLine && cu.args.len() > 0 {
                t = theme_add_rule(t, "body", 0, "indent", arg_plain(cu.args[0]))
            }
        }
    }
    return t
}

// ── 编号样式(§7.6:文档级 Numbering 配置)─────────────────

struct NumberingConfig {
    target: String       // "figure" "table" "equation" "heading"
    level: i32           // heading 用(1-6),其余 0
    template: String     // "图 %figure" "%chapter.%section"
}

fn numbering_from_document(state: DocState) -> Vec<NumberingConfig> {
    var out: Vec<NumberingConfig> = []
    for node in state.nodes {
        if node.kind == "obj" {
            let cu = node.obj_cu
            if cu.cmd == Numbering && cu.args.len() > 0 {
                let target = arg_plain(cu.args[0])
                var level = 0
                // 提取 level 属性
                for attr in cu.attrs {
                    if attr.key == "level" {
                        level = arg_plain(attr.val).to_i32()
                    }
                }
                // 提取模板(最后一个位置参数或 content)
                var template = ""
                if cu.args.len() > 1 {
                    template = arg_plain(cu.args[1])
                }
                out = out.push(NumberingConfig { target: target, level: level, template: template })
            }
        }
    }
    return out
}
