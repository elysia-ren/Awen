fn main() {
    let src = load_corpus("all_syntax.awen")
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let md = export_markdown(state)
    print(f"has ol item: {md.contains("1. 有序列表项一")}")
    print(f"has ul item: {md.contains("- 无序列表项一")}")
    print(f"has heading: {md.contains("# 一级标题")}")
    // 检查 MD 前 300 字符
    var preview = md
    if preview.len() > 300 { preview = preview[0..300] }
    print(f"preview: [{preview}]")
}
