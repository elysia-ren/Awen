@test
fn integration_theme_render_document_settings() -> Result<i32, String> {
    // 文档级设置通过 theme 级联影响渲染
    let src = "@[size 14pt]\n@[font \"Serif\"]\n正文内容\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_from_document(state)
    // theme 应从文档级设置中提取
    let size = resolve_style(t, "body", 0, "size", None)
    let font = resolve_style(t, "body", 0, "font", None)
    assert(size == "14pt", f"size 应为 14pt,得到 {size}")
    assert(font == "Serif", f"font 应为 Serif,得到 {font}")
    // 渲染项应使用 theme 的值
    let items = render_document(state, t)
    for item in items {
        if item.kind == "para" {
            assert(item.font_size == "14pt", f"para font_size 应为 14pt")
            assert(item.font_name == "Serif", f"para font_name 应为 Serif")
        }
    }
    return Ok(0)
}

@test
fn integration_theme_edit_and_render_stable() -> Result<i32, String> {
    // 编辑后 theme 和渲染应保持一致
    let src = "@[size 14pt]\n@[font \"Serif\"]\n# 标题 @[label h1]\n正文内容\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_from_document(state)
    // 找到 heading 节点 id(前两个节点是 @[size]/@[font] 文档级对象)
    var heading_id = -1
    for n in state.nodes {
        if n.kind == "heading" { heading_id = n.id }
    }
    assert(heading_id > 0, "应有 heading 节点")
    // 编辑 heading 文本
    let r = edit_heading_text(state, heading_id, "修改后的标题", src)
    let out2 = lex(r.new_source)
    let pr2 = parse(out2)
    let state2 = build_document(pr2, r.new_source)
    var t2 = theme_from_document(state2)
    // theme 应一致
    let size1 = resolve_style(t, "body", 0, "size", None)
    let size2 = resolve_style(t2, "body", 0, "size", None)
    let font1 = resolve_style(t, "body", 0, "font", None)
    let font2 = resolve_style(t2, "body", 0, "font", None)
    assert(size1 == size2, f"size 应一致: {size1} vs {size2}")
    assert(font1 == font2, f"font 应一致: {font1} vs {font2}")
    // 渲染项应一致
    let items1 = render_document(state, t)
    let items2 = render_document(state2, t2)
    assert(items1.len() == items2.len(), f"渲染项数应一致")
    return Ok(0)
}

@test
fn integration_ref_toc_numbering() -> Result<i32, String> {
    // Ref + TOC + Numbering 协同
    let src = "# 引言 @[label intro]\n## 背景 @[label bg]\n# 实验 @[label exp]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let labels = collect_labels(state)
    let numbered = number_headings(state)
    let entries = generate_toc(state, 0)
    // 编号应与 TOC 一致
    assert(numbered.len() == entries.len(), f"编号数应等于 TOC 条目数")
    // TOC 条目编号应匹配 number_headings
    assert(entries[0].number == "1", "TOC 第一条编号应为 1")
    assert(entries[1].number == "1.1", "TOC 第二条编号应为 1.1")
    assert(entries[2].number == "2", "TOC 第三条编号应为 2")
    // 引用解析应返回正确编号
    let res = resolve_ref(state, labels, "intro")
    assert(res.found, "intro 应解析")
    assert(res.semantic_number.len() > 0, "编号不应为空")
    return Ok(0)
}

@test
fn integration_heading_edit_preserves_all_inline() -> Result<i32, String> {
    // 编辑 heading 后,行内的 @[label]、@[ref]、粗体等全部保留
    let src = "# 章 A @[label sec-a]\n这是**正文**内容。见 @[ref sec-a]。\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)

    // 修改 heading 文本
    let r = edit_heading_text(state, 1, "修改后的章 A", src)

    // 重新解析
    let out2 = lex(r.new_source)
    let pr2 = parse(out2)
    let state2 = build_document(pr2, r.new_source)

    // 验证 Label 保留(在 heading 行内)
    let labels = collect_labels(state2)
    assert(labels.len() >= 1, f"Label 应保留")

    // 验证段落中的粗体保留
    var found_bold = false
    for node in state2.nodes {
        if node.kind == "para" {
            if has_bold(node.inline) { found_bold = true }
        }
    }
    assert(found_bold, "段落中的粗体应保留")

    // 验证 ref 保留
    var found_ref = false
    for node in state2.nodes {
        if node.kind == "para" {
            for item in node.inline {
                match item {
                    Command(u) { if u.cmd == Ref { found_ref = true } }
                    _ { }
                }
            }
        }
    }
    assert(found_ref, "段落中的 ref 应保留")
    return Ok(0)
}

