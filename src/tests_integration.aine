@test
fn integration_edit_multi_heading_labels() -> Result<i32, String> {
    // 多 heading 文档中编辑一个,其他 heading 的 Label 和 Ref 均保留
    let src = "# 章 A @[label sec-a]\n正文 A\n## 章 B @[label sec-b]\n引用 @[ref sec-a]。\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let labels0 = collect_labels(state)
    assert(labels0.len() == 2, f"初始应有 2 个 Label,得到 {labels0.len()}")

    // 编辑第一个 heading(含 label sec-a)
    let r = edit_heading_text(state, 1, "修改后的章 A", src)
    let out2 = lex(r.new_source)
    let pr2 = parse(out2)
    let state2 = build_document(pr2, r.new_source)
    let labels2 = collect_labels(state2)

    // sec-b 应保留
    var found_b = false
    for l in labels2 {
        if l.label == "sec-b" { found_b = true }
    }
    assert(found_b, "sec-b Label 应保留")

    // 引用完整性(只检查 sec-b)
    var ref_b_ok = true
    for node in state2.nodes {
        if node.kind == "para" {
            let refs = find_refs_in_inline(node.inline)
            for ref_target in refs {
                if ref_target == "sec-b" {
                    var found = false
                    for l in labels2 {
                        if l.label == "sec-b" { found = true }
                    }
                    if !found { ref_b_ok = false }
                }
            }
        }
    }
    assert(ref_b_ok, "sec-b 引用应可解析")
    return Ok(0)
}

@test
fn integration_render_theme_all_types_combined() -> Result<i32, String> {
    // Theme + 所有行内类型 + 多级 heading + 表格
    let src = "# 章 A @[label h1]\n**粗** _斜_ `码` @[u]线@[/u]\n## 章 B @[label h2]\n@[image test.png]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_new("all_types")
    t = theme_add_rule(t, "heading", 1, "size", "22pt")
    t = theme_add_rule(t, "heading", 2, "size", "18pt")
    let items = render_document(state, t)

    // 验证渲染项数
    assert(items.len() == state.nodes.len(), "渲染项应匹配节点数")

    // 验证 heading 字号
    var h1_count = 0
    var h2_count = 0
    for item in items {
        if item.kind == "heading" {
            if item.font_size == "22pt" { h1_count += 1 }
            if item.font_size == "18pt" { h2_count += 1 }
        }
    }
    assert(h1_count == 1, f"应有 1 个 H1(22pt)")
    assert(h2_count == 1, f"应有 1 个 H2(18pt)")

    // Markdown 导出
    let md = export_markdown(state)
    assert(md.contains("# 章 A") || md.contains("章 A"), "MD 应含标题内容")
    return Ok(0)
}

@test
fn integration_incremental_raw_table_coexist() -> Result<i32, String> {
