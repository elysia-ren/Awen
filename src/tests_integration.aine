@test
fn integration_pipeline_incremental_edit_labels_refs_theme() -> Result<i32, String> {
    // 多模块集成:编辑 → Label 保留 → 引用完整 → Theme 级联 → 渲染
    let src = "# 引言 @[label intro]\n使用 Rust 和 Aine 开发。\n## 方法 @[label method]\n@[table]\n\n| 名称 | 值 |\n| --- | --- |\n| 测试 | 42 |\n\n@[/table]\n\n见 @[ref intro] 和 @[ref method]。\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_new("integration")
    t = theme_add_rule(t, "heading", 1, "size", "22pt")
    t = theme_add_rule(t, "heading", 2, "size", "18pt")
    t = theme_add_rule(t, "body", 0, "font", "Noto Sans CJK SC")

    // Label 验证
    let labels = collect_labels(state)
    assert(labels.len() >= 1, f"应有 Label,得到 {labels.len()}")

    // 引用验证
    let unresolved = validate_refs(state, labels)
    assert(unresolved.len() == 0, f"不应有未解析引用: {unresolved}")

    // Ref 解析
    let res1 = resolve_ref(state, labels, "intro")
    let res2 = resolve_ref(state, labels, "method")
    assert(res1.found && res2.found, "两个 ref 都应解析")

    // 渲染
    let items = render_document(state, t)
    assert(items.len() == state.nodes.len(), "渲染项应匹配节点数")

    // 编辑 heading 后
    let r = edit_heading_text(state, 1, "修改后的引言", src)
    let out2 = lex(r.new_source)
    let pr2 = parse(out2)
    let state2 = build_document(pr2, r.new_source)
    let labels2 = collect_labels(state2)

    // method Label 应保留
    var found_method = false
    for l in labels2 {
        if l.label == "method" { found_method = true }
    }
    assert(found_method, "method Label 应保留")

    // 引用应完整
    let unresolved2 = validate_refs(state2, labels2)
    assert(unresolved2.len() == 0, f"编辑后引用应完整")

    // Theme 级联
    assert(resolve_style(t, "heading", 1, "size", None) == "22pt", "H1 size")
    assert(resolve_style(t, "heading", 2, "size", None) == "18pt", "H2 size")
    assert(resolve_style(t, "body", 0, "font", None) == "Noto Sans CJK SC", "body font")

    // TOC
    let entries = generate_toc(state2, 0)
    assert(entries.len() >= 2, f"TOC 应有 >= 2 条,得到 {entries.len()}")
    return Ok(0)
}

