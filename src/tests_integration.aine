@test
fn nav_get_outline_shows_headings() -> Result<i32, String> {
    let src = "# 章 A\n## 节 A1\n# 章 B\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let outline = doc_get_outline(state)
    assert(outline.contains("章 A"), "大纲应含章 A")
    assert(outline.contains("节 A1"), "大纲应含节 A1")
    assert(outline.contains("章 B"), "大纲应含章 B")
    return Ok(0)
}

@test
fn classify_quote_depth_3() -> Result<i32, String> {
    assert(classify(">>> 三级") == LcQuote(3), "三级引用")
    assert(classify(">>>> 四级") == LcQuote(4), "四级引用(非标但可解析)")
    return Ok(0)
}

@test
fn classify_ordered_multi_digit() -> Result<i32, String> {
    assert(classify("10. 第十项") == LcListItem(true), "两位数字列表")
    assert(classify("100. 百分项") == LcListItem(true), "三位数字列表")
    assert(classify("1.没有空格") == LcText, "无空格非列表")
    return Ok(0)
}

@test
fn classify_divider_leading_spaces() -> Result<i32, String> {
    assert(classify("---") == LcDivider, "无前导空格")
    assert(classify(" ---") == LcDivider, "1 空格")
    assert(classify("  ---") == LcDivider, "2 空格")
    assert(classify("   ---") == LcDivider, "3 空格")
    assert(classify("    ---") == LcText, "4 空格非分节线")
    return Ok(0)
}

@test
fn classify_quote_and_list_same_line_prefix() -> Result<i32, String> {
    // 引用内列表:> - 项目 应识别为 Quote(不是 ListItem)
    assert(classify("> - 项目") == LcQuote(1), "引用内列表是 Quote")
    // 多级引用:>>> 三层
    assert(classify(">>> 三层引用") == LcQuote(3), "三级引用")
    return Ok(0)
}

@test
fn classify_heading_level_boundary() -> Result<i32, String> {
    // 6 级以内有效
    assert(classify("###### H6") == LcHeading(6), "H6 有效")
    // 7 个 # 超出范围 → 文本
    assert(classify("####### H7") == LcText, "H7 超出范围是文本")
    return Ok(0)
}

@test
fn classify_list_item_variants() -> Result<i32, String> {
    // 无序列表:- 后有空格
    assert(classify("- 项目") == LcListItem(false), "无序")
    // 有序列表:数字. 空格
    assert(classify("1. 项目") == LcListItem(true), "有序")
    assert(classify("42. 大编号") == LcListItem(true), "多位数字")
    // 非列表
    assert(classify("-5") == LcText, "负数非列表")
    assert(classify("-foo") == LcText, "-foo 非列表")
    assert(classify("1.没有空格") == LcText, "无空格非列表")
    return Ok(0)
}

@test
fn classify_blank_and_whitespace() -> Result<i32, String> {
    assert(classify("") == LcBlank, "空字符串")
    assert(classify(" ") == LcBlank, "单个空格")
    assert(classify("\t") == LcBlank, "Tab")
    assert(classify("   \t  ") == LcBlank, "混合空白")
    return Ok(0)
}

@test
fn classify_divider_variants() -> Result<i32, String> {
    assert(classify("---") == LcDivider, "---")
    assert(classify("-----") == LcDivider, "5 个 -")
    assert(classify("----------") == LcDivider, "10 个 -")
    assert(classify("---abc") == LcText, "---abc 是文本")
    return Ok(0)
}

@test
fn integration_lex_parse_build_render_export() -> Result<i32, String> {
    // 完整管线:lex → parse → build → theme → render → export
    let src = "# 引言 @[label intro]\n这是引言。使用 Rust 和 Aine 开发。\n\n@[table]\n\n| 名称 | 值 |\n| --- | --- |\n| 测试 | 42 |\n\n@[/table]\n\n见 @[ref intro]。\n"
    let out = lex(src)
    assert(count_errors(out.diags) == 0, "词法无错误")

    let pr = parse(out)
    let state = build_document(pr, src)
    let labels = collect_labels(state)
    assert(labels.len() >= 1, f"Label 应 >= 1")

    var t = theme_new("integration")
    t = theme_add_rule(t, "heading", 1, "size", "22pt")
    t = theme_add_rule(t, "body", 0, "font", "Noto Sans CJK SC")

    let items = render_document(state, t)
    assert(items.len() == state.nodes.len(), "渲染项应匹配节点数")

    let md = export_markdown(state)
    assert(md.contains("# 引言"), "MD 应含 H1")
    assert(md.contains("Rust"), "MD 应含 Rust")

    let html = export_html(state)
    assert(html.contains("<h1>"), "HTML 应含 h1")
    assert(html.contains("<table>"), "HTML 应含 table")

    // 验证引用
    let unresolved = validate_refs(state, labels)
    assert(unresolved.len() == 0, f"不应有未解析引用")
    return Ok(0)
}

@test
fn integration_incremental_edit_labels_refs_theme() -> Result<i32, String> {
    // 编辑 → Label 保留 → 引用完整 → Theme 正确 → 渲染一致
    let src = "# 标题 A @[label sec-a]\n使用 Rust 开发。见 @[ref sec-a]。\n## 子标题 @[label sec-b]\n更多内容。\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)

    var t = theme_new("edit_theme")
    t = theme_add_rule(t, "heading", 1, "size", "24pt")
    t = theme_add_rule(t, "heading", 2, "size", "18pt")

    // 编辑前渲染
    let items1 = render_document(state, t)

    // 编辑第一个 heading
    let r = edit_heading_text(state, 1, "修改后的标题 A", src)

    // 重新解析
    let out2 = lex(r.new_source)
    let pr2 = parse(out2)
    let state2 = build_document(pr2, r.new_source)
    let labels2 = collect_labels(state2)

    // 验证 Label
    var found_a = false
    var found_b = false
    for l in labels2 {
        if l.label == "sec-a" { found_a = true }
        if l.label == "sec-b" { found_b = true }
    }
    assert(found_a, "sec-a Label 应保留")
    assert(found_b, "sec-b Label 应保留")

    // 编辑后渲染
    let items2 = render_document(state2, t)
    assert(items1.len() == items2.len(), f"渲染项数应一致: {items1.len()} vs {items2.len()}")

    // Theme 字号应正确
    var h1_count = 0
    for item in items2 {
        if item.kind == "heading" && item.font_size == "24pt" { h1_count += 1 }
    }
    assert(h1_count == 1, f"应有 1 个 H1 (24pt)")
    return Ok(0)
}

@test
fn integration_cjk_render_theme_pipeline() -> Result<i32, String> {
    // CJK + Theme + Pipeline 综合
    let src = "# 中文文档 @[label doc]\n这是使用 Rust 和 Aine 开发的中文文档系统。\n\n## 数据 @[label data]\n@[table]\n\n| 名称 | 数量 |\n| --- | --- |\n| 测试 | 42 |\n\n@[/table]\n\n详见 @[ref doc]。\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)

    // Theme
    var t = theme_new("cjk_pipeline")
    t = theme_add_rule(t, "heading", 1, "size", "24pt")
    t = theme_add_rule(t, "body", 0, "font", "Noto Sans CJK SC")
    t = theme_add_rule(t, "body", 0, "size", "12pt")

    // Label 验证
    let labels = collect_labels(state)
    assert(labels.len() >= 2, f"应有 >=2 Label")

    // Ref 解析
    let res = resolve_ref(state, labels, "doc")
    assert(res.found, "doc 引用应解析")

    // 渲染
    let items = render_document(state, t)
    assert(items.len() > 0, "渲染项应存在")

    // Markdown 导出
    let md = export_markdown(state)
    assert(md.len() > 100, f"Markdown 导出过短: {md.len()}")

    // HTML 导出
    let html = export_html(state)
    assert(html.len() > 200, f"HTML 导出过短: {html.len()}")

    return Ok(0)
}

