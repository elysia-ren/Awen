    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let path = "test_full_doc.awen"
    save_awen(state, path)?
    let loaded = load_awen(path)?
    let loaded_state = loaded.state
    // 节点数应一致
    assert(loaded_state.nodes.len() == state.nodes.len(), f"节点数应一致: {state.nodes.len()} vs {loaded_state.nodes.len()}")
    return Ok(0)
}

@test
fn integration_cjk_all_features() -> Result<i32, String> {
    // CJK 全功能测试:分类+断行+禁则+间距+挤压
    let text = "使用Rust和Aine开发中文文档系统，支持表格和公式。"
    // 分类验证
    var has_cjk = false
    var has_latin = false
    var i = 0
    while i < text.len() {
        let c = text[i]
        if cjk_is_ideograph_char(c) { has_cjk = true }
        if cjk_is_latin_char(c) { has_latin = true }
        i += 1
    }
    assert(has_cjk && has_latin, "文本应包含 CJK 和 Latin 字符")
    // 断行
    let lines = cjk_line_break(text, 170.0, 11.0)
    assert(lines.len() >= 1, "断行应产生至少一行")
    // 禁则修正
    let fixed = fix_kinsoku(lines)
    // 禁则验证
    let issues = cjk_validate_line_breaks(fixed)
    assert(issues.len() == 0, f"修正后不应有禁则违规: {issues}")
    // 间距
    let spacing = cjk_mixed_spacing_text(text)
    assert(spacing.contains("[¼em]"), "混排应有间距标记")
    return Ok(0)
}

@test
fn integration_multi_edit_theme_stable() -> Result<i32, String> {
    // 多轮编辑后 theme 级联不受影响
