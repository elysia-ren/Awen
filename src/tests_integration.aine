@test
fn integration_render_theme_heading_and_scoped_all() -> Result<i32, String> {
    // Theme + Scoped + Label + Ref + Raw + TOC 全部集成
    let src = "# 文档标题 @[label doc]\n@[u]下划线@[/u] **粗体** _斜体_ `代码`\n\n@[table]\n\n| 名 | 值 |\n| --- | --- |\n| 测试 | 42 |\n\n@[/table]\n\n@[c py]\nprint(1)\n@[/c]\n\n见 @[ref doc]。\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_new("full_integration")
    t = theme_add_rule(t, "heading", 1, "size", "24pt")
    t = theme_add_rule(t, "body", 0, "font", "Noto Sans CJK SC")

    let labels = collect_labels(state)
    assert(labels.len() >= 1, "应有 Label")

    let unresolved = validate_refs(state, labels)
    assert(unresolved.len() == 0, "引用应完整")

    let items = render_document(state, t)
    assert(items.len() > 0, "渲染应有输出")

    let md = export_markdown(state)
    // 小文档不应用长度阈值;按内容断言
    assert(md.contains("# 文档标题"), "MD 应含 H1")
    assert(md.contains("| 名 | 值 |"), "MD 应含表头")
    assert(md.contains("print(1)"), "MD 应含代码")

    let html = export_html(state)
    assert(html.contains("<html>"), "HTML 导出应正常")

    return Ok(0)
}

@test
fn integration_theme_heading_body_render_labels() -> Result<i32, String> {
    // Theme + Heading + Body + Label + Render 全集成
    let src = "# 标题 @[label h1]\n正文 @[ref h1]。\n## 子标题 @[label h2]\n更多内容\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_new("integration")
    t = theme_add_rule(t, "heading", 1, "size", "24pt")
    t = theme_add_rule(t, "heading", 2, "size", "18pt")
    t = theme_add_rule(t, "body", 0, "font", "Noto Sans CJK SC")

    let items = render_document(state, t)
    assert(items.len() == state.nodes.len(), "渲染项应匹配节点数")

    let labels = collect_labels(state)
    assert(labels.len() == 2, f"应有 2 个 Label")

    // H1 渲染应使用 24pt
    for item in items {
        if item.kind == "heading" && item.font_size == "24pt" {
            assert(item.text.contains("标题"), "H1 渲染应含标题文本")
            break
        }
    }

    // body 渲染应使用 Serif?不,theme 没有 body font
    // 默认 font 是 Noto Sans CJK SC
    for item in items {
        if item.kind == "para" {
            assert(item.font_name == "Noto Sans CJK SC", "para 默认字体")
        }
    }

    // 引用应完整
    let unresolved = validate_refs(state, labels)
    assert(unresolved.len() == 0, f"不应有未解析引用")

    // Markdown 导出
    let md = export_markdown(state)
    assert(md.contains("# 标题"), "MD 应含标题")
    assert(md.contains("## 子标题"), "MD 应含子标题")
    return Ok(0)
}

@test
fn integration_pipeline_edit_labels_refs_comprehensive() -> Result<i32, String> {
    // 多 heading 多 Label 多 Ref 的编辑管线
    let src = "# 引言 @[label intro]\n正文。\n## 方法 @[label method]\n代码。\n## 结果 @[label result]\n见 @[ref intro] 和 @[ref method]。\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)

    // 收集初始 Label
    let labels1 = collect_labels(state)
    assert(labels1.len() == 3, f"初始应有 3 个 Label,得到 {labels1.len()}")

    // 编辑第一个 heading
    let r1 = edit_heading_text(state, 1, "修改后的引言", src)

    // 重新解析
    let out2 = lex(r1.new_source)
    let pr2 = parse(out2)
    let state2 = build_document(pr2, r1.new_source)
    let labels2 = collect_labels(state2)

    // 修改 method heading
    let r2 = edit_heading_text(state2, 3, "修改后的方法", r1.new_source)

    // 重新解析
    let out3 = lex(r2.new_source)
    let pr3 = parse(out3)
    let state3 = build_document(pr3, r2.new_source)
    let labels3 = collect_labels(state3)

    // 验证未编辑的 Label 保留
    var found_result = false
    for l in labels3 {
        if l.label == "result" { found_result = true }
    }
    assert(found_result, "result Label 应保留")

    // 引用应完整
    let unresolved = validate_refs(state3, labels3)
    assert(unresolved.len() == 0, f"不应有未解析引用")
    return Ok(0)
}

