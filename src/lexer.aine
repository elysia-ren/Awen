// awen-proto/src/lexer.aine —— 词法编排(核心规范 §6/§9/§11)
// 注:match 臂内 break/continue 曾为空操作,2026-09-04 已修复;
// 主循环的"先行自增行号"结构是设计选择,保留。

enum Block {
    Blank
    Heading(i32, Vec<Inline>)
    Paragraph(Vec<Inline>)
    BlkListItem(bool, Vec<Inline>)
    Quote(i32, Vec<Inline>)
    Divider
    BlkObject(CommandUse)
    RawOpen(ExplicitCommand, Option<String>)
    RawLine(String)
    RawClose(ExplicitCommand)
    TableOpen(CommandUse)
    TableRow(Vec<Vec<Inline>>, bool)
    TableClose
}

struct LexedBlock {
    line: i32
    block: Block
}

struct LexOutput {
    blocks: Vec<LexedBlock>
    diags: Vec<Diagnostic>
}

struct CmdOutcome {
    blocks: Vec<LexedBlock>
    diags: Vec<Diagnostic>
    raw: Option<ExplicitCommand>
    table: bool
}

fn lex_strip_cr(line: String) -> String {
    if line.len() > 0 && line[line.len() - 1] == "\r" {
        return line[0..line.len() - 1]
    }
    return line
}

fn lex_close_tag_name(line: String) -> Option<String> {
    let t = line.trim()
    if starts_with_at(t, 0, "@[/") {
        if t.len() >= 4 && t[t.len() - 1] == "]" {
            return Some(t[3..t.len() - 1])
        }
    }
    return None
}

fn lex_is_delimiter_cell(c: String) -> bool {
    var has_dash = false
    var k = 0
    while k < c.len() {
        let ch = c[k]
        if ch == "-" { has_dash = true }
        else if ch != ":" { return false }
        k += 1
    }
    return has_dash
}

fn lex(src: String) -> LexOutput {
    var blocks: Vec<LexedBlock> = []
    var diags: Vec<Diagnostic> = []
    var raw: Option<ExplicitCommand> = None
    var table = false
    let lines = src.split("\n")
    // 源码以 \n 结尾时,split 在末尾多出一个 "" 幻影行——它不是真实行。
    // 不剪掉的话文末会多算一个空行,空段规则(2 空行=1 空段)会多产一个空段。
    var n_lines = lines.len()
    if n_lines > 0 && src.len() > 0 && lines[n_lines - 1] == "" {
        n_lines -= 1
    }
    var lineno = 0
    while lineno < n_lines {
        let line = lex_strip_cr(lines[lineno])
        lineno += 1
        // Raw Block 状态
        let in_raw = match raw {
            Some(cmd) { true }
            None { false }
        }
        if in_raw {
            let cmd = match raw {
                Some(c) { c }
                None { Code }
            }
            let close_opt = lex_close_tag_name(line)
            var closed = false
            match close_opt {
                Some(name) {
                    if close_matches(cmd, name) { closed = true }
                }
                None { }
            }
            if closed {
                blocks.push(LexedBlock { line: lineno - 1, block: RawClose(cmd) })
                raw = None
            } else {
                blocks.push(LexedBlock { line: lineno - 1, block: RawLine(line) })
            }
            continue
        }
        // 表格状态
        if table {
            let t = line.trim()
            if t == "@[/table]" || t == "@[/表格]" {
                blocks.push(LexedBlock { line: lineno - 1, block: TableClose })
                table = false
                continue
            }
            if t.len() == 0 {
                blocks.push(LexedBlock { line: lineno - 1, block: Blank })
                continue
            }
            if starts_with_at(t, 0, "|") && t[t.len() - 1] == "|" && t.len() >= 2 {
                let inner = t[1..t.len() - 1]
                var cells_text: Vec<String> = []
                var cur = ""
                for ch in inner {
                    if ch == "|" {
                        cells_text.push(cur.trim())
                        cur = ""
                    }
                    else { cur = cur + ch }
                }
                cells_text.push(cur.trim())
                var all_delim = true
                for ct in cells_text {
                    if !lex_is_delimiter_cell(ct) { all_delim = false }
                }
                var cells: Vec<Vec<Inline>> = []
                for ct in cells_text {
                    let so = lw_scan_inline(ct, lineno - 1, diags)
                    diags = so.diags
                    cells.push(so.inline)
                }
                blocks.push(LexedBlock { line: lineno - 1, block: TableRow(cells, all_delim) })
                continue
            }
            diags.push(diag_error("表格块内只能包含表格行或 @[/table]", lineno - 1))
            blocks.push(LexedBlock { line: lineno - 1, block: Paragraph([AwTxt(line)]) })
            continue
        }
        // 常规行分类
        let cls = classify(line)
        match cls {
            LcBlank { blocks.push(LexedBlock { line: lineno - 1, block: Blank }) }
            LcDivider { blocks.push(LexedBlock { line: lineno - 1, block: Divider }) }
            LcHeading(level) {
                let so = lw_scan_inline(line[level + 1..line.len()], lineno - 1, diags)
                diags = so.diags
                blocks.push(LexedBlock { line: lineno - 1, block: Heading(level, so.inline) })
            }
            LcQuote(depth) {
                let so = lw_scan_inline(line[depth + 1..line.len()], lineno - 1, diags)
                diags = so.diags
                blocks.push(LexedBlock { line: lineno - 1, block: Quote(depth, so.inline) })
            }
            LcListItem(ordered) {
                let skip = if ordered { ordered_marker_len(line) } else { 2 }
                let so = lw_scan_inline(line[skip..line.len()], lineno - 1, diags)
                diags = so.diags
                blocks.push(LexedBlock { line: lineno - 1, block: BlkListItem(ordered, so.inline) })
            }
            LcCommand {
                let co = lex_command_line(line, lineno - 1, diags, raw, table)
                for nb in co.blocks { blocks.push(nb) }
                diags = co.diags
                raw = co.raw
                table = co.table
            }
            LcText {
                let so = lw_scan_inline(line, lineno - 1, diags)
                diags = so.diags
                blocks.push(LexedBlock { line: lineno - 1, block: Paragraph(so.inline) })
            }
        }
    }
    let last = n_lines
    match raw {
        Some(cmd) { diags.push(diag_error("Raw Block 未闭合到文件结尾", last)) }
        None { }
    }
    if table {
        diags.push(diag_error("@[table] 未闭合到文件结尾", last))
    }
    return LexOutput { blocks: blocks, diags: diags }
}

fn lex_command_line(chars: String, lineno: i32, diags: Vec<Diagnostic>, raw: Option<ExplicitCommand>, table: bool) -> CmdOutcome {
    var blocks: Vec<LexedBlock> = []
    var diags = diags
    let hp = parse_header(chars, 0)
    match hp {
        Err(e) => {
            var mut_d = diag_error(e.msg, lineno)
            match e.hint {
                Some(h) { mut_d = diag_hint(mut_d, h) }
                None { }
            }
            diags.push(mut_d)
            blocks.push(LexedBlock { line: lineno, block: Paragraph([AwTxt(chars)]) })
            return CmdOutcome { blocks: blocks, diags: diags, raw: raw, table: table }
        }
        Ok(hp2) => {
            let u = hp2.cu
            let consumed = hp2.consumed
            if u.cmd == Table {
                blocks.push(LexedBlock { line: lineno, block: TableOpen(u) })
                return CmdOutcome { blocks: blocks, diags: diags, raw: raw, table: true }
            }
            if is_raw_block(u.cmd) {
                let header_empty = match u.content {
                    None { true }
                    Some(c) { c.len() == 0 }
                }
                let rest = chars[consumed..chars.len()]
                if header_empty && rest.trim().len() == 0 {
                    var lang: Option<String> = None
                    if u.cmd == Code && u.args.len() > 0 { lang = Some(arg_plain(u.args[0])) }
                    blocks.push(LexedBlock { line: lineno, block: RawOpen(u.cmd, lang) })
                    return CmdOutcome { blocks: blocks, diags: diags, raw: Some(u.cmd), table: table }
                }
            }
            let so = lw_scan_inline(chars, lineno, diags)
            var is_single = false
            var single: Option<CommandUse> = None
            if so.inline.len() == 1 {
                match so.inline[0] {
                    Command(cu) {
                        is_single = true
                        single = Some(cu)
                    }
                    _ { }
                }
            }
            if is_single {
                match single {
                    Some(cu) {
                        blocks.push(LexedBlock { line: lineno, block: BlkObject(cu) })
                    }
                    None {
                        blocks.push(LexedBlock { line: lineno, block: Paragraph(so.inline) })
                    }
                }
            } else {
                blocks.push(LexedBlock { line: lineno, block: Paragraph(so.inline) })
            }
            return CmdOutcome { blocks: blocks, diags: diags, raw: raw, table: table }
        }
    }
}


// ── 增量 lex(daemon relayout 真增量)────────────────────────
// 复用上一轮 LexOutput:只对"脏区"(变更行向两侧扩到 raw/table 状态干净点)
// 重扫,前缀块原样保留、尾段块行号平移。结构被破坏(脏区结束时 raw/table
// 仍未闭合)时返回 fallback=true,调用方退回全量 lex——正确性优先。

struct LexIncremental {
    out: LexOutput
    reused_blocks: i32
    relexed_lines: i32
    fallback: bool
}

// 上一轮每行处理前的状态(bit0=in_raw,bit1=in_table);无块的行继承前态。
// 末尾多推一项:下标 n_lines = 文档 EOF 前的状态(纯追加场景用)。
fn lex_line_states(blocks: Vec<LexedBlock>, n_lines: i32) -> Vec<i32> {
    var st: Vec<i32> = []
    var raw = 0
    var tab = 0
    var bi: i32 = 0
    var li: i32 = 0
    while li < n_lines {
        st = st.push(raw + tab * 2)
        while bi < blocks.len() && blocks.get(bi).line == li {
            match blocks.get(bi).block {
                RawLine(_) { raw = 1 }
                RawOpen(_, _) { raw = 1 }
                RawClose(_) { raw = 0 }
                TableOpen(_) { tab = 1 }
                TableRow(_, _) { tab = 1 }
                TableClose { tab = 0 }
                _ { }
            }
            bi += 1
        }
        li += 1
    }
    st = st.push(raw + tab * 2)
    return st
}

fn incremental_lex(prev: LexOutput, old_src: String, new_src: String) -> LexIncremental {
    let old_lines = old_src.split("\n")
    let new_lines = new_src.split("\n")
    var old_n = old_lines.len()
    var new_n = new_lines.len()
    if old_n > 0 && old_src.len() > 0 && old_lines[old_n - 1] == "" { old_n -= 1 }
    if new_n > 0 && new_src.len() > 0 && new_lines[new_n - 1] == "" { new_n -= 1 }

    // 前向找首变行 first;后向配对相同后缀得 delta(行数差)。
    // 中段:旧行 [first, old_mid_end) ↔ 新行 [first, new_mid_end),
    // new_mid_end = max(ni+1, first) 防止删行时前后缀在新坐标重叠。
    var first = -1
    var i = 0
    while i < old_n && i < new_n {
        if old_lines[i] != new_lines[i] {
            first = i
            break
        }
        i += 1
    }
    if first < 0 {
        if old_n == new_n {
            return LexIncremental { out: prev, reused_blocks: prev.blocks.len(), relexed_lines: 0, fallback: false }
        }
        first = if old_n < new_n { old_n } else { new_n }
    }
    var oi = old_n - 1
    var ni = new_n - 1
    while oi >= first && ni >= first {
        if old_lines[oi] != new_lines[ni] { break }
        oi -= 1
        ni -= 1
    }
    let delta = ni - oi
    var new_mid_end = ni + 1
    if new_mid_end < first { new_mid_end = first }
    var old_mid_end = new_mid_end - delta

    // 状态数组:脏区向两侧扩到 raw/table 干净点(st 有 old_n+1 项)
    let st = lex_line_states(prev.blocks, old_n)
    var start = first
    while start > 0 {
        if st.get(start) == 0 { break }
        start -= 1
    }
    var end_old = old_mid_end
    while end_old < old_n {
        if st.get(end_old) == 0 { break }
        end_old += 1
    }
    let end_new = end_old + delta

    // 重扫脏区(行号平移到全局坐标在拼接时做)
    var region_lines: Vec<String> = []
    var ri = start
    while ri < end_new {
        region_lines = region_lines.push(new_lines[ri])
        ri += 1
    }
    // 区域首尾是真空行时,join 出的结尾 \n 会被 lex 的幻影行剥除逻辑吃掉;
    // 末尾加哨兵行(独立 Paragraph 块)保住真空行,lex 后剥掉最后一块
    var region_src = ""
    ri = 0
    while ri < region_lines.len() {
        if ri > 0 { region_src = region_src + "\n" }
        region_src = region_src + region_lines[ri]
        ri += 1
    }
    var sentinel = false
    if region_lines.len() > 0 {
        region_src = region_src + "\nawen region end sentinel 7f3a"
        sentinel = true
    }
    var reg = lex(region_src)
    if sentinel && reg.blocks.len() > 0 {
        var kept: Vec<LexedBlock> = []
        var kb = 0
        while kb < reg.blocks.len() - 1 {
            kept = kept.push(reg.blocks.get(kb))
            kb += 1
        }
        var kdiag: Vec<Diagnostic> = []
        var kd = 0
        while kd < reg.diags.len() {
            let dsv = reg.diags.get(kd)
            if dsv.line < region_lines.len() {
                kdiag = kdiag.push(dsv)
            }
            kd += 1
        }
        reg = LexOutput { blocks: kept, diags: kdiag }
    }
    if region_lines.len() == 0 {
        reg = LexOutput { blocks: [], diags: [] }
    }

    // 验证:脏区必须自闭合(状态干净收尾),否则结构被编辑破坏,退全量
    var vraw = false
    var vtab = false
    var vi = 0
    while vi < reg.blocks.len() {
        match reg.blocks.get(vi).block {
            RawLine(_) { vraw = true }
            RawOpen(_, _) { vraw = true }
            RawClose(_) { vraw = false }
            TableOpen(_) { vtab = true }
            TableRow(_, _) { vtab = true }
            TableClose { vtab = false }
            _ { }
        }
        vi += 1
    }
    var unclosed = false
    var di = 0
    while di < reg.diags.len() {
        let msg = reg.diags.get(di).message
        if msg.contains("未闭合") { unclosed = true }
        di += 1
    }
    if vraw || vtab || unclosed {
        return LexIncremental { out: prev, reused_blocks: 0, relexed_lines: 0, fallback: true }
    }

    // 拼接:前缀 + 脏区(行号 +start)+ 尾段(行号 +delta)
    var blocks: Vec<LexedBlock> = []
    var diags: Vec<Diagnostic> = []
    var reused = 0
    // 有序三段拼接:前缀(start 前)→ 脏区重扫块(行号 +start)→ 尾段(+delta)
    var bi = 0
    while bi < prev.blocks.len() {
        let b = prev.blocks[bi]
        if b.line < start {
            blocks = blocks.push(b)
            reused += 1
        } else {
            break
        }
        bi += 1
    }
    var ki = 0
    while ki < reg.blocks.len() {
        let b2 = reg.blocks.get(ki)
        blocks = blocks.push(LexedBlock { line: b2.line + start, block: b2.block })
        ki += 1
    }
    while bi < prev.blocks.len() {
        let b = prev.blocks[bi]
        if b.line >= end_old {
            blocks = blocks.push(LexedBlock { line: b.line + delta, block: b.block })
            reused += 1
        }
        bi += 1
    }
    di = 0
    while di < prev.diags.len() {
        let d = prev.diags[di]
        if d.line < start {
            diags = diags.push(d)
        } else if d.line >= end_old {
            diags = diags.push(Diagnostic { severity: d.severity, message: d.message, line: d.line + delta, hint: d.hint })
        }
        di += 1
    }
    di = 0
    while di < reg.diags.len() {
        let d2 = reg.diags.get(di)
        diags = diags.push(Diagnostic { severity: d2.severity, message: d2.message, line: d2.line + start, hint: d2.hint })
        di += 1
    }
    return LexIncremental {
        out: LexOutput { blocks: blocks, diags: diags },
        reused_blocks: reused,
        relexed_lines: end_new - start,
        fallback: false,
    }
}
