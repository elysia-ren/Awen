@test
fn render_theme_all_heading_levels() -> Result<i32, String> {
    // 6 级 heading 全部使用 theme 级联字号
    let src = "# L1\n## L2\n### L3\n#### L4\n##### L5\n###### L6\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_new("all_levels")
    t = theme_add_rule(t, "heading", 1, "size", "26pt")
    t = theme_add_rule(t, "heading", 2, "size", "22pt")
    t = theme_add_rule(t, "heading", 3, "size", "18pt")
    t = theme_add_rule(t, "heading", 4, "size", "16pt")
    t = theme_add_rule(t, "heading", 5, "size", "14pt")
    t = theme_add_rule(t, "heading", 6, "size", "12pt")
    let items = render_document(state, t)
    var sizes: Vec<String> = []
    for item in items {
        if item.kind == "heading" { sizes = sizes.push(item.font_size) }
    }
    assert(sizes.len() == 6, f"应有 6 个 heading 渲染项")
    assert(sizes[0] == "26pt", "L1 应为 26pt")
    assert(sizes[1] == "22pt", "L2 应为 22pt")
    assert(sizes[2] == "18pt", "L3 应为 18pt")
    assert(sizes[3] == "16pt", "L4 应为 16pt")
    assert(sizes[4] == "14pt", "L5 应为 14pt")
    assert(sizes[5] == "12pt", "L6 应为 12pt")
    return Ok(0)
}

@test
fn render_html_all_heading_levels_correct() -> Result<i32, String> {
    let src = "# H1\n## H2\n### H3\n#### H4\n##### H5\n###### H6\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
