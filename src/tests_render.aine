@test
fn render_scoped_raw_inline_combination() -> Result<i32, String> {
    // 段落中混合多种行内节点类型
    let src = "文字**粗**`码`@[u]线@[/u]@[m]x@[/m]尾\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    // 找到 para 节点统计行内类型
    var has_text = false
    var has_bold = false
    var has_code = false
    var has_scoped_u = false
    var has_raw_math = false
    for node in state.nodes {
        if node.kind == "para" {
            for item in node.inline {
                match item {
                    AwTxt(s) { if s.len() > 0 { has_text = true } }
                    IBold(c) { has_bold = true }
                    CodeSpan(s) { has_code = true }
                    Scoped(cmd, sa, c2) { if cmd == U { has_scoped_u = true } }
                    RawInline(cmd, lang, content) { if cmd == Math { has_raw_math = true } }
                    _ { }
                }
            }
        }
    }
    assert(has_text && has_bold && has_code && has_scoped_u && has_raw_math,
        f"应包含所有5种行内节点类型")
    return Ok(0)
}

