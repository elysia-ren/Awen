@test
fn render_theme_and_label_and_ref_combined() -> Result<i32, String> {
    // Theme + Label + Ref 在同一文档中协同工作
    let src = "# 文档 @[label doc]\n正文引用 @[ref doc]。\n## 数据 @[label data]\n@[table]\n\n| 名 | 值 |\n| --- | --- |\n| 测试 | 42 |\n\n@[/table]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_new("combined")
    t = theme_add_rule(t, "heading", 1, "size", "24pt")
    t = theme_add_rule(t, "heading", 2, "size", "18pt")

    // Label 收集
    let labels = collect_labels(state)
    assert(labels.len() >= 1, f"应有 Label,得到 {labels.len()}")

    // 引用验证
    let unresolved = validate_refs(state, labels)
    assert(unresolved.len() == 0, f"不应有未解析引用")

    // Ref 解析
    let res = resolve_ref(state, labels, "doc")
    assert(res.found, "doc 应解析")
    let res2 = resolve_ref(state, labels, "data")
    assert(res2.found, "data 应解析")

    // 渲染验证
    let items = render_document(state, t)
    var h1_items = 0
    var h2_items = 0
    for item in items {
        if item.kind == "heading" {
            if item.font_size == "24pt" { h1_items += 1 }
            if item.font_size == "18pt" { h2_items += 1 }
        }
    }
    assert(h1_items == 1, f"应有 1 个 H1 (24pt)")
    assert(h2_items == 1, f"应有 1 个 H2 (18pt)")

    // Markdown 导出应包含内容
    let md = export_markdown(state)
    assert(md.contains("引言") || md.contains("文档"), "MD 应含标题")
    return Ok(0)
}

