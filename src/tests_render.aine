@test
fn render_theme_and_labels_together() -> Result<i32, String> {
    let src = "# 引言 @[label intro]\n使用 Aine 开发。\n## 数据 @[label data]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_new("integration")
    t = theme_add_rule(t, "heading", 1, "size", "22pt")
    t = theme_add_rule(t, "heading", 2, "size", "18pt")

    let labels = collect_labels(state)
    assert(labels.len() == 2, f"应有 2 个 Label")

    let items = render_document(state, t)
    var h1_size = ""
    var h2_size = ""
    for item in items {
        if item.kind == "heading" {
            if item.text.contains("引言") { h1_size = item.font_size }
            if item.text.contains("数据") { h2_size = item.font_size }
        }
    }
    assert(h1_size == "22pt", f"H1 应为 22pt,得到 [{h1_size}]")
    assert(h2_size == "18pt", f"H2 应为 18pt,得到 [{h2_size}]")
    return Ok(0)
}

