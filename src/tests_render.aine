@test
fn render_html_escapes_xss() -> Result<i32, String> {
    // XSS 防护:<script> 应被转义
    let src = "包含 <script>alert('xss')</script> 的内容\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let html = export_html(state)
    assert(!html.contains("<script>alert"), "script 标签应被转义")
    assert(html.contains("&lt;script&gt;"), "应有转义后的标签")
    return Ok(0)
}

@test
fn inline_render_all_variants() -> Result<i32, String> {
    // 测试 inline_render_marked 处理所有 Inline 变体
    let r = lw_scan_inline("**b** _i_ ~~s~~ `c`", 0, [])
    let marked = inline_render_marked(r.inline)
    // 标记应保留
    assert(marked.contains("**b**"), "粗体标记")
    assert(marked.contains("_i_"), "斜体标记")
    assert(marked.contains("~~s~~"), "删除线标记")
    assert(marked.contains("`c`"), "代码标记")
    return Ok(0)
}

@test
fn render_paragraph_after_heading_edit() -> Result<i32, String> {
    // 编辑 heading 后,后续 para 的渲染应不受影响
    let src = "# 标题\n正文内容保持不变\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let r = edit_heading_text(state, 1, "修改后的标题", src)
    let out2 = lex(r.new_source)
    let pr2 = parse(out2)
    let state2 = build_document(pr2, r.new_source)
    // 找到 para 节点并验证内容
    for node in state2.nodes {
        if node.kind == "para" {
            let text = inline_plain(node.inline)
            assert(text.contains("正文内容保持不变"), f"段落应不受影响: [{text}]")
        }
    }
    return Ok(0)
}

