}

@test
fn render_html_raw_code() -> Result<i32, String> {
    let src = "@[c python]\nprint(42)\n@[/c]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let html = export_html(state)
    assert(html.contains("<pre><code"), "应有 pre+code")
    assert(html.contains("python"), "应有语言标注")
    assert(html.contains("print(42)"), "应含代码内容")
    return Ok(0)
}
