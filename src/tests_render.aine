// 测试模块:tests_render(M4 审计拆分;由 tests.aine 聚合声明)

@test
fn theme_cascade_direct_overrides_all() {
    var t = theme_new("test")
    t = theme_add_rule(t, "heading", 1, "size", "20pt")
    // direct 值优先于 theme
    let r1 = resolve_style(t, "heading", 1, "size", Some("18pt"))
    assert(r1 == "18pt", "direct 应优先")
    // 无 direct → 用 theme
    let r2 = resolve_style(t, "heading", 1, "size", None)
    assert(r2 == "20pt", "无 direct 应取 theme")
}

@test
fn theme_heading_size_scaling() {
    var t = theme_new("default")
    t = theme_add_rule(t, "heading", 1, "size", "22pt")
    t = theme_add_rule(t, "heading", 2, "size", "18pt")
    t = theme_add_rule(t, "heading", 3, "size", "16pt")
    assert(heading_size(t, 1) == "22pt", "H1 = 22pt")
    assert(heading_size(t, 2) == "18pt", "H2 = 18pt")
    assert(heading_size(t, 3) == "16pt", "H3 = 16pt")
    // level 4 无规则 → 回退到默认
    assert(heading_size(t, 4) == "11pt", "H4 回退默认")
}

@test
fn theme_from_document_settings() -> Result<i32, String> {
    let src = "@[font \"Noto Serif CJK SC\"]\n@[size 12pt]\n正文\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_from_document(state)
    let size = resolve_style(t, "body", 0, "size", None)
    let font = resolve_style(t, "body", 0, "font", None)
    assert(size == "12pt", "文档级 size 应为 12pt")
    assert(font == "Noto Serif CJK SC", "文档级 font 应正确")
    return Ok(0)
}

@test
fn theme_numbering_extraction() -> Result<i32, String> {
    let src = "@[numbering figure \"图 %figure\"]\n@[numbering heading level: 1 \"第 %chapter 章\"]\n正文\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let configs = numbering_from_document(state)
    assert(configs.len() == 2, "应有 2 个 Numbering 配置")
    if configs.len() == 2 {
        assert(configs[0].target == "figure", "第一个为 figure")
        assert(configs[1].target == "heading", "第二个为 heading")
        assert(configs[1].level == 1, "heading level 1")
    }
    return Ok(0)
}

@test
fn render_heading_sizes_from_theme() -> Result<i32, String> {
    let src = "# H1\n## H2\n正文\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_new("test")
    t = theme_add_rule(t, "heading", 1, "size", "22pt")
    t = theme_add_rule(t, "heading", 2, "size", "18pt")
    let items = render_document(state, t)
    if items.len() != 3 { return Err(f"应有 3 个渲染项,得到 {items.len()}") }
    // H1 应为 22pt
    if items[0].font_size != "22pt" { return Err(f"H1 size 应为 22pt,得到 {items[0].font_size}") }
    if items[0].text != "H1" { return Err(f"H1 text 应为 H1,得到 {items[0].text}") }
    // H2 应为 18pt
    if items[1].font_size != "18pt" { return Err(f"H2 size 应为 18pt") }
    // 正文回退默认
    if items[2].font_size != "11pt" { return Err(f"body size 应为默认 11pt") }
    return Ok(0)
}

@test
fn render_plain_text_roundtrip() -> Result<i32, String> {
    let src = "# 标题\n正文段落。\n- 项目一\n- 项目二\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let text = render_plain_text(state)
    // 验证渲染输出包含所有内容
    if !text.contains("# 标题") { return Err("缺少标题") }
    if !text.contains("正文段落。") { return Err("缺少段落") }
    if !text.contains("项目一") { return Err("缺少列表项 1") }
    if !text.contains("项目二") { return Err("缺少列表项 2") }
    return Ok(0)
}

@test
fn render_comment_not_in_output() -> Result<i32, String> {
    // 注释(§11.3)不产生可渲染节点
    let src = "@[comment 这不应出现]\n正文\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let text = render_plain_text(state)
    if text.contains("这不应出现") { return Err("注释不应出现在渲染输出") }
    if !text.contains("正文") { return Err("正文应存在") }
    return Ok(0)
}

@test
fn render_raw_content_preserved() -> Result<i32, String> {
    let src = "@[c py]\nprint(42)\n@[/c]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let text = render_plain_text(state)
    if !text.contains("print(42)") { return Err("Raw 内容应保留") }
    return Ok(0)
}

@test
fn render_inline_marked_preserves_all() -> Result<i32, String> {
    let src = "**粗体** 与 _斜体_ 与 `代码`"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    // 找到 para 节点
    if state.nodes.len() < 1 { return Err("无节点") }
    let text = inline_render_marked(state.nodes[state.nodes.len() - 1].inline)
    assert(text.contains("**粗体**"), "粗体标记保留")
    assert(text.contains("_斜体_"), "斜体标记保留")
    assert(text.contains("`代码`"), "代码标记保留")
    return Ok(0)
}

@test
fn theme_inline_overrides_body() -> Result<i32, String> {
    // inline(节点上的 @[size 14pt])优先于 theme 的 body 规则
    var t = theme_new("test")
    t = theme_add_rule(t, "body", 0, "size", "11pt")
    // 有 direct → 用 direct
    let r1 = resolve_style(t, "body", 0, "size", Some("14pt"))
    assert(r1 == "14pt", "direct 优先于 theme")
    // 无 direct → 用 theme
    let r2 = resolve_style(t, "body", 0, "size", None)
    assert(r2 == "11pt", "无 direct 用 theme")
    return Ok(0)
}

@test
fn theme_h1_overrides_h2_rules() -> Result<i32, String> {
    var t = theme_new("test")
    // 只设置 level 2 的规则
    t = theme_add_rule(t, "heading", 2, "size", "18pt")
    // level 1 无规则 → 回退默认
    let r1 = resolve_style(t, "heading", 1, "size", None)
    assert(r1 == "11pt", "H1 无规则回退默认")
    // level 2 有规则 → 用规则
    let r2 = resolve_style(t, "heading", 2, "size", None)
    assert(r2 == "18pt", "H2 用规则")
    return Ok(0)
}

@test
fn theme_prop_independence() -> Result<i32, String> {
    var t = theme_new("test")
    t = theme_add_rule(t, "heading", 0, "size", "20pt")
    t = theme_add_rule(t, "body", 0, "color", "#333")
    // heading 的 size 和 body 的 color 互不干扰
    let hs = resolve_style(t, "heading", 1, "size", None)
    let bc = resolve_style(t, "body", 0, "color", None)
    let bs = resolve_style(t, "body", 0, "size", None)
    assert(hs == "20pt", "heading size")
    assert(bc == "#333", "body color")
    assert(bs == "11pt", "body size 回退默认")
    return Ok(0)
}

@test
fn render_full_theme_integration() -> Result<i32, String> {
    let src = "# 标题\n正文内容\n@[font \"Serif\"]局部字体@[/font]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_new("custom")
    t = theme_add_rule(t, "heading", 1, "size", "20pt")
    t = theme_add_rule(t, "body", 0, "font", "Noto Sans CJK SC")
    let items = render_document(state, t)
    assert(items.len() >= 2, f"渲染项应 >= 2,得到 {items.len()}")
    // H1 用 theme 的 20pt
    if items[0].font_size != "20pt" { return Err(f"H1 应为 20pt") }
    // para 用 theme 的 body font
    if items[1].font_name != "Noto Sans CJK SC" { return Err(f"para font 错误") }
    // scoped 的 font 覆盖(有 direct value)
    return Ok(0)
}

@test
fn render_multi_heading_with_theme() -> Result<i32, String> {
    let src = "# 第一章\n## 第一节\n### 小节\n## 第二节\n# 第二章\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_new("test")
    t = theme_add_rule(t, "heading", 1, "size", "22pt")
    t = theme_add_rule(t, "heading", 2, "size", "18pt")
    let items = render_document(state, t)
    // H1 items 应为 22pt
    var h1_sizes: Vec<String> = []
    var h2_sizes: Vec<String> = []
    for item in items {
        if item.kind == "heading" {
            // 无法直接知道 level,检查 font_size
            if item.font_size == "22pt" { h1_sizes = h1_sizes.push(item.font_size) }
            if item.font_size == "18pt" { h2_sizes = h2_sizes.push(item.font_size) }
        }
    }
    assert(h1_sizes.len() == 2, f"应有 2 个 H1(22pt),得到 {h1_sizes.len()}")
    assert(h2_sizes.len() == 2, f"应有 2 个 H2(18pt),得到 {h2_sizes.len()}")
    return Ok(0)
}

@test
fn render_heading_with_number() -> Result<i32, String> {
    // 渲染 heading 时应显示编号(如果 theme 配置了 numbering)
    let src = "# 引言\n## 背景\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let numbered = number_headings(state)
    // number_headings 返回编号列表
    assert(numbered[0].number == "第 1 章", "H1 编号")
    assert(numbered[1].number == "1.1", "H2 编号")
    return Ok(0)
}

@test
fn render_quote_depth() -> Result<i32, String> {
    let src = "> 一级引用\n>> 二级引用\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var depth_1 = 0
    var depth_2 = 0
    for node in state.nodes {
        if node.kind == "quote" {
            if node.quote_depth == 1 { depth_1 += 1 }
            if node.quote_depth == 2 { depth_2 += 1 }
        }
    }
    assert(depth_1 == 1, f"应有 1 个一级引用,得到 {depth_1}")
    assert(depth_2 == 1, f"应有 1 个二级引用,得到 {depth_2}")
    return Ok(0)
}

@test
fn render_ordered_list_numbering() -> Result<i32, String> {
    let src = "1. 第一项\n2. 第二项\n3. 第三项\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    // 找到列表节点
    for node in state.nodes {
        if node.kind == "list" {
            assert(node.list_ordered, "应为有序列表")
            assert(node.list_items.len() == 3, f"应有 3 项,得到 {node.list_items.len()}")
            // 渲染应包含编号
            let text = render_list(node)
            assert(text.contains("1."), "应含编号 1.")
            assert(text.contains("3."), "应含编号 3.")
            return Ok(0)
        }
    }
    return Err("找不到列表节点")
}

@test
fn render_heading_hierarchy_levels() -> Result<i32, String> {
    let src = "# L1\n## L2\n### L3\n#### L4\n##### L5\n###### L6\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var levels_found: Vec<i32> = []
    for node in state.nodes {
        if node.kind == "heading" {
            levels_found = levels_found.push(node.level)
        }
    }
    assert(levels_found.len() == 6, f"应有 6 个 heading,得到 {levels_found.len()}")
    var i = 0
    while i < 6 {
        assert(levels_found[i] == i + 1, f"heading[{i}] level 应为 {i + 1}")
        i += 1
    }
    return Ok(0)
}

@test
fn render_table_with_alignment() -> Result<i32, String> {
    let src = "@[table]\n\n| 左 | 中 | 右 |\n| :--- | :---: | ---: |\n| a | b | c |\n\n@[/table]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let tables = doc_count_kind(state, "table")
    assert(tables == 1, f"应有 1 个表格,得到 {tables}")
    // 验证表格有分隔行
    for node in state.nodes {
        if node.kind == "table" {
            assert(node.tbl_has_delim, "应检测到分隔行")
            assert(node.tbl_rows.len() == 1, f"应有 1 个数据行")
        }
    }
    return Ok(0)
}

@test
fn render_raw_lang_preserved() -> Result<i32, String> {
    let src = "@[c python]\nprint(1)\n@[/c]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    for node in state.nodes {
        if node.kind == "raw" {
            match node.raw_lang {
                Some(lang) { assert(lang == "python", f"语言应为 python,得到 {lang}") }
                None { assert(false, "语言应保留") }
            }
            return Ok(0)
        }
    }
    return Err("找不到 Raw 块")
}

@test
fn render_obj_types() -> Result<i32, String> {
    let src = "@[image hero]\n@[toc depth: 3]\n@[footnote 脚注内容]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var cmds: Vec<ExplicitCommand> = []
    for node in state.nodes {
        match node.obj_cu {
            _ { }
        }
        // 通过遍历 nodes 找 obj
    }
    // 更直接:检查 blocks
    var img = false
    var toc = false
    var footnote = false
    for b in out.blocks {
        match b.block {
            BlkObject(u) {
                if u.cmd == Image { img = true }
                if u.cmd == Toc { toc = true }
                if u.cmd == Footnote { footnote = true }
            }
            _ { }
        }
    }
    assert(img && toc && footnote, "image/toc/footnote 应全部解析")
    return Ok(0)
}

@test
fn render_html_heading_levels() -> Result<i32, String> {
    let src = "# H1\n## H2\n### H3\n"
    let out = lex(src)
