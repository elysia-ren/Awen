}

@test
fn render_scoped_bold_inside_paragraph() -> Result<i32, String> {
    // paragraph 中的 @[b]scoped@[/b] 节点
    let src = "前文 @[b]加粗内容@[/b] 后文\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    // paragraph 中的 inline 应包含 Scoped(Bold) 节点
    var found_scoped = false
    for node in state.nodes {
        if node.kind == "para" {
            for item in node.inline {
                match item {
                    Scoped(cmd, sa, c) { if cmd == Bold { found_scoped = true } }
                    _ { }
                }
            }
        }
    }
    assert(found_scoped, "应找到 Scoped(Bold) 节点")
    return Ok(0)
}

