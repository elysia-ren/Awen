@test
fn render_html_comment_excluded() -> Result<i32, String> {
    let src = "@[comment 不应出现在 HTML]\n正文\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let html = export_html(state)
    assert(!html.contains("不应出现在 HTML"), "注释不应导出")
    assert(html.contains("正文"), "正文应导出")
    return Ok(0)
}

@test
fn render_theme_with_scoped_and_raw() -> Result<i32, String> {
    // Theme + Scoped + Raw + TOC 全部集成
    let src = "# 标题 @[label h1]\n@[u]下划线@[/u] 和 @[m]x=y@[/m]\n@[c js]\nconsole.log(1)\n@[/c]\n见 @[ref h1]。\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)

    // Label 应找到
    let labels = collect_labels(state)
    assert(labels.len() >= 1, f"应有 Label")

    // Raw 块应存在
    var has_raw_js = false
    for node in state.nodes {
        if node.kind == "raw" {
            match node.raw_lang {
                Some(lang) { if lang == "js" { has_raw_js = true } }
                None { }
            }
        }
    }
    assert(has_raw_js, "应有 JS Raw 块")

    // Scoped U 应在行内(至少一个段落含 Scoped(U))
    var found_u_any = false
    for node in state.nodes {
        if node.kind == "para" {
            for item in node.inline {
                match item {
                    Scoped(cmd, sa, c) { if cmd == U { found_u_any = true } }
                    _ { }
                }
            }
        }
    }
    assert(found_u_any, "应有 Scoped(U) 节点")

    // 引用应完整
    let unresolved = validate_refs(state, labels)
    assert(unresolved.len() == 0, f"引用应完整")

    // 渲染
    var t = theme_new("test")
    t = theme_add_rule(t, "heading", 1, "size", "24pt")
    let items = render_document(state, t)
    var h1_rendered = false
    for item in items {
        if item.kind == "heading" && item.font_size == "24pt" { h1_rendered = true }
    }
    assert(h1_rendered, "H1 应渲染为 24pt")
    return Ok(0)
}

@test
fn render_table_with_cell_commands() -> Result<i32, String> {
    // 表格单元格包含行内命令
    let src = "@[table]\n\n| 方法 | 结果 |\n| --- | --- |\n| **好** | @[m]x+y@[/m] |\n\n@[/table]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    // 表格应存在
    var has_table = false
    for node in state.nodes {
        if node.kind == "table" { has_table = true }
    }
    assert(has_table, "应有表格节点")
    assert(count_errors(out.diags) == 0, "不应有错误")
    return Ok(0)
}

@test
fn render_theme_heading_all_levels() -> Result<i32, String> {
    // 测试 6 个 heading 级别的 theme 级联
    var t = theme_new("full")
    t = theme_add_rule(t, "heading", 1, "size", "26pt")
    t = theme_add_rule(t, "heading", 2, "size", "22pt")
    t = theme_add_rule(t, "heading", 3, "size", "18pt")
    t = theme_add_rule(t, "heading", 4, "size", "16pt")
    t = theme_add_rule(t, "heading", 5, "size", "14pt")
    t = theme_add_rule(t, "heading", 6, "size", "12pt")
    // H1 → 26pt
    assert(heading_size(t, 1) == "26pt", "H1 = 26pt")
    assert(heading_size(t, 2) == "22pt", "H2 = 22pt")
    assert(heading_size(t, 3) == "18pt", "H3 = 18pt")
    assert(heading_size(t, 4) == "16pt", "H4 = 16pt")
    assert(heading_size(t, 5) == "14pt", "H5 = 14pt")
    assert(heading_size(t, 6) == "12pt", "H6 = 12pt")
    return Ok(0)
}

@test
fn render_theme_prop_isolation() -> Result<i32, String> {
    // 不同属性的规则不应互相干扰
    var t = theme_new("isolated")
    t = theme_add_rule(t, "heading", 0, "size", "20pt")
    t = theme_add_rule(t, "body", 0, "color", "#333")
    // heading 的 size 不影响 body 的 size
    assert(resolve_style(t, "body", 0, "size", None) == "11pt", "body size 不受 heading 规则影响")
    // body 的 color 不影响 heading 的 color
    assert(resolve_style(t, "heading", 1, "color", None) == "#000000", "heading color 回退默认")
    return Ok(0)
}

@test
fn render_multiple_scoped_inline() -> Result<i32, String> {
    // 多个不同的 Scoped 命令在同一个行内
    let src = "@[u]下划线@[/u] 和 @[color \"red\"]红色@[/color] 混合\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let html = export_html(state)
    // 两个 scoped 都应导出
    assert(html.contains("<u>") || html.contains("<span>"), "应包含 scoped 标签")
    return Ok(0)
}

@test
fn render_theme_body_defaults() -> Result<i32, String> {
    // 空主题应使用默认排版(§20)
    var t = theme_new("empty")
    assert(resolve_style(t, "body", 0, "size", None) == "11pt", "默认字号 11pt")
    assert(resolve_style(t, "body", 0, "font", None) == "Noto Sans CJK SC", "默认字体")
    assert(resolve_style(t, "body", 0, "spacing", None) == "1.65", "默认行距 1.65")
    assert(resolve_style(t, "body", 0, "indent", None) == "2em", "默认缩进 2em")
    return Ok(0)
}

@test
fn render_scoped_font_size_color() -> Result<i32, String> {
