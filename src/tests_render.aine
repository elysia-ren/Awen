@test
fn render_theme_all_props_heading() -> Result<i32, String> {
    // heading 节点的多个属性级联
    var t = theme_new("heading_test")
    t = theme_add_rule(t, "heading", 0, "size", "20pt")
    t = theme_add_rule(t, "heading", 0, "font", "Serif")
    t = theme_add_rule(t, "heading", 0, "color", "#333")
    t = theme_add_rule(t, "heading", 0, "weight", "bold")
    // 各属性独立解析
    assert(resolve_style(t, "heading", 1, "size", None) == "20pt", "heading size")
    assert(resolve_style(t, "heading", 1, "font", None) == "Serif", "heading font")
    assert(resolve_style(t, "heading", 1, "color", None) == "#333", "heading color")
    assert(resolve_style(t, "heading", 1, "weight", None) == "bold", "heading weight")
    // body 属性不受影响
    assert(resolve_style(t, "body", 0, "size", None) == "11pt", "body size 独立")
    return Ok(0)
}

@test
fn theme_edit_preserves_heading_size() -> Result<i32, String> {
    // 编辑 heading 后 theme 的 size 规则仍应正确应用
    let src = "# 标题 A\n# 标题 B\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_new("size_test")
    t = theme_add_rule(t, "heading", 1, "size", "24pt")
    // 编辑前:两个 H1 都应为 24pt
    let items1 = render_document(state, t)
    var count_24_before = 0
    for item in items1 {
        if item.font_size == "24pt" { count_24_before += 1 }
    }
    assert(count_24_before == 2, f"编辑前应有 2 个 24pt,得到 {count_24_before}")
    // 编辑第一个 heading
    let r = edit_heading_text(state, 1, "修改后的 A", src)
    let out2 = lex(r.new_source)
    let pr2 = parse(out2)
    let state2 = build_document(pr2, r.new_source)
    let items2 = render_document(state2, t)
    var count_24_after = 0
    for item in items2 {
        if item.font_size == "24pt" { count_24_after += 1 }
    }
    assert(count_24_after == 2, f"编辑后仍应有 2 个 24pt,得到 {count_24_after}")
    return Ok(0)
}

@test
fn theme_body_size_with_document_font() -> Result<i32, String> {
    // 文档级 @[size] 和 @[font] 独立设置
    let src = "@[size 14pt]\n@[font \"Serif\"]\n正文\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_from_document(state)
    let size = resolve_style(t, "body", 0, "size", None)
    let font = resolve_style(t, "body", 0, "font", None)
    assert(size == "14pt", f"size 应为 14pt,得到 {size}")
    assert(font == "Serif", f"font 应为 Serif,得到 {font}")
    return Ok(0)
}

@test
fn render_list_ordered_and_unordered_separate() -> Result<i32, String> {
    // 有序和无序列表应产生不同的渲染
    let src = "- 无序项\n\n1. 有序项\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var found_unordered = false
    var found_ordered = false
    for node in state.nodes {
        if node.kind == "list" {
            if node.list_ordered { found_ordered = true }
            else { found_unordered = true }
        }
    }
    assert(found_unordered && found_ordered, f"应有无序和有序两种列表")
    return Ok(0)
}

@test
fn render_multiple_tables() -> Result<i32, String> {
    let src = "@[table]\n\n| a | b |\n| --- | --- |\n| 1 | 2 |\n\n@[/table]\n\n@[table]\n\n| c | d |\n| --- | --- |\n| 3 | 4 |\n\n@[/table]\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    let tables = doc_count_kind(state, "table")
    assert(tables >= 1, f"应有表格,得到 {tables}")
    return Ok(0)
}

@test
fn render_theme_size_all_headings() -> Result<i32, String> {
    let src = "# 一\n## 二\n### 三\n"
    let out = lex(src)
    let pr = parse(out)
    let state = build_document(pr, src)
    var t = theme_new("sizes")
    t = theme_add_rule(t, "heading", 1, "size", "22pt")
    t = theme_add_rule(t, "heading", 2, "size", "18pt")
    t = theme_add_rule(t, "heading", 3, "size", "16pt")
    let items = render_document(state, t)
    // 验证每个 heading 的字号
    var h1_size = ""
    var h2_size = ""
    var h3_size = ""
    for item in items {
        if item.kind == "heading" {
            if item.text == "一" { h1_size = item.font_size }
            if item.text == "二" { h2_size = item.font_size }
            if item.text == "三" { h3_size = item.font_size }
        }
    }
    assert(h1_size == "22pt", f"H1 应为 22pt")
    assert(h2_size == "18pt", f"H2 应为 18pt")
    assert(h3_size == "16pt", f"H3 应为 16pt")
    return Ok(0)
}

