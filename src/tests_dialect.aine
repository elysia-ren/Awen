// 测试模块:tests_dialect(中英方言等价 + 多语种宽度模型)
// 方言等价是规范 §6.14 的承诺:每个命令的中文名与英文名在引擎语义完全一致。

// ── ① 方言等价:块级命令 ─────────────────────────────────────

@test
fn dialect_docset_page_cn() -> Result<i32, String> {
    // 回归:此前 "@[页面 B5]" 被引擎吞行(未注册)——现在应为 obj 记录且无诊断
    let src = "@[页面 B5]\n\n正文甲。\n"
    let state = build_document(parse(lex(src)), src)
    let json = blocks_to_json(state, src)
    assert(json.contains("\"kind\":\"docset\""), "页面 docset 应为 docset 记录:" + json)
    assert(json.contains("@[页面 B5]"), "页面 docset 原文应保留")
    assert(json.contains("正文甲。"), "正文不得被吞")
    assert(json.contains("\"docsets\":[[\"page\",\"B5\"]]"), "docsets 应归一为英文键:" + json)
    assert(!json.contains("未注册"), "不得报未注册命令")
    Ok(0)
}

@test
fn dialect_table_cn_matches_en() -> Result<i32, String> {
    // 回归:此前 "@[表格]" 退化段落——现在应与英文写法结构一致
    let cn = "@[表格 t]\n| 甲 | 乙 |\n| --- | --- |\n| 1 | 2 |\n@[/表格]\n"
    let en = "@[table t]\n| 甲 | 乙 |\n| --- | --- |\n| 1 | 2 |\n@[/table]\n"
    let st_cn = build_document(parse(lex(cn)), cn)
    let st_en = build_document(parse(lex(en)), en)
    let j_cn = blocks_to_json(st_cn, cn)
    let j_en = blocks_to_json(st_en, en)
    assert(j_cn.contains("\"kind\":\"table\""), "中文表格应为 table 记录:" + j_cn)
    assert(doc_count_kind(st_cn, "table") == doc_count_kind(st_en, "table"), "中英表格节点数应一致")
    assert(!j_cn.contains("未注册"), "不得报未注册命令")
    Ok(0)
}

@test
fn dialect_inline_color_no_truncation() -> Result<i32, String> {
    // 回归:此前 "@[颜色 …]" 触发解析错误并截断该行后半截——现在应整行保真
    let src = "正文含 @[颜色 red]红字@[/颜色] 与 **粗体** 尾段文字。\n"
    let state = build_document(parse(lex(src)), src)
    let json = blocks_to_json(state, src)
    assert(json.contains("尾段文字。"), "行内方言不得截断文本:" + json)
    assert(json.contains("@[颜色 red]"), "方言原文应保留(渲染层识别)")
    assert(!json.contains("未注册"), "不得报未注册命令")
    Ok(0)
}

@test
fn dialect_inline_scoped_set() -> Result<i32, String> {
    // 上标/下标/底纹/字号:引擎新增命令,行内闭合配对(中英开合混用也算等价)
    let src = "A@[上标]B@[/sup] C@[sub 下标]D@[/下标] E@[底纹 yellow]F@[/底纹] G@[字号 14]H@[/size]\n"
    let state = build_document(parse(lex(src)), src)
    let json = blocks_to_json(state, src)
    assert(!json.contains("未注册"), "上/下标/底纹/字号不得报未注册:" + json)
    assert(json.contains("H"), "文本应完整:" + json)
    Ok(0)
}

@test
fn dialect_link_footnote_label_ref_cn() -> Result<i32, String> {
    let src = "见 @[链接 官网 url: https://a.b] 与 @[脚注 1 注文] 📌@[标签 x] ↦@[引用 x]\n"
    let state = build_document(parse(lex(src)), src)
    let json = blocks_to_json(state, src)
    assert(!json.contains("未注册"), "链接/脚注/标签/引用中文形式应注册:" + json)
    assert(json.contains("官网"), "链接文本应保留")
    Ok(0)
}

@test
fn dialect_close_cross_language() -> Result<i32, String> {
    // 中文开 + 英文闭(同一命令,close_matches 走 lookup)
    let src = "文 @[颜色 red]红@[/color] 字。\n"
    let state = build_document(parse(lex(src)), src)
    let json = blocks_to_json(state, src)
    assert(!json.contains("未注册") && !json.contains("缺少"), "跨语言闭合应配对:" + json)
    Ok(0)
}

// ── ② 多语种宽度模型 ────────────────────────────────────────

@test
fn width_fullwidth_eaw() -> Result<i32, String> {
    // 假名/谚文为全角(此前按 0.5em 估宽,日文断行偏差近一倍)
    assert(layout_em_width("あ") == 1.0, "平假名应全角")
    assert(layout_em_width("ア") == 1.0, "片假名应全角")
    assert(layout_em_width("한") == 1.0, "谚文音节应全角")
    assert(layout_em_width("가") == 1.0, "谚文音节应全角")
    assert(layout_em_width("ᄀ") == 1.0, "谚文字母应全角")
    assert(layout_em_width("！") == 1.0, "全角标点应全角")
    // 拉丁/希腊/西里尔保持 0.5em 估宽
    assert(layout_em_width("A") == 0.5, "拉丁应半宽")
    assert(layout_em_width("α") == 0.5, "希腊应半宽")
    assert(layout_em_width("Ж") == 0.5, "西里尔应半宽")
    Ok(0)
}

@test
fn width_mixed_spacing_kana_latin() -> Result<i32, String> {
    // 假名与拉丁相邻同样吃 ⅛em 混排距(此前假名不是全角,吃不到)
    assert(layout_needs_mixed_spacing("あ", "A"), "假名-拉丁应有混排距")
    assert(layout_needs_mixed_spacing("A", "カ"), "拉丁-片假名应有混排距")
    assert(layout_needs_mixed_spacing("가", "B"), "谚文-拉丁应有混排距")
    Ok(0)
}

@test
fn width_cyrillic_word_units() -> Result<i32, String> {
    // 西里尔/希腊按词断行(词内不可分),不回退逐字切断
    let units = layout_build_units("Привет мир αβ γ")
    var joined = ""
    for u in units {
        joined = joined + u.text + "|"
    }
    assert(joined.contains("Привет|"), "西里尔词应为完整单元:" + joined)
    assert(joined.contains("αβ|"), "希腊词应为完整单元:" + joined)
    Ok(0)
}

@test
fn width_japanese_pagination_sane() -> Result<i32, String> {
    // 日文文档分页:窄页页数多于宽页(假名全角化后的合理性)
    var src = ""
    var i: i32 = 0
    while i < 40 {
        src = src + "これはテストの文章です。日本語の改行とページ区切りを確認します。\n\n"
        i += 1
    }
    let state = build_document(parse(lex(src)), src)
    let wide = page_flow_with(state, page_flow_ctx_cfg(210.0, 297.0, 20.0, 11.0, 1.65))
    let narrow = page_flow_with(state, page_flow_ctx_cfg(105.0, 297.0, 20.0, 11.0, 1.65))
    assert(narrow.pages > wide.pages, f"日文窄页 {narrow.pages} 应多于宽页 {wide.pages}")
    Ok(0)
}

@test
fn font_width_table_binary_search() -> Result<i32, String> {
    // 字体度量宽表:区间二分查宽(命中区间/区间内未列字符回退 0.5)
    let ctx = page_flow_ctx_cfg_w(210.0, 297.0, 20.0, 11.0, 1.9, "ac", "ad", [1.0, 2.0])
    // a→1.0(range0);b→未列(不在任何区间)→0.5;c→2.0(range1)
    let w1 = layout_measure_w("ab", ctx)
    let w2 = layout_measure_w("c", ctx)
    assert(w1 > 1.49 && w1 < 1.51, f"a+b 应为 1.5,得到 {w1}")
    assert(w2 > 1.99 && w2 < 2.01, f"c 应为 2.0,得到 {w2}")
    // 空表回退均匀估宽
    let ctx2 = page_flow_ctx_cfg_w(210.0, 297.0, 20.0, 11.0, 1.9, "", "", [])
    assert(layout_measure_w("ab", ctx2) == 1.0, "空表应回退均匀估宽")
    Ok(0)
}

@test
fn table_geometry_row_wrap() -> Result<i32, String> {
    // 表格几何:长单元格(需换行)的表比短单元格表占用更多版面行
    var longcell = ""
    var rep = 0
    while rep < 10 {
        longcell = longcell + "这是一段非常长的单元格内容,用于测试表格几何的换行估算。"
        rep += 1
    }
    let short = "@[table s]\n| a |\n| --- |\n| 1 |\n@[/table]\n"
    let long = "@[table L]\n| " + longcell + " |\n| --- |\n| 1 |\n@[/table]\n"
    let st_s = build_document(parse(lex(short)), short)
    let st_l = build_document(parse(lex(long)), long)
    let ctx = page_flow_ctx_cfg(210.0, 297.0, 20.0, 11.0, 1.9)
    let f_s = page_flow_with(st_s, ctx)
    let f_l = page_flow_with(st_l, ctx)
    var ls = 0
    var ll = 0
    for b in f_s.boxes { ls = ls + b.lines }
    for b in f_l.boxes { ll = ll + b.lines }
    assert(ll > ls, f"长单元格表行数 {ll} 应大于短表 {ls}")
    assert(f_l.pages >= 1, "长表文档至少一页")
    Ok(0)
}

@test
fn layout_sig_style_sensitive() -> Result<i32, String> {
    // P0 修正:版面签名必须对样式敏感——纯文本相同、字号不同 ⇒ 签名不同
    let src_a = "甲段。\n\n乙段内容完全一样。\n"
    let src_b = "甲段。\n\n@[size 20]乙段内容完全一样。@[/size]\n"
    let st_a = build_document(parse(lex(src_a)), src_a)
    let st_b = build_document(parse(lex(src_b)), src_b)
    assert(st_a.nodes.len() == st_b.nodes.len(), "两文档节点数应相同")
    var i: i32 = 0
    var differ = false
    while i < st_a.nodes.len() {
        if page_node_sig(st_a.nodes[i]) != page_node_sig(st_b.nodes[i]) { differ = true }
        i += 1
    }
    assert(differ, "样式差异必须反映在版面签名中")
    // obj 参数敏感:图片 width 变化 ⇒ 签名变化
    let src_c = "@[image \"x.png\" width 50%]\n"
    let src_d = "@[image \"x.png\" width 90%]\n"
    let st_c = build_document(parse(lex(src_c)), src_c)
    let st_d = build_document(parse(lex(src_d)), src_d)
    assert(page_node_sig(st_c.nodes[0]) != page_node_sig(st_d.nodes[0]), "图片参数变化必须反映在签名中")
    Ok(0)
}

@test
fn incremental_fast_matches_full() -> Result<i32, String> {
    // P0 修正:增量排版(start_y 恢复)结果必须与全量逐盒等价
    let ctx = page_flow_ctx_cfg(210.0, 297.0, 20.0, 11.0, 1.9)
    var src1 = "# 等价测试\n\n"
    var i: i32 = 0
    while i < 20 {
        src1 = src1 + "这是第" + f"{i}" + "段内容,用于构建多页文档前缀。\n\n"
        i += 1
    }
    let st1 = build_document(parse(lex(src1)), src1)
    let f0 = page_flow_with(st1, ctx)
    // 第一轮:prev 签名为空 → 全量重算并填充签名
    let f1 = page_flow_incremental_fast(st1, f0, ctx)
    // 修改中段文本 + 追加两段
    var src2 = "# 等价测试\n\n"
    i = 0
    while i < 20 {
        if i == 10 {
            src2 = src2 + "这一段在中途被修改了,内容明显不同,测试前缀复用与恢复点。\n\n"
        } else {
            src2 = src2 + "这是第" + f"{i}" + "段内容,用于构建多页文档前缀。\n\n"
        }
        i += 1
    }
    src2 = src2 + "追加的段落甲。\n\n追加的段落乙。\n"
    let st2 = build_document(parse(lex(src2)), src2)
    let f2 = page_flow_incremental_fast(st2, f1, ctx)
    let f3 = page_flow_with(st2, ctx)
    assert(f2.pages == f3.pages, f"增量页数 {f2.pages} 应等于全量 {f3.pages}")
    assert(f2.boxes.len() == f3.boxes.len(), f"盒数 {f2.boxes.len()} 应等于 {f3.boxes.len()}")
    var k: i32 = 0
    while k < f2.boxes.len() {
        assert(f2.boxes[k].node_id == f3.boxes[k].node_id && f2.boxes[k].start_page == f3.boxes[k].start_page,
            f"盒 {k} 起始页不一致:增量 {f2.boxes[k].start_page} vs 全量 {f3.boxes[k].start_page}")
        k += 1
    }
    Ok(0)
}
