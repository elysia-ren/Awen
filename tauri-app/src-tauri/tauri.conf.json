{
  "productName": "Awen 编辑器",
  "version": "1.18.0",
  "identifier": "com.awen.editor",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Awen 编辑器",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$LOCALDATA/AwenEditor/media/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/aine-runtime"
    ],
    "fileAssociations": [
      {
        "name": "Awen 文档",
        "ext": ["awen"],
        "description": "Awen 文档格式(v0.4)"
      }
    ],
    "copyright": "© 2026 Awen",
    "shortDescription": "Awen 文档编辑器",
    "longDescription": "Awen 文档格式编辑器——支持所见即所得编辑、语法视图、分屏对照、多文件管理、导出 Markdown/HTML/Word。"
  }
}
