{
  "applicationId": "com.awen.editor",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/src/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": false,
  "tokenSecurity": "none",
  "logging": {
    "enabled": false
  },
  "nativeAllowList": [
    "app.*"
  ],
  "modes": {
    "window": {
      "title": "Awen 编辑器",
      "width": 1280,
      "height": 800,
      "minWidth": 800,
      "minHeight": 600,
      "icon": "/src/favicon.ico",
      "fullscreen": false,
      "alwaysOnTop": false,
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  }
}